# Project Files
distr
source/
output/

# Local environment and Codex recovery files
.env
.env.*
!.env.example
*.bak
*.bak_*
*.bak-*
*.codex-bak-*

.env
.env.*
!.env.example
source/
output/
codex-local-check*
