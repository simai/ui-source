{
  ".sf-radio-button": [
    "display/flex (.flex)",
    "flex-direction/row (.flex-row)",
    "flex-wrap/nowrap (.flex-nowrap)",
    "justify-content/flex-start (.justify-start)",
    "align-items/flex-start (.items-start)"
  ],
  ".sf-radio-button .sf-radio-button-box": [
    "display/flex (.flex)",
    "flex-direction/row (.flex-row)",
    "flex-wrap/nowrap (.flex-nowrap)",
    "gap/var(--sf-radio-button-box--gap)",
    "justify-content/center (.justify-center)",
    "align-items/center (.items-center)"
  ],
  ".sf-radio-button .sf-radio-button-container": [
    "display/flex (.flex)",
    "flex-direction/column (.flex-col)",
    "flex-wrap/nowrap (.flex-nowrap)",
    "justify-content/flex-start (.justify-start)",
    "align-items/flex-start (.items-start)"
  ],
  ".sf-radio-button .sf-radio-button-top": [
    "display/flex (.flex)",
    "flex-direction/row (.flex-row)",
    "flex-wrap/nowrap (.flex-nowrap)",
    "justify-content/flex-start (.justify-start)",
    "align-items/flex-start (.items-start)",
    "gap/var(--sf-radio-button-top--gap)"
  ],
  ".sf-radio-button .sf-radio-button-text": [
    "display/flex (.flex)",
    "flex-direction/row (.flex-row)",
    "flex-wrap/nowrap (.flex-nowrap)",
    "justify-content/center (.justify-center)",
    "align-items/center (.items-center)"
  ]
}
