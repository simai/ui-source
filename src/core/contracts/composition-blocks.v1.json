      "cards": {
        "list": "items",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "badge": {
                    "maxLength": 60,
                    "minLength": 1,
                    "type": "string"
                  },
                  "date": {
                    "maxLength": 40,
                    "minLength": 1,
                    "type": "string"
                  },
                  "id": {
                    "maxLength": 120,
                    "minLength": 1,
                    "type": "string"
                  },
                  "image": {
                    "additionalProperties": false,
                    "properties": {
                      "alt": {
                        "maxLength": 1000,
                        "type": "string"
                      },
                      "src": {
                        "maxLength": 2048,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "src"
                    ],
                    "type": "object"
                  },
                  "text": {
                    "maxLength": 5000,
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 500,
                    "minLength": 1,
                    "type": "string"
                  },
                  "url": {
                    "maxLength": 2048,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ],
                "type": "object"
              },
              "maxItems": 500,
              "type": "array"
            },
            "page": {
              "minimum": 1,
              "type": "integer"
            },
            "pages": {
              "minimum": 0,
              "type": "integer"
            },
            "per_page": {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            "total": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "items"
          ],
          "type": "object"
        },
        "summary": "A list of records for cards, with the page it is when the host pages it."
      },
      "gallery": {
        "list": "items",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "additionalProperties": false,
