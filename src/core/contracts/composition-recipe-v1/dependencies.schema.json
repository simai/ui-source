{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.io/contracts/composition-recipe-v1/dependencies.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "simai.composition.dependencies.v1"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "recipeDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "documentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "executionContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contractDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "registryDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "rendererDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "canonicalization": {
          "const": "simai.recipe.canonical-json.v1"
        }
      },
      "required": [
        "contractDigest",
        "registryDigest",
        "rendererDigest",
        "canonicalization"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "kind": {
            "enum": [
              "template",
              "fragment"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "scope",
          "kind",
          "owner",
          "ref",
          "revision",
          "digest"
        ]
      },
      "minItems": 0,
      "maxItems": 128
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
          },
          "kind": {
            "enum": [
              "parameter",
              "setting",
              "content"
            ]
          },
          "valueDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "scope",
              "owner",
              "ref",
              "revision"
            ]
          },
          "resolution": {
            "enum": [
              "provided",
              "default"
            ]
          },
          "missingSource": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "scope",
              "owner",
              "ref"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "valueDigest",
          "resolution"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "logicalPointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "kind": {
            "enum": [
              "template",
              "fragment"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "pointer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "generation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "resolvedRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "scope",
          "kind",
          "owner",
          "ref",
          "pointer",
          "generation",
          "resolvedRevision"
        ]
      },
      "minItems": 0,
      "maxItems": 128
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$"
      }
    }
  },
  "required": [
    "schema",
    "scope",
    "recipeDigest",
    "documentDigest",
    "executionContract",
    "references",
    "inputs",
    "logicalPointers"
  ]
}
