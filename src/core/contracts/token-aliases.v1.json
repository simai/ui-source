    "removed": [
      {
        "utility": "box-shadow-color",
        "classes": "shadow-<colour>, hover:shadow-<colour>, active:shadow-<colour> (primary, secondary, tertiary, error, warning, success, on-surface)",
        "why": "A shadow carries no colour meaning: a coloured halo reads as focus or as a status (C20, C17). Until remove_after the class colours the key and the ambient shadow of its own element."
      },
      {
        "utility": "drop-shadow-color",
        "classes": "drop-shadow-<colour>, hover:drop-shadow-<colour>",
        "why": "As box-shadow-color."
      },
      {
        "rule": "[class*=\"shadow\"], [class*=\"drop-shadow\"] (core)",
        "why": "Gave a shadow to any element with the word in a class; each shadow utility draws its own now."
      }
    ],
    "primitives_kept": [
      {
        "name": "--sf-black--alfa-4",
        "why": "The former light-theme ambient shadow colour (--sf-shadow--color-shading); C20 draws with black 8, 16 and 28. Nothing in the Framework reads it now; kept for pages that wrote it until remove_after."
      },
      {
        "name": "--sf-black--alfa-12",
        "why": "The former light-theme key shadow colour (--sf-shadow--color-fill); C20 draws with black 16. Nothing in the Framework reads it now; Docara's resources/smart/assets/preferences.css does, so it stays until remove_after."
      }
    ]
  },
  "primitives_kept": [
    {
      "name": "--sf-neutral-60--alfa-64",
      "why": "The dark half of --sf-outline before C16 S3 (2026-11-08): the boundary is neutral-90 at 48 now. Nothing in the Framework reads it; kept for pages that wrote it until remove_after."
    },
    {
      "name": "--sf-neutral-80--alfa-48",
      "why": "The top of the former skeleton gradient (--sf-ui-skeleton); the skeletons are the control fill since C16 S3. Nothing in the Framework reads it; kept for pages that wrote it until remove_after."
    }
  ],
