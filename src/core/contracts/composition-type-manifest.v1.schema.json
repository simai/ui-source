{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.io/contracts/composition-type-manifest.v1.schema.json",
  "title": "SIMAI Composition Type Manifest v1",
  "x-simai-version": "1.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "version",
    "category",
    "mode",
    "profiles",
    "data_schema",
    "props_schema",
    "presentation",
    "slots",
    "renderer",
    "assets",
    "capabilities"
  ],
  "anyOf": [
    {
      "properties": {
        "schema": {
          "const": "simai.composition.type-manifest.v1"
        }
      }
    },
    {
      "required": [
        "schema_version"
      ]
    }
  ],
  "properties": {
    "schema": {
      "enum": [
        "simai.composition.type-manifest.v1",
        "simai.composition.type-manifest"
      ],
      "description": "The format: simai.composition.type-manifest with schema_version 1. The older label simai.composition.type-manifest.v1 is read until the change journal retires it (names carry no version, 2026-10-11)."
    },
    "schema_version": {
      "const": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "category": {
      "enum": [
        "layout",
        "content",
        "component",
        "smart"
      ]
    },
    "mode": {
      "enum": [
        "leaf",
        "composite"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ui-layout",
          "structured-content"
        ]
      }
    },
    "data_schema": {
      "type": "object"
    },
    "props_schema": {
      "type": "object"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "presets",
        "modifiers"
      ],
      "properties": {
        "views": {
          "$ref": "#/$defs/stringList"
        },
        "presets": {
          "$ref": "#/$defs/stringList"
        },
        "modifiers": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 0
          },
          "max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "types": {
            "$ref": "#/$defs/stringList"
          },
          "categories": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "layout",
                "content",
                "component",
                "smart"
              ]
            }
          },
          "label_key": {
            "$ref": "#/$defs/stableKey",
            "description": "The place's name in the editor (a word)."
          },
          "empty_key": {
            "$ref": "#/$defs/stableKey",
            "description": "What an empty place offers, e.g. a picture or a video (a word)."
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "description": "The catalogue groups this place accepts (1.3.0); a child of another group is refused."
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "builtin",
            "registered",
            "custom-element"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assets": {
      "$ref": "#/$defs/stringList"
    },
    "capabilities": {
      "$ref": "#/$defs/stringList"
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "payload"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source_of_truth",
        "network_owner"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "local-demo",
            "external-host",
            "hybrid"
          ]
        },
        "source_of_truth": {
          "enum": [
            "component",
            "browser-demo",
            "host"
          ]
        },
        "network_owner": {
          "enum": [
            "none",
            "host"
          ]
        },
        "settings_key_prop": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_prop": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group"
      ],
      "description": "Where the type stands in the editor's catalogue (1.3.0). group is one of the fixed groups or the type's own namespace; tab defaults to text for text and media, blocks otherwise.",
      "properties": {
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "tab": {
          "enum": [
            "text",
            "blocks"
          ]
        },
        "label_key": {
          "$ref": "#/$defs/stableKey"
        },
        "help_key": {
          "$ref": "#/$defs/stableKey"
        },
        "keywords": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        },
        "preview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "variants": {
      "type": "array",
      "maxItems": 50,
      "description": "Named starting states of the type (1.3.0): parameters and initial child blocks, cloned with new ids on insert.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label_key": {
            "$ref": "#/$defs/stableKey"
          },
          "preview": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "props": {
            "type": "object"
          },
          "data": {
            "type": "object"
          },
          "presentation": {
            "type": "object"
          },
          "slots": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "composed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "description": "A site block (1.3.0): the tree of existing blocks it draws. An instance holds only its exposed values (props) and texts by path (data.texts).",
      "properties": {
        "root": {
          "type": "object"
        }
      }
    },
    "exposed": {
      "type": "array",
      "maxItems": 50,
      "description": "The parameters of a site block an author sets (1.3.0): a key, the id of a block in the tree and its target there.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "path",
          "target"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "target": {
            "type": "string",
            "pattern": "^(?:props|data)\\.[a-z][a-z0-9_]*$"
          },
          "label_key": {
            "$ref": "#/$defs/stableKey"
          }
        }
      }
    },
    "data_bindings": {
      "type": "object",
      "description": "The data keys a host fills (1.3.0), each with the data shapes it takes; the block never fetches.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shapes"
        ],
        "properties": {
          "shapes": {
            "$ref": "#/$defs/stringList"
          },
          "required": {
            "type": "boolean"
          },
          "empty_key": {
            "$ref": "#/$defs/stableKey"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runtime states between blocks of one section (1.3.0): what a block publishes (from one of its bindings) and what it accepts.",
      "properties": {
        "publishes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shape"
            ],
            "properties": {
              "shape": {
                "type": "string",
                "minLength": 1
              },
              "binding": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "accepts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shape"
            ],
            "properties": {
              "shape": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "parameter_sets": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "background",
          "spacing",
          "width",
          "grid",
          "alignment",
          "breakout",
          "visibility"
        ]
      },
      "description": "Parameter sets the type takes (1.4.0): reusable groups of layout parameters, each a SIMAI Framework utility, joined to props_schema by a registry. width and grid place classes on the parts the renderer marks data-sf-composition-part (frame, content)."
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stableKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    }
  }
}
