{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simai.framework.public-variables.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "summary",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "simai.framework.public-variables.v1"
    },
    "summary": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "selector",
          "variables"
        ],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "selector": {
            "type": "string",
            "pattern": "^\\.sf-[a-z0-9-]+$"
          },
          "variables": {
            "type": "array",
            "minItems": 5,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "role",
                "summary",
                "default",
                "since"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^--sf-[a-z0-9]+(?:-[a-z0-9]+)+$"
                },
                "role": {
                  "enum": [
                    "color",
                    "background",
                    "border-color",
                    "border-width",
                    "radius",
                    "padding-inline",
                    "padding-block",
                    "gap",
                    "size",
                    "indicator-color",
                    "indicator-width"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "default": {
                  "type": "string",
                  "minLength": 1
                },
                "since": {
                  "type": "string"
                },
                "varies_with": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "size",
                      "appearance",
                      "scheme",
                      "status",
                      "spacing"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
