{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.io/contracts/composition-editor-field-kind.v1.schema.json",
  "title": "Simai Composition Editor Field Kind v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "version", "status", "match", "value_schema", "default", "constraints", "normalization", "validation", "accessibility", "themes", "localization", "server_fallback"],
  "properties": {
    "schema": {"const": "simai.composition.editor-field-kind.v1"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["new", "formalized-existing"]},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "choices"],
      "properties": {
        "property": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "version"],
            "properties": {
              "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"},
              "version": {"type": "integer", "minimum": 1}
            }
          }
        },
        "choices": {"enum": ["required", "forbidden"]}
      }
    },
    "value_schema": {"type": "object"},
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field"],
      "properties": {
        "kind": {"type": ["boolean", "null"]},
        "field": {"enum": ["must-be-a-choice", "must-satisfy-constraints", "false-or-absent"]}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {"type": "array", "uniqueItems": true, "items": {"enum": ["min", "max", "min_length", "max_length"]}},
        "required": {"type": "array", "uniqueItems": true, "items": {"enum": ["min", "max", "min_length", "max_length"]}}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "unset", "stored"],
      "properties": {
        "form": {"type": "string", "minLength": 1},
        "unset": {"type": "string", "minLength": 1},
        "stored": {"type": "string", "minLength": 1}
      }
    },
    "validation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "accessibility": {
      "type": "object",
      "required": ["control", "role", "name", "description", "keyboard"],
      "properties": {
        "control": {"type": "string"},
        "role": {"enum": ["combobox", "spinbutton", "textbox", "switch"]},
        "name": {"const": "label_key"},
        "description": {"type": "string"},
        "keyboard": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "tokens", "contrast"],
      "properties": {
        "modes": {"const": ["light", "dark"]},
        "tokens": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^--sf-[a-z0-9-]+$"}},
        "contrast": {"const": "WCAG 2.2 AA"}
      }
    },
    "localization": {
      "type": "object",
      "required": ["label", "help", "value_labels", "direction"],
      "properties": {
        "label": {"const": "label_key"},
        "help": {"const": "help_key"},
        "value_labels": {"type": "string"},
        "direction": {"type": "string"}
      }
    },
    "server_fallback": {
      "type": "object",
      "required": ["element", "enhanced_control"],
      "properties": {
        "element": {"enum": ["select", "input"]},
        "type": {"enum": ["number", "text", "checkbox"]},
        "enhanced_control": {"type": "string", "pattern": "^sf-[a-z0-9-]+$"}
      }
    }
  }
}
