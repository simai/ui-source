{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.io/contracts/composition-port-manifest.v1.schema.json",
  "title": "SIMAI Composition Port Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "element", "version", "component", "component_version", "outputs", "inputs"],
  "anyOf": [{"properties": {"schema": {"const": "simai.composition.port-manifest.v1"}}}, {"required": ["schema_version"]}],
  "properties": {
    "schema": {"enum": ["simai.composition.port-manifest.v1", "simai.composition.port-manifest"], "description": "The format: simai.composition.port-manifest with schema_version 1. The older label simai.composition.port-manifest.v1 is read until the change journal retires it (names carry no version, 2026-10-11)."},
    "schema_version": {"const": 1},
    "element": {"type": "string", "pattern": "^sf-[a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "component": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "component_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "outputs": {"$ref": "#/$defs/ports"},
    "inputs": {"$ref": "#/$defs/ports"}
  },
  "$defs": {
    "valueType": {"enum": ["record-ids.v1", "record-id.v1", "text.v1", "boolean.v1", "record-changed.v1", "record-removed.v1", "collection-changed.v1", "files-moved.v1", "counter.v1", "navigation.v1", "preference-changed.v1", "record-ids", "record-id", "text", "boolean", "record-changed", "record-removed", "collection-changed", "files-moved", "counter", "navigation", "preference-changed"], "description": "A value type by its name (record-removed) or by the older label with the version (record-removed.v1); both are read until the change journal retires the older one (value-types-without-version, names carry no version, 2026-10-19)."},
    "ports": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "summary"],
        "properties": {
          "value": {"$ref": "#/$defs/valueType"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "effect": {"enum": ["set", "request"]},
          "request_event": {"type": "string", "pattern": "^sf-[a-z0-9-]+$"},
          "result_method": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"}
        }
      }
    }
  }
}
