{
  "id": "settings-shared-only-field",
  "intent": "settings.save_personal",
  "capability": null,
  "summary": "A field that only the shared layer owns is refused in a personal save.",
  "given": {
    "shared_only_fields": [
      "pinned"
    ]
  },
  "when": {
    "intent": "settings.save_personal",
    "payload": {
      "columnSettings": {
        "name": {
          "pinned": true
        }
      },
      "base_revision": "s1"
    }
  },
  "then": {
    "answer": "refused",
    "answer_must_include": [
      "reason"
    ],
    "note": "The personal layer cannot pin a column for everyone by writing its own layer."
  }
}
