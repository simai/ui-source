{
  "schema": "simai.composite.host-port.v1",
  "port": "simai.dataview-port",
  "version": "1.7.0",
  "component": "smart.data-view-composite",
  "element": "sf-data-view",
  "summary": "The host seam for a composed data view with toolbar, content and pagination slots, including scoped saved views, a write answered with the record it changed, and the filter fields a saved view was showing.",
  "capabilities": {
    "saved-views": {
      "summary": "Saved views: opening, saving and deleting a stored view.",
      "intents": [
        "view.open",
        "view.save",
        "view.delete"
      ],
      "data": [
        "saved_views"
      ]
    },
    "shared-column-settings": {
      "summary": "Saving column settings for everyone, a separate permission from the personal layer.",
      "intents": [
        "settings.save_shared"
      ]
    },
    "bulk-under-filter": {
      "summary": "Acting on every record under the current filter, not only the checked ones.",
      "intents": [
        "bulk.apply_under_filter"
      ]
    },
    "row-actions": {
      "summary": "Per-record operations the host resolves; the allowed set travels with each record.",
      "intents": [
        "record.open",
        "record.mutate"
      ]
    },
    "shared-saved-views": {
      "summary": "Write a shared saved view with a permission separate from personal saved views.",
      "intents": [
        "view.save_shared"
      ],
      "data": [
        "saved_views"
      ]
    },
    "count-on-request": {
      "summary": "The host can count the records a query matches, separately from answering the query. Without it the view never offers the number and never asks for it.",
      "intents": [
        "query.count"
      ],
      "data": [
        "has_next"
      ]
    }
  },
  "data": {
    "columns": {
      "summary": "Columns the host allows in this view, with their presentation vocabulary.",
      "required": true,
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            },
            "order": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "width": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "min_width": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "description": "Lower survives longer when the columns do not fit."
            },
            "sticky": {
              "enum": [
                "none",
                "start",
                "end"
              ]
            },
            "sortable": {
              "type": "boolean"
            },
            "renderer": {
              "enum": [
                "link"
              ]
            },
            "role": {
              "enum": [
                "title"
              ],
              "description": "The column that leads the record. The view pins it beside the box and the row menu, and it is the column a reader names the row by. At most one column carries it."
            },
            "property_type": {
              "enum": [
                "string",
                "text",
                "integer",
                "number",
                "date",
                "datetime",
                "boolean",
                "choice",
                "choices",
                "user",
                "record",
                "relation",
                "file",
                "color",
                "include"
              ],
              "description": "What the column holds, so the Framework's shared renderer set draws the value instead of printing it. Without it a boolean reads «true», a choice reads its code and a colour reads its hex."
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "value"
                ],
                "additionalProperties": true,
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "integer",
                      "boolean"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "scheme": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  }
                }
              },
              "description": "The labels a choice or choices column reads. Without them a cell can only show the stored code."
            },
            "variant": {
              "type": "string",
              "description": "How the value is presented within its type -- `image`, `image-card` and `image-list` make a file column show the image, `scale` makes a number a bar. The host's to say: guessing an image from a file name is wrong for every stored file whose name does not end in familiar letters."
            },
            "language": {
              "type": "string",
              "description": "An include column's language. The host's, never guessed from the text."
            },
            "multiple": {
              "type": "boolean",
              "description": "Whether the column holds several values of its type."
            }
          }
        }
      }
    },
    "records": {
      "summary": "Rows of the current answer. Each carries its revision and the actions the host allows for it. In an answer to a write, `records` without `echo`, `total` or `columns` is a patch of exactly those rows, and the view rewrites only them.",
      "required": true,
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "revision",
            "actions"
          ],
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "revision": {
              "type": [
                "string",
                "integer"
              ]
            },
            "actions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "What the host allows for this record. The component offers only these."
            }
          }
        }
      }
    },
    "total": {
      "summary": "How many records match the query the host applied, when the host counts them. A host that does not count leaves it out and answers has_next instead.",
      "required": false,
      "schema": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      }
    },
    "has_next": {
      "summary": "Whether a further page exists. Required when an answer carries no total: it is what moves forward and Show more, so the view never derives a page count it was not given.",
      "required": false,
      "schema": {
        "type": "boolean"
      }
    },
    "echo": {
      "summary": "The request the host answered: chosen and applied filters, refused parts, search, sort and window, plus what a view switch carried over.",
      "required": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filters_chosen",
          "filters",
          "filters_rejected",
          "search",
          "sort",
          "page",
          "per_page"
        ],
        "properties": {
          "filters_chosen": {
            "type": "object",
            "description": "What the person chose."
          },
          "filters": {
            "type": "object",
            "description": "What the host applied."
          },
          "filters_rejected": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Chosen filters the host refused."
          },
          "search": {
            "type": "string"
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "direction"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "direction": {
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1
          },
          "switch": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {
                "type": "object"
              },
              "dropped": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "description": "What a view switch carried over and what it dropped."
          }
        }
      }
    },
    "column_settings": {
      "summary": "Column settings by layer, each with its revision, and where a save goes.",
      "required": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layers",
          "target"
        ],
        "properties": {
          "layers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "package": {
                "type": "object",
                "required": [
                  "revision",
                  "columns"
                ],
                "additionalProperties": false,
                "properties": {
                  "revision": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "columns": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object"
                    }
                  }
                }
              },
              "shared": {
                "type": "object",
                "required": [
                  "revision",
                  "columns"
                ],
                "additionalProperties": false,
                "properties": {
                  "revision": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "columns": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object"
                    }
                  }
                }
              },
              "personal": {
                "type": "object",
                "required": [
                  "revision",
                  "columns"
                ],
                "additionalProperties": false,
                "properties": {
                  "revision": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "columns": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "revision"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "personal",
                  "saved_view"
                ]
              },
              "revision": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "saved_views": {
      "summary": "Stored views as objects: query, field roles, column layout, settings and a revision. `settings.filter_fields` names the filter fields the view was showing, in order.",
      "required": false,
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "key",
            "label",
            "revision"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": [
                "string",
                "integer"
              ]
            },
            "query": {
              "type": "object"
            },
            "roles": {
              "type": "object"
            },
            "layout": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string"
                      },
                      "visible": {
                        "type": "boolean"
                      },
                      "order": {
                        "type": [
                          "number",
                          "string",
                          "null"
                        ]
                      },
                      "width": {
                        "type": [
                          "string",
                          "number",
                          "null"
                        ]
                      },
                      "min_width": {
                        "type": [
                          "string",
                          "number",
                          "null"
                        ]
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Lower survives longer when the columns do not fit."
                      },
                      "sticky": {
                        "enum": [
                          "none",
                          "start",
                          "end"
                        ]
                      },
                      "sortable": {
                        "type": "boolean"
                      },
                      "renderer": {
                        "enum": [
                          "link"
                        ]
                      },
                      "role": {
                        "enum": [
                          "title"
                        ],
                        "description": "The column that leads the record. The view pins it beside the box and the row menu, and it is the column a reader names the row by. At most one column carries it."
                      },
                      "property_type": {
                        "enum": [
                          "string",
                          "text",
                          "integer",
                          "number",
                          "date",
                          "datetime",
                          "boolean",
                          "choice",
                          "choices",
                          "user",
                          "record",
                          "relation",
                          "file",
                          "color",
                          "include"
                        ],
                        "description": "What the column holds, so the Framework's shared renderer set draws the value instead of printing it. Without it a boolean reads «true», a choice reads its code and a colour reads its hex."
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "value"
                          ],
                          "additionalProperties": true,
                          "properties": {
                            "value": {
                              "type": [
                                "string",
                                "integer",
                                "boolean"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "scheme": {
                              "type": "string"
                            },
                            "icon": {
                              "type": "string"
                            }
                          }
                        },
                        "description": "The labels a choice or choices column reads. Without them a cell can only show the stored code."
                      },
                      "variant": {
                        "type": "string",
                        "description": "How the value is presented within its type -- `image`, `image-card` and `image-list` make a file column show the image, `scale` makes a number a bar. The host's to say: guessing an image from a file name is wrong for every stored file whose name does not end in familiar letters."
                      },
                      "language": {
                        "type": "string",
                        "description": "An include column's language. The host's, never guessed from the text."
                      },
                      "multiple": {
                        "type": "boolean",
                        "description": "Whether the column holds several values of its type."
                      }
                    }
                  }
                }
              }
            },
            "settings": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "filter_fields": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Filter fields the view shows, in order. The view puts them back when it opens."
                }
              }
            },
            "level": {
              "enum": [
                "package",
                "shared",
                "personal"
              ],
              "description": "Optional metadata; absent on a 1.0.0 host."
            }
          }
        }
      }
    }
  },
  "intents": {
    "query.change": {
      "summary": "Answer the current search, filter, sort and window. Every request carries its sequence; an older answer is dropped.",
      "event": "sf-table-query-intent",
      "payload": {
        "type": "object",
        "required": [
          "sequence",
          "query"
        ],
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "query": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "carries_revision": false,
      "answers": [
        "applied",
        "refused",
        "unavailable"
      ],
      "capability": null
    },
    "record.open": {
      "summary": "Open one record for reading.",
      "event": "sf-table-action-intent",
      "payload": {
        "type": "object",
        "required": [
          "action_id",
          "record_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "const": "view"
          },
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        }
      },
      "carries_revision": false,
      "answers": [
        "applied",
        "refused",
        "unavailable"
      ],
      "capability": "row-actions"
    },
    "record.mutate": {
      "summary": "Create, edit, delete or restore one record. The host re-reads the stored bytes and compares the revision. An applied answer may carry `records` alone -- the records as they now are -- and the view writes those rows in place instead of re-reading the page.",
      "event": "sf-table-action-intent",
      "payload": {
        "type": "object",
        "required": [
          "action_id",
          "record_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "revisions": {
            "type": "object"
          }
        }
      },
      "carries_revision": true,
      "answers": [
        "applied",
        "conflict",
        "refused",
        "unavailable"
      ],
      "capability": "row-actions"
    },
    "bulk.apply_selected": {
      "summary": "Apply one action to the checked records, each with the revision the browser last saw. Refused as a whole when any revision is stale.",
      "event": "sf-table-action-intent",
      "payload": {
        "type": "object",
        "required": [
          "action_id",
          "record_ids",
          "revisions"
        ],
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "revisions": {
            "type": "object"
          }
        }
      },
      "carries_revision": true,
      "answers": [
        "applied",
        "conflict",
        "refused",
        "unavailable"
      ],
      "capability": null
    },
    "bulk.apply_under_filter": {
      "summary": "Apply one action to every record under the filter the host applied, with the count the person confirmed.",
      "event": "sf-table-action-intent",
      "payload": {
        "type": "object",
        "required": [
          "action_id",
          "filters",
          "confirmed_total"
        ],
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "filters": {
            "type": "object"
          },
          "confirmed_total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "carries_revision": false,
      "answers": [
        "applied",
        "conflict",
        "refused",
        "unavailable"
      ],
      "capability": "bulk-under-filter"
    },
    "settings.save_personal": {
      "summary": "Save column settings for this person, against the revision of the personal layer.",
      "event": "sf-table-column-settings-change",
      "payload": {
        "type": "object",
        "required": [
          "columnSettings",
          "base_revision"
        ],
        "additionalProperties": false,
        "properties": {
          "columnSettings": {
            "type": "object"
          },
          "base_revision": {
            "type": [
              "string",
              "integer"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "carries_revision": true,
      "answers": [
        "applied",
        "conflict",
        "refused",
        "unavailable"
      ],
      "capability": null
    },
    "settings.save_shared": {
      "summary": "Save column settings for everyone. A separate permission and a separate endpoint from the personal layer.",
      "event": "sf-table-column-settings-change",
      "payload": {
        "type": "object",
        "required": [
          "columnSettings",
          "base_revision",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "columnSettings": {
            "type": "object"
          },
          "base_revision": {
            "type": [
              "string",
              "integer"
            ]
          },
          "target": {
            "const": "shared"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "carries_revision": true,
      "answers": [
        "applied",
        "conflict",
        "refused",
        "unavailable"
      ],
      "capability": "shared-column-settings"
    },
    "view.open": {
      "summary": "Load a stored view.",
      "event": "sf-table-template-select",
      "payload": {
        "type": "object",
        "required": [
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "carries_revision": false,
      "answers": [
        "applied",
        "refused",
        "unavailable"
      ],
      "capability": "saved-views"
    },
    "view.save": {
      "summary": "Store the current view, or update a stored one against its revision. `settings.filter_fields` carries the filter fields the view is showing.",
      "event": "sf-table-template-save",
      "payload": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "integer"
            ]
          }
        }
      },
      "carries_revision": true,
      "answers": [
        "applied",
        "conflict",
        "refused",
        "unavailable"
      ],
      "capability": "saved-views"
    },
    "view.delete": {
      "summary": "Delete a stored view.",
      "event": "sf-table-template-delete",
      "payload": {
        "type": "object",
        "required": [
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "carries_revision": false,
      "answers": [
        "applied",
        "conflict",
        "refused",
        "unavailable"
      ],
      "capability": "saved-views"
    },
    "view.create_record": {
      "summary": "Open the host's create form, optionally for a named kind.",
      "event": "sf-table-create-intent",
      "payload": {
        "type": "object",
        "required": [
          "item"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "carries_revision": false,
      "answers": [
        "applied",
        "refused",
        "unavailable"
      ],
      "capability": null
    },
    "view.save_shared": {
      "summary": "Write a shared saved view with a separate permission and a named target.",
      "event": "sf-data-view-saved-view-intent",
      "payload": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "key",
          "target"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "integer"
            ]
          },
          "target": {
            "const": "shared"
          }
        }
      },
      "carries_revision": true,
      "answers": [
        "applied",
        "conflict",
        "refused",
        "unavailable"
      ],
      "capability": "shared-saved-views"
    },
    "query.count": {
      "summary": "Count the records the current query matches. Raised when a person asks for the number, and before an action under the filter, which needs a confirmed total.",
      "event": "sf-count-request",
      "capability": "count-on-request",
      "carries_revision": false,
      "answers": [
        "applied",
        "refused",
        "unavailable"
      ],
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
