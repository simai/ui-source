        "properties": {
          "query": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "search": {
                "type": "string"
              },
              "filters": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "reason": {
            "enum": [
              "total",
              "last-page",
              "action-for-all"
            ],
            "description": "Why the count was asked for. The view resumes that step once the number arrives."
          }
        }
      }
    },
    "list.open": {
      "summary": "Open the whole list this view is showing part of. Raised by the show-all action a row cap puts under a capped list; the host navigates or opens a full view. The component never builds an address -- it has none to build from, and a guessed one would send a person to a page the product does not have.",
      "event": "sf-data-view-list-open",
      "carries_revision": false,
      "payload": {
        "type": "object",
