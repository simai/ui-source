          "query"
        ],
        "additionalProperties": false,
        "properties": {
          "reason": {
            "enum": [
              "row-cap"
            ],
            "description": "Why the list is being opened. One value today; declared as an enum so a later reason is a declared addition rather than a free string a host has to guess at."
          },
          "query": {
            "type": "object",
            "description": "The query the capped list is showing, so the full view opens on the same records rather than on an unfiltered collection."
