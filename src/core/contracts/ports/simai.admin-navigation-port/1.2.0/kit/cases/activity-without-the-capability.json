  "given": {
    "capabilities": [
      "favourites",
      "menu-profiles",
      "notifications",
      "preferences",
      "search",
      "sign-out",
      "site-switch"
    ]
  },
  "when": {
    "intent": "activity.load",
    "payload": {}
  },
  "then": {
    "answer": "unavailable"
  }
}
