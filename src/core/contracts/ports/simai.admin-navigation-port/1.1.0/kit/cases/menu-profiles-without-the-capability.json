  "when": {
    "intent": "view.save",
    "payload": {
      "profile": "personal",
      "revision": "p1",
      "layout": {
        "schema_version": 1,
        "items": {},
        "own": []
      }
    }
  },
  "then": {
    "answer": "unavailable"
  }
}
