{
  "id": "starring-a-page-that-is-no-row",
  "intent": "favourite.toggle",
  "capability": "favourites",
  "summary": "A page that is no menu row is starred with what to show for it.",
  "given": {
    "capabilities": [
      "favourites",
      "menu-profiles",
      "notifications",
      "preferences",
      "search",
      "sign-out",
      "site-switch"
    ]
  },
  "when": {
    "intent": "favourite.toggle",
    "payload": {
      "key": "record:catalog:r-001",
      "on": true,
      "label": "SIMAI: Платежи №100",
      "icon": "inventory_2",
      "href": "/admin/data/catalog?record=r-001"
    }
  },
  "then": {
    "answer": "applied",
    "answer_must_include": [
      "favourites"
    ],
    "note": "The ☆ is in the head of every page, so a record or a searched list can be a favourite. The answer carries it as an object; a list of row keys could not hold it."
  }
}
