{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "quote-default",
  "summary": "A quote with its author and the defaults: at the start, regular size.",
  "covers": [
    "sample.quote"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "q",
              "type": "sample.quote",
              "data": {
                "author": "Ada Lovelace"
              },
              "slots": {
                "default": [
                  {
                    "id": "q1",
                    "type": "content.paragraph",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "The engine weaves "
                        },
                        {
                          "type": "text",
                          "value": "algebraic",
                          "marks": [
                            "em"
                          ]
                        },
                        {
                          "type": "text",
                          "value": " patterns."
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><figure class=\"sample-quote sample-quote--start sample-quote--default\" data-sf-composition-id=\"q\"><blockquote class=\"sample-quote-text\"><p data-sf-composition-id=\"q1\">The engine weaves <em>algebraic</em> patterns.</p></blockquote><figcaption class=\"sample-quote-caption\"><span class=\"sample-quote-author\">Ada Lovelace</span></figcaption></figure></article>",
    "diagnostics": [],
    "assets": [
      "sample/quote"
    ]
  }
}
