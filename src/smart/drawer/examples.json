{
  "examples": [
    {
      "name": "reference",
      "title": "Панель справа",
      "settings": {
        "open": true,
        "heading": "Фильтры",
        "placement": "right"
      },
      "slots": {
        "content": "<p>Содержимое панели</p>"
      },
      "expect": {
        "open": true,
        "name": "Фильтры"
      },
      "from": "studio.fixture.json",
      "studio": {
        "props": {
          "open": true,
          "title": "Параметры проекта",
          "label": "Параметры проекта",
          "placement": "inline-end",
          "size": "1"
        },
        "children": [
          {
            "element": "p",
            "props": {},
            "text": "Содержимое боковой панели",
            "children": []
          }
        ],
        "scenario": {
          "steps": [
            {
              "invoke": "toggle",
              "with": []
            }
          ],
          "assertions": [
            "upgraded",
            "no-console-error",
            "no-network"
          ]
        }
      }
    },
    {
      "name": "toggled",
      "title": "Открыть и закрыть",
      "settings": {
        "heading": "Фильтры"
      },
      "script": [
        {
          "act": "toggle"
        }
      ],
      "expect": {
        "open": true,
        "events": [
          "open",
          "opened"
        ]
      },
      "from": "studio.scenario.json"
    },
    {
      "name": "docked",
      "title": "Колонка страницы",
      "settings": {
        "open": true,
        "docked": true,
        "placement": "inline-start",
        "label": "Навигация"
      },
      "expect": {
        "open": true
      }
    },
    {
      "name": "sheet",
      "title": "Нижний лист",
      "settings": {
        "open": true,
        "placement": "bottom",
        "snap": "half",
        "label": "Действия"
      },
      "expect": {
        "open": true
      }
    },
    {
      "name": "outside-close",
      "title": "Кнопка закрытия снаружи",
      "settings": {
        "open": true,
        "heading": "Карточка",
        "close-placement": "outside"
      },
      "expect": {
        "open": true
      }
    },
    {
      "name": "unsaved",
      "title": "С несохранённым",
      "settings": {
        "open": true,
        "heading": "Запись",
        "unsaved": true
      },
      "script": [
        {
          "act": "close",
          "with": {
            "reason": "api"
          }
        }
      ],
      "expect": {
        "events": [
          "close"
        ],
        "detail": {
          "close": {
            "reason": "api",
            "unsaved": true
          }
        }
      }
    }
  ],
  "pages": [
    {
      "name": "conformance",
      "title": "sf-drawer against component.json (standard simai.smart-component 1.3.8 §12, §19, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main>",
          "  <button id=\"opener\" data-sf-action=\"d1.open\">Панель</button>",
          "  <button id=\"opener-old\" data-sf-drawer-open=\"d-old\">Старое имя</button>",
          "  <button id=\"opener-locked\" data-sf-action=\"d-locked.open\">Обязательная</button>",
          "</main>",
          "<div id=\"area\"><sf-drawer id=\"d1\" heading=\"Фильтры\"><input id=\"d1-field\" aria-label=\"Поиск\"><button id=\"d1-close\" data-sf-action=\"d1.close\">Готово</button><button slot=\"edge\" id=\"d1-edge\">Край</button></sf-drawer></div>",
          "<sf-drawer id=\"d-old\" title=\"Старая панель\"><p>Старые имена</p></sf-drawer>",
          "<sf-drawer id=\"d-locked\" heading=\"Решите\" dismissible=\"false\" unsaved><button id=\"locked-ok\" data-sf-action=\"d-locked.close\">Понятно</button></sf-drawer>",
          "<sf-drawer id=\"d-sheet\" placement=\"bottom\" label=\"Лист\"><p>Лист</p></sf-drawer>",
          "<div id=\"dock-host\" data-sf-drawer-dock-host style=\"width: 1000px\"><button id=\"opener-dock\" data-sf-action=\"d-dock.open\">Чаты</button><button id=\"after-dock\">Дальше</button></div>",
          "<sf-drawer id=\"d-dock\" docked dock-breakpoint=\"600px\" placement=\"inline-start\" label=\"Чаты\"><button id=\"d-dock-a\">Первый</button><button id=\"d-dock-b\">Второй</button></sf-drawer>"
        ]
      },
      "checks": [
        {
          "id": "p1-open-focus-lock",
          "title": "open moves focus into the panel and locks the page; sf-drawer-opened",
          "covers": "layer.traps-focus, layer.locks-page, events.opened, data-sf-action",
          "steps": [
            {
              "user": "click:#opener",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-open",
                    "count": 1,
                    "detail": {
                      "drawerId": "d1"
                    }
                  },
                  {
                    "name": "sf-drawer-opened",
                    "count": 1,
                    "detail": {
                      "drawerId": "d1"
                    }
                  }
                ],
                "values": {
                  "#d1.open": true
                }
              }
            },
            {
              "focus": "expect inside",
              "target": "[data-sf-drawer-portal=\"d1\"] [data-sf-drawer-panel]"
            },
            {
              "check": "document.documentElement.style.overflow === 'hidden'"
            }
          ]
        },
        {
          "id": "p2-escape-reason-returns-focus",
          "title": "Escape closes with reason escape and returns focus to the opener",
          "covers": "keyboard.host.Escape close, events.close {reason, unsaved}, events.closed",
          "steps": [
            {
              "user": "click:#opener"
            },
            {
              "user": "keyboard:Escape",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-close",
                    "count": 1,
                    "detail": {
                      "reason": "escape",
                      "unsaved": false
                    }
                  },
                  {
                    "name": "sf-drawer-closed",
                    "count": 1,
                    "detail": {
                      "reason": "escape"
                    }
                  }
                ],
                "values": {
                  "#d1.open": false
                }
              }
            },
            {
              "focus": "expect returned to #opener"
            },
            {
              "check": "document.documentElement.style.overflow !== 'hidden'"
            }
          ]
        },
        {
          "id": "p3-outside-and-close-reasons",
          "title": "the overlay says outside, the close button says close",
          "covers": "§19.3 outside, close",
          "steps": [
            {
              "user": "click:#opener"
            },
            {
              "user": "click:[data-sf-drawer-portal=\"d1\"] [data-sf-drawer-overlay]",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-closed",
                    "count": 1,
                    "detail": {
                      "reason": "outside"
                    }
                  }
                ],
                "values": {
                  "#d1.open": false
                }
              }
            },
            {
              "user": "click:#opener"
            },
            {
              "user": "click:[data-sf-drawer-portal=\"d1\"] .sf-drawer-close",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-closed",
                    "count": 1,
                    "detail": {
                      "reason": "close"
                    }
                  }
                ],
                "values": {
                  "#d1.open": false
                }
              }
            }
          ]
        },
        {
          "id": "p4-focus-trap",
          "title": "Tab and Shift+Tab stay inside the modal drawer: its panel and then its edge",
          "covers": "keyboard.host.Tab, Shift+Tab reach; the edge is in the cycle (9fe3044)",
          "steps": [
            {
              "user": "click:#opener"
            },
            {
              "user": "keyboard:Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Tab",
              "wait": 60
            },
            {
              "check": "document.activeElement?.id === 'd1-edge'"
            },
            {
              "focus": "expect inside",
              "target": "[data-sf-drawer-portal=\"d1\"] [data-sf-drawer-root]"
            },
            {
              "user": "keyboard:Shift+Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Shift+Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Shift+Tab",
              "wait": 60
            },
            {
              "focus": "expect inside",
              "target": "[data-sf-drawer-portal=\"d1\"] [data-sf-drawer-root]"
            }
          ]
        },
        {
          "id": "p5-not-dismissible",
          "title": "dismissible=false ignores Escape and the overlay; an explicit action closes with unsaved",
          "covers": "settings.dismissible, settings.unsaved",
          "steps": [
            {
              "user": "click:#opener-locked"
            },
            {
              "user": "keyboard:Escape",
              "expect": {
                "values": {
                  "#d-locked.open": true
                }
              }
            },
            {
              "user": "click:[data-sf-drawer-portal=\"d-locked\"] [data-sf-drawer-overlay]",
              "expect": {
                "values": {
                  "#d-locked.open": true
                }
              }
            },
            {
              "user": "click:[data-sf-drawer-portal=\"d-locked\"] #locked-ok",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-close",
                    "count": 1,
                    "detail": {
                      "reason": "api",
                      "unsaved": true
                    }
                  }
                ],
                "values": {
                  "#d-locked.open": false
                }
              }
            }
          ]
        },
        {
          "id": "p6-refused-close",
          "title": "a page that prevents the close request keeps the panel; the action answers refused",
          "covers": "events.close cancelable",
          "steps": [
            {
              "user": "click:#opener"
            },
            {
              "script": "(document.getElementById('d1').addEventListener('sf-drawer-close', (event) => event.preventDefault()), true)"
            },
            {
              "action": {
                "name": "close"
              },
              "target": "#d1",
              "expect": {
                "returns": {
                  "outcome": "refused",
                  "reason": "prevented"
                },
                "values": {
                  "#d1.open": true
                }
              }
            }
          ]
        },
        {
          "id": "p7-old-names-once-dated",
          "title": "old and new names fire once each; the old ones keep their detail and are noted with their dates",
          "covers": "aliases.json split rows, §16.20",
          "steps": [
            {
              "user": "click:#opener",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-opened",
                    "count": 1
                  },
                  {
                    "name": "drawer:after-open",
                    "count": 1,
                    "detail": {
                      "drawerId": "d1",
                      "drawer": "<sf-drawer>"
                    }
                  }
                ],
                "journal": [
                  {
                    "from": "drawer:after-open",
                    "to": "sf-drawer-opened",
                    "kind": "event",
                    "since": "2026-10-27",
                    "remove_after": "2026-12-01"
                  }
                ]
              }
            },
            {
              "user": "keyboard:Escape",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-closed",
                    "count": 1
                  },
                  {
                    "name": "drawer:after-close",
                    "count": 1,
                    "detail": {
                      "reason": "escape",
                      "drawer": "<sf-drawer>"
                    }
                  }
                ],
                "journal": [
                  {
                    "from": "drawer:after-close",
                    "to": "sf-drawer-closed",
                    "since": "2026-10-27",
                    "remove_after": "2026-12-01"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p8-old-title-and-trigger",
          "title": "title and data-sf-drawer-open still work; title is noted with its dates",
          "covers": "aliases.json setting row, §16.10",
          "steps": [
            {
              "user": "click:#opener-old",
              "expect": {
                "values": {
                  "#d-old.open": true,
                  "#d-old.heading": "Старая панель"
                }
              }
            },
            {
              "check": "document.querySelector('[data-sf-drawer-portal=\"d-old\"] .sf-drawer-title').textContent === 'Старая панель' && [...SF.__deprecationNotes.values()].some((note) => note.component === 'sf-drawer' && note.from === 'title' && note.remove_after === '2026-12-01')"
            }
          ]
        },
        {
          "id": "p9-slots-placed",
          "title": "the page's nodes are placed, not copied: the content keeps its node and the edge stands beside the panel",
          "covers": "§4.5 slots content and edge",
          "steps": [
            {
              "script": "(window.__field = document.getElementById('d1-field'), true)"
            },
            {
              "user": "click:#opener"
            },
            {
              "check": "document.querySelector('[data-sf-drawer-portal=\"d1\"] [data-sf-drawer-body] #d1-field') === window.__field && Boolean(document.querySelector('[data-sf-drawer-portal=\"d1\"] [data-sf-drawer-edge] #d1-edge'))"
            }
          ]
        },
        {
          "id": "p10-snapped",
          "title": "a bottom sheet reports where it rests: sf-drawer-snapped {snap}",
          "covers": "events.snapped",
          "steps": [
            {
              "action": {
                "name": "open"
              },
              "target": "#d-sheet"
            },
            {
              "user": "click:[data-sf-drawer-portal=\"d-sheet\"] [data-sf-drawer-handle]",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-snapped",
                    "count": 1,
                    "detail": {
                      "snap": "full"
                    }
                  },
                  {
                    "name": "drawer:snap",
                    "count": 1
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p11-portal-carries-variables",
          "title": "the portal carries the host's declared public variables and lang",
          "covers": "§19.1 css-variables",
          "steps": [
            {
              "script": "(document.getElementById('area').style.setProperty('--sf-drawer-background', 'rgb(1, 2, 3)'), true)",
              "wait": 50
            },
            {
              "user": "click:#opener"
            },
            {
              "check": "document.querySelector('[data-sf-drawer-portal=\"d1\"]').style.getPropertyValue('--sf-drawer-background') === 'rgb(1, 2, 3)' && document.querySelector('[data-sf-drawer-portal=\"d1\"]').getAttribute('lang') === 'ru'"
            }
          ]
        },
        {
          "id": "p12-docked-narrow-is-modal",
          "title": "a docked drawer without the room floats as a modal panel: focus inside, the page covered and locked, Tab kept, Escape closes, focus back to the opener",
          "covers": "settings.modal with docked below dock-breakpoint (1.8.0, q-a49e2045c1), layer.traps-focus, layer.locks-page, §19.2",
          "steps": [
            {
              "script": "(document.getElementById('dock-host').style.width = '400px', true)",
              "wait": 100
            },
            {
              "user": "click:#opener-dock",
              "expect": {
                "values": {
                  "#d-dock.open": true,
                  "#d-dock.modal": true
                }
              }
            },
            {
              "focus": "expect inside",
              "target": "[data-sf-drawer-portal=\"d-dock\"] [data-sf-drawer-panel]"
            },
            {
              "check": "document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').getAttribute('role') === 'dialog' && document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').getAttribute('aria-modal') === 'true' && !document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-overlay]').hidden && document.documentElement.style.overflow === 'hidden' && document.elementFromPoint(1200, 700)?.hasAttribute('data-sf-drawer-overlay') === true"
            },
            {
              "user": "keyboard:Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Tab",
              "wait": 60
            },
            {
              "focus": "expect inside",
              "target": "[data-sf-drawer-portal=\"d-dock\"] [data-sf-drawer-panel]"
            },
            {
              "user": "keyboard:Shift+Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Shift+Tab",
              "wait": 60
            },
            {
              "user": "keyboard:Shift+Tab",
              "wait": 60
            },
            {
              "focus": "expect inside",
              "target": "[data-sf-drawer-portal=\"d-dock\"] [data-sf-drawer-panel]"
            },
            {
              "user": "keyboard:Escape",
              "expect": {
                "events": [
                  {
                    "name": "sf-drawer-closed",
                    "count": 1,
                    "detail": {
                      "drawerId": "d-dock",
                      "reason": "escape"
                    }
                  }
                ],
                "values": {
                  "#d-dock.open": false
                }
              }
            },
            {
              "focus": "expect returned to #opener-dock"
            },
            {
              "check": "document.documentElement.style.overflow !== 'hidden'"
            }
          ]
        },
        {
          "id": "p13-docked-wide-stays-a-column",
          "title": "with the room the docked drawer is a modeless column: no scrim, no trap, no page lock, presses reach the page",
          "covers": "settings.docked, settings.dock-breakpoint (wide)",
          "steps": [
            {
              "user": "click:#opener-dock",
              "expect": {
                "values": {
                  "#d-dock.open": true,
                  "#d-dock.modal": false
                }
              }
            },
            {
              "check": "document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').getAttribute('role') === 'region' && !document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').hasAttribute('aria-modal') && document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-overlay]').hidden && document.documentElement.style.overflow !== 'hidden' && !document.elementFromPoint(1200, 700)?.closest('[data-sf-drawer-portal]') && document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-root]').getAttribute('data-sf-drawer-column') === 'true'"
            }
          ]
        },
        {
          "id": "p14-docked-narrows-while-open",
          "title": "an open docked column that loses the room becomes modal and takes the focus; given the room back it is a modeless column again",
          "covers": "syncModal: the stack re-declared when the dock host crosses dock-breakpoint",
          "steps": [
            {
              "user": "click:#opener-dock"
            },
            {
              "script": "(document.getElementById('after-dock').focus(), true)",
              "wait": 60
            },
            {
              "script": "(document.getElementById('dock-host').style.width = '400px', true)",
              "wait": 300
            },
            {
              "check": "document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').getAttribute('role') === 'dialog' && document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').getAttribute('aria-modal') === 'true' && !document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-overlay]').hidden && document.documentElement.style.overflow === 'hidden' && document.elementFromPoint(1200, 700)?.hasAttribute('data-sf-drawer-overlay') === true"
            },
            {
              "focus": "expect inside",
              "target": "[data-sf-drawer-portal=\"d-dock\"] [data-sf-drawer-panel]"
            },
            {
              "script": "(document.getElementById('dock-host').style.width = '1000px', true)",
              "wait": 300
            },
            {
              "check": "document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').getAttribute('role') === 'region' && !document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').hasAttribute('aria-modal') && document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-overlay]').hidden && document.documentElement.style.overflow !== 'hidden' && !document.elementFromPoint(1200, 700)?.closest('[data-sf-drawer-portal]')"
            }
          ]
        },
        {
          "id": "p15-docked-modal-false-stays-modeless",
          "title": "modal=\"false\" keeps a docked drawer modeless when it floats",
          "covers": "settings.modal=false with docked (backwards compatible)",
          "steps": [
            {
              "script": "(document.getElementById('d-dock').setAttribute('modal', 'false'), true)",
              "wait": 60
            },
            {
              "script": "(document.getElementById('dock-host').style.width = '400px', true)",
              "wait": 100
            },
            {
              "user": "click:#opener-dock",
              "expect": {
                "values": {
                  "#d-dock.open": true,
                  "#d-dock.modal": false
                }
              }
            },
            {
              "check": "document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').getAttribute('role') === 'region' && !document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-panel]').hasAttribute('aria-modal') && document.querySelector('[data-sf-drawer-portal=\\\"d-dock\\\"] [data-sf-drawer-overlay]').hidden && document.documentElement.style.overflow !== 'hidden' && !document.elementFromPoint(1200, 700)?.closest('[data-sf-drawer-portal]')"
            }
          ]
        }
      ]
    }
  ]
}
