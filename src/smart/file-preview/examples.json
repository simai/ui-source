{
  "examples": [
    {
      "name": "reference",
      "title": "Файл",
      "settings": {
        "file-name": "Техническое задание.pdf",
        "file-size": "2,4 МБ",
        "icon": "description",
        "href": "#",
        "download-label": "Скачать файл",
        "remove-label": "Удалить файл"
      },
      "expect": {
        "role": "group",
        "name": "Техническое задание.pdf"
      },
      "from": "studio.fixture.json"
    },
    {
      "name": "image",
      "title": "Изображение",
      "settings": {
        "file-name": "photo.jpg",
        "image-url": "data:image/gif;base64,R0lGODlhAQABAAAAACw=",
        "kind": "image"
      },
      "expect": {
        "name": "photo.jpg"
      }
    },
    {
      "name": "compact",
      "title": "В строку списка",
      "settings": {
        "file-name": "report.xlsx",
        "compact": true,
        "href": "#"
      },
      "expect": {
        "name": "report.xlsx"
      }
    },
    {
      "name": "detach",
      "title": "Открепить",
      "settings": {
        "file-name": "contract.docx",
        "href": "#"
      },
      "script": [
        {
          "press": "[data-action=\"remove\"]"
        }
      ],
      "expect": {
        "events": [
          {
            "detach": {
              "id": "#",
              "action": "remove"
            }
          }
        ]
      }
    },
    {
      "name": "disabled",
      "title": "Недоступен",
      "settings": {
        "file-name": "old.pdf",
        "disabled": true
      },
      "expect": {
        "name": "old.pdf"
      }
    }
  ]
}
