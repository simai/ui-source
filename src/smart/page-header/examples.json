        "star": false
      },
      "expect": {
        "heading": "Каталог решений",
        "star": false
      },
      "studio": {
        "props": {
          "heading": "Каталог решений",
          "count": "448",
          "star": false
        },
        "scenario": {}
      }
    },
    {
      "name": "favourite",
      "title": "Страница в избранном",
      "settings": {
        "heading": "Заказы",
        "count": "~1 200",
        "star": true
      },
      "expect": {
        "star": true
      }
    },
    {
      "name": "install",
      "title": "Страница для всех сайтов",
      "settings": {
        "heading": "Пользователи",
        "level": "install"
      },
      "expect": {
