{
  "probe": "sf-code-input against component.json (standard simai.smart-component 1.3.8 §12, §17, gate 20)",
  "page": {
    "lang": "ru",
    "markup": "<form id=\"f\">{{field}}<button type=\"submit\">OK</button></form>",
    "listen": [
      "input",
      "change",
      "sf-code-input-completed"
    ],
    "box": ".sf-verification-input"
  },
  "format": "stands/15-scenarios (A2 quantity); the runner is tests/browser/fields-manifest.browser.mjs",
  "checks": [
    {
      "id": "typed-code-submits",
      "covers": "values.value, form.submits",
      "field": "<sf-code-input name=\"code\" label=\"Код\"></sf-code-input>",
      "user": [
        "type:123456",
        "tab"
      ],
      "form": "submit",
      "expect": {
        "submitted": true,
        "formData": {
          "code": "123456"
        },
        "formNames": [
          "code"
        ],
        "innerNames": [
          null
        ],
        "listed": 1
      }
    },
    {
      "id": "completed-new-then-old-event",
      "covers": "events.completed: sf-code-input-completed then sf-code-input:complete once each, one detail, a dated journal note (§8, §16.20)",
      "field": "<sf-code-input name=\"code\" label=\"Код\"></sf-code-input>",
      "listen": [
        "sf-code-input-completed",
        "sf-code-input:complete"
      ],
      "user": "type:123456",
      "expect": {
        "events": [
          {
            "type": "sf-code-input-completed",
            "value": "123456"
          },
          {
            "type": "sf-code-input:complete",
            "value": "123456"
          }
        ],
        "journal": [
          {
            "from": "sf-code-input:complete",
            "to": "sf-code-input-completed",
            "kind": "event",
            "since": "2026-10-27",
            "remove_after": "2026-12-01"
          }
        ]
      }
    },
    {
      "id": "letters-are-refused-in-numeric-mode",
      "covers": "settings.mode numeric",
      "field": "<sf-code-input name=\"code\" label=\"Код\"></sf-code-input>",
      "user": "type:a1b2",
      "expect": {
        "value": "12"
      }
    },
    {
      "id": "setting-value-is-silent",
      "covers": "§8: a value set from outside sends nothing",
      "field": "<sf-code-input name=\"code\" label=\"Код\"></sf-code-input>",
      "property": {
        "name": "value",
        "value": "42"
      },
      "expect": {
        "events": [],
        "value": "42",
        "formData": {
          "code": "42"
        }
      }
    },
    {
      "id": "required-empty-blocks-submit",
      "covers": "form.required, form.validity value-missing",
      "field": "<sf-code-input name=\"code\" label=\"Код\" required></sf-code-input>",
      "form": "submit",
      "expect": {
        "submitted": false,
        "checkValidity": false,
        "validity": {
          "valueMissing": true,
          "valid": false
        }
      }
    },
    {
      "id": "incomplete-code-is-pattern-mismatch",
      "covers": "form.validity pattern-mismatch",
      "field": "<sf-code-input name=\"code\" label=\"Код\" value=\"12\"></sf-code-input>",
      "form": "submit",
      "expect": {
        "submitted": false,
        "validity": {
          "patternMismatch": true
        }
      }
    },
    {
      "id": "end-goes-to-the-last-cell",
      "covers": "keyboard End to:last",
      "field": "<sf-code-input name=\"code\" label=\"Код\" value=\"123\"></sf-code-input>",
      "user": "keyboard:End",
      "expect": {
        "texts": {
          ".sf-code-input-position": "цифра 4 из 6"
        }
      }
    },
    {
      "id": "home-goes-to-the-first-cell",
      "covers": "keyboard Home to:first",
      "field": "<sf-code-input name=\"code\" label=\"Код\" value=\"123\"></sf-code-input>",
      "user": [
        "keyboard:End",
        "keyboard:Home"
      ],
      "expect": {
        "texts": {
          ".sf-code-input-position": "цифра 1 из 6"
        }
      }
    },
    {
      "id": "arrow-left-goes-back-a-cell",
      "covers": "keyboard ArrowLeft focus:prev",
      "field": "<sf-code-input name=\"code\" label=\"Код\" value=\"123\"></sf-code-input>",
      "user": [
        "keyboard:End",
        "keyboard:ArrowLeft"
      ],
      "expect": {
        "texts": {
          ".sf-code-input-position": "цифра 3 из 6"
        }
      }
    },
    {
      "id": "arrow-right-goes-on-a-cell",
      "covers": "keyboard ArrowRight focus:next",
      "field": "<sf-code-input name=\"code\" label=\"Код\" value=\"123\"></sf-code-input>",
      "user": [
        "keyboard:Home",
        "keyboard:ArrowRight"
      ],
      "expect": {
        "texts": {
          ".sf-code-input-position": "цифра 2 из 6"
        }
      }
    },
    {
      "id": "backspace-clears-and-steps-back",
      "covers": "keyboard Backspace focus:prev",
      "field": "<sf-code-input name=\"code\" label=\"Код\" value=\"123\"></sf-code-input>",
      "user": [
        "keyboard:End",
        "keyboard:Backspace"
      ],
      "expect": {
        "value": "12",
        "texts": {
          ".sf-code-input-position": "цифра 3 из 6"
        }
      }
    },
    {
      "id": "tab-reaches-the-input",
      "covers": "keyboard Tab reach",
      "field": "<sf-code-input name=\"code\" label=\"Код\"></sf-code-input>",
      "user": "tab",
      "expect": {
        "focus": "sf-code-input .sf-verification-input"
      }
    },
    {
      "id": "disabled-leaves-the-form",
      "covers": "form.disabled (§17.1 item 3)",
      "field": "<sf-code-input name=\"code\" label=\"Код\" value=\"123456\"></sf-code-input>",
      "setting": {
        "name": "disabled",
        "value": true
      },
      "expect": {
        "formData": {
          "code": null
        },
        "disabled": {
          ".sf-verification-input": true
        }
      }
    },
    {
      "id": "form-reset-returns-the-default",
      "covers": "form.reset (§17.1 item 4), no events",
      "field": "<sf-code-input name=\"code\" label=\"Код\" default-value=\"123\"></sf-code-input>",
      "given": [
        {
          "user": [
            "keyboard:End",
            "type:4"
          ]
        }
      ],
      "form": "reset",
      "expect": {
        "events": [],
        "value": "123",
        "formData": {
          "code": "123"
        }
      }
    },
    {
      "id": "ids-from-the-instance-path",
      "covers": "§7.1.1, simai/ui-source#41: no counter id",
      "field": "<sf-code-input name=\"code\" label=\"Код\"></sf-code-input>",
      "form": "reset",
      "expect": {
        "box": {
          "attributes": {
            "id": "sf-code-input-1--control",
            "aria-describedby": "sf-code-input-1--position"
          }
        }
      }
    },
    {
      "id": "custom-validity-blocks-submit",
      "covers": "form.validity custom-error (§17.2)",
      "field": "<sf-code-input name=\"code\" label=\"Код\" value=\"123456\"></sf-code-input>",
      "action": {
        "name": "set-custom-validity",
        "with": "Неверный код"
      },
      "expect": {
        "checkValidity": false,
        "validity": {
          "customError": true,
          "valid": false
        }
      }
    },
    {
      "id": "legacy-error-is-invalid",
      "covers": "aliases.json error -> invalid (§17.2)",
      "field": "<sf-code-input name=\"code\" label=\"Код\"></sf-code-input>",
      "setting": {
        "name": "error",
        "value": true
      },
      "expect": {
        "host": {
          "attributes": {
            "invalid": ""
          }
        },
        "box": {
          "attributes": {
            "aria-invalid": "true"
          }
        },
        "journal": [
          {
            "from": "error",
            "to": "invalid",
            "kind": "setting",
            "since": "2026-10-27",
            "remove_after": "2026-12-01"
          }
        ]
      }
    }
  ]
}
