        "href": "#",
        "appearance": "card"
      },
      "studio": {
        "scenario": {}
      }
    },
    {
      "name": "label",
      "title": "С подписью и адресом",
      "settings": {
        "label": "Начало работы",
        "text": "/guides/getting-started/",
        "href": "/guides/getting-started/"
      },
      "expect": {
        "label": "Начало работы"
      }
    },
    {
      "name": "plain",
      "title": "Без рамки",
      "settings": {
        "label": "Договор № 12",
        "href": "#",
        "appearance": "plain"
      },
      "expect": {
