{
  "component": "sf-progress-bar",
  "probe": "sf-progress-bar against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
  "format": "stands/15-scenarios (A4 modal: a page, probes in steps); the runner is tests/browser/manifest-probes.browser.mjs",
  "page": {
    "lang": "ru",
    "body": [
      "<main>",
      "  <sf-progress-bar id=\"p1\" label=\"Загрузка файлов\" value=\"65\"></sf-progress-bar>",
      "  <sf-progress-bar id=\"p2\" aria-label=\"Копирование\" value=\"40\" status=\"success\"></sf-progress-bar>",
      "  <sf-progress-bar id=\"p-old\" label=\"Старое имя\" value=\"20\" tone=\"warning\"></sf-progress-bar>",
      "  <sf-progress-bar id=\"p6\" label=\"Диск\" value=\"83\" warning-at=\"80\" error-at=\"95\"></sf-progress-bar>",
      "  <sf-progress-bar id=\"p7\" label=\"Квота\" value=\"40\" status=\"error\" warning-at=\"80\"></sf-progress-bar>",
      "  <sf-progress-bar id=\"p8\" label=\"Подсчёт\" indeterminate value=\"30\" text-position=\"inline-end\"></sf-progress-bar>",
      "  <sf-progress-bar id=\"p9\" label=\"Копия\" value=\"35\" paused></sf-progress-bar>",
      "  <sf-progress-bar id=\"p10\" label=\"Квота\" value=\"40\" status=\"error\" paused></sf-progress-bar>",
      "</main>"
    ]
  },
  "probes": [
    {
      "id": "p1-role-and-value",
      "title": "the root is a progressbar named by label, its valuenow the value",
      "covers": "accessibility (role, name, valuenow), settings.value",
      "steps": [
        {
          "check": "(() => { const r = document.querySelector('#p1 .sf-progress-bar'); return r.getAttribute('role') === 'progressbar' && r.getAttribute('aria-label') === 'Загрузка файлов' && r.getAttribute('aria-valuenow') === '65' && r.getAttribute('aria-valuemin') === '0' && r.getAttribute('aria-valuemax') === '100' && !r.hasAttribute('tabindex'); })()",
          "expect": {
            "values": {
              "#p1.value": 65
            }
          }
        }
      ]
    },
    {
      "id": "p2-name-from-host",
      "title": "without label the host's aria-label names the progressbar (§3.1)",
      "covers": "accessibility.name",
      "steps": [
        {
          "check": "document.querySelector('#p2 .sf-progress-bar').getAttribute('aria-label') === 'Копирование'"
        }
      ]
    },
    {
      "id": "p3-value-number",
      "title": "value is a number; writing it moves valuenow",
      "covers": "settings.value (number)",
      "steps": [
        {
          "script": "(document.getElementById('p1').value = 30, true)",
          "wait": 300,
          "check": "document.querySelector('#p1 .sf-progress-bar').getAttribute('aria-valuenow') === '30' && document.getElementById('p1').getAttribute('value') === '30'",
          "expect": {
            "values": {
              "#p1.value": 30
            }
          }
        }
      ]
    },
    {
      "id": "p4-chunk",
      "title": "chunk {done, total} shows a part of a job in per cent",
      "covers": "actions.chunk (vocabulary §5.2)",
      "steps": [
        {
          "action": {
            "name": "chunk",
            "with": {
              "done": 30,
              "total": 120
            }
          },
          "target": "#p1",
          "expect": {
            "returns": {
              "outcome": "applied"
            },
            "values": {
              "#p1.value": 25
            }
          }
        },
        {
          "check": "document.querySelector('#p1 .sf-progress-bar').getAttribute('aria-valuenow') === '25'"
        },
        {
          "action": {
            "name": "chunk",
            "with": {
              "done": 1,
              "total": 0
            }
          },
          "target": "#p1",
          "expect": {
            "returns": {
              "outcome": "refused"
            },
            "values": {
              "#p1.value": 25
            }
          }
        }
      ]
    },
    {
      "id": "p5-aliases",
      "title": "tone and setProgress still answer, each use noted with its dates",
      "covers": "aliases.json",
      "steps": [
        {
          "check": "document.getElementById('p-old').getAttribute('status') === 'warning' && document.querySelector('#p-old .sf-progress-bar').className.includes('warning')"
        },
        {
          "script": "document.getElementById('p1').setProgress(80) && document.getElementById('p1').value",
          "expect": {
            "returns": 80,
            "journal": [
              {
                "from": "setProgress",
                "to": "chunk",
                "remove_after": "2026-12-01"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "p6-thresholds",
      "title": "warning-at and error-at turn the tone by themselves, the more serious of status and the threshold is drawn and said as data-status",
      "covers": "settings.warning-at, settings.error-at, host-states data-status",
      "steps": [
        {
          "check": "(() => { const a = document.querySelector('#p6'); const b = document.querySelector('#p7'); return a.getAttribute('data-status') === 'warning' && a.querySelector('.sf-progress-bar').classList.contains('sf-progress-bar--warning') && b.getAttribute('data-status') === 'error'; })()"
        },
        {
          "script": "(document.querySelector('#p6').value = 97, true)",
          "wait": 100,
          "check": "(() => { const a = document.querySelector('#p6'); return a.getAttribute('data-status') === 'error' && a.querySelector('.sf-progress-bar').dataset.tone === 'error'; })()"
        },
        {
          "script": "(document.querySelector('#p6').value = 30, true)",
          "wait": 100,
          "check": "(() => { const a = document.querySelector('#p6'); return a.getAttribute('data-status') === 'neutral' && !a.querySelector('.sf-progress-bar').classList.contains('sf-progress-bar--warning'); })()"
        }
      ]
    },
    {
      "id": "p8-indeterminate",
      "title": "indeterminate leaves the value unsaid: no aria-valuenow, no percentage text, the segment class; taken off, the same bar fills from the value (C34)",
      "covers": "settings.indeterminate",
      "steps": [
        {
          "check": "(() => { const r = document.querySelector('#p8 .sf-progress-bar'); return r.classList.contains('sf-progress-bar--indeterminate') && !r.hasAttribute('aria-valuenow') && r.getAttribute('role') === 'progressbar' && !r.querySelector('.sf-progress-bar-text'); })()"
        },
        {
          "script": "(() => { document.querySelector('#p8').indeterminate = false; return true; })()",
          "wait": 100,
          "check": "(() => { const r = document.querySelector('#p8 .sf-progress-bar'); return !r.classList.contains('sf-progress-bar--indeterminate') && r.getAttribute('aria-valuenow') === '30' && r.querySelector('.sf-progress-bar-text').textContent.trim() === '30%'; })()"
        }
      ]
    },
    {
      "id": "p9-paused",
      "title": "paused is at least a warning and is said in the value text; an error stays an error (C34)",
      "covers": "settings.paused, host-states data-status",
      "steps": [
        {
          "check": "(() => { const a = document.querySelector('#p9'); const r = a.querySelector('.sf-progress-bar'); const b = document.querySelector('#p10'); return a.getAttribute('data-status') === 'warning' && r.classList.contains('sf-progress-bar--warning') && r.getAttribute('aria-valuetext') === '35 %, на паузе' && b.getAttribute('data-status') === 'error'; })()"
        },
        {
          "script": "(() => { document.querySelector('#p9').paused = false; return true; })()",
          "wait": 100,
          "check": "(() => { const a = document.querySelector('#p9'); return a.getAttribute('data-status') === 'neutral' && !a.querySelector('.sf-progress-bar').hasAttribute('aria-valuetext'); })()"
        }
      ]
    }
  ]
}
