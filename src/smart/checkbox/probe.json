{
  "probe": "sf-checkbox against component.json (standard simai.smart-component 1.3.8 §12, §17, gate 20)",
  "page": {
    "lang": "ru",
    "markup": "<form id=\"f\">{{field}}<button type=\"submit\">OK</button></form>",
    "listen": [
      "input",
      "change"
    ],
    "box": "input[type=\"checkbox\"]"
  },
  "format": "stands/15-scenarios (A2 quantity); the runner is tests/browser/manifest-probes.browser.mjs",
  "checks": [
    {
      "id": "checked-without-value-submits-on",
      "covers": "form.submits, settings.value default (§17.1 item 2)",
      "field": "<sf-checkbox name=\"news\" checked label=\"Получать уведомления\"></sf-checkbox>",
      "form": "submit",
      "expect": {
        "submitted": true,
        "formData": {
          "news": "on"
        },
        "formNames": [
          "news"
        ],
        "innerNames": [
          null
        ],
        "listed": 1
      }
    },
    {
      "id": "unchecked-submits-nothing",
      "covers": "form.value",
      "field": "<sf-checkbox name=\"news\" value=\"yes\" label=\"Получать уведомления\"></sf-checkbox>",
      "form": "submit",
      "expect": {
        "submitted": true,
        "formData": {
          "news": null
        }
      }
    },
    {
      "id": "space-checks",
      "covers": "keyboard.host.Space toggle:checked, events.change (native)",
      "field": "<sf-checkbox name=\"news\" value=\"yes\" label=\"Получать уведомления\"></sf-checkbox>",
      "user": "keyboard:Space",
      "expect": {
        "events": [
          {
            "type": "input"
          },
          {
            "type": "change"
          }
        ],
        "host": {
          "attributes": {
            "checked": ""
          },
          "props": {
            "checked": true
          }
        },
        "formData": {
          "news": "yes"
        }
      }
    },
    {
      "id": "setting-checked-is-silent",
      "covers": "§8: a value set from outside sends nothing",
      "field": "<sf-checkbox name=\"news\" label=\"Получать уведомления\"></sf-checkbox>",
      "property": {
        "name": "checked",
        "value": true
      },
      "expect": {
        "events": [],
        "formData": {
          "news": "on"
        }
      }
    },
    {
      "id": "indeterminate-is-a-value",
      "covers": "values.indeterminate",
      "field": "<sf-checkbox name=\"all\" label=\"Все строки\"></sf-checkbox>",
      "setting": {
        "name": "indeterminate",
        "value": true
      },
      "expect": {
        "host": {
          "props": {
            "indeterminate": true
          }
        },
        "box": {
          "attributes": {}
        },
        "events": []
      }
    },
    {
      "id": "disabled-leaves-the-form",
      "covers": "form.disabled (§17.1 item 3)",
      "field": "<sf-checkbox name=\"news\" checked label=\"Получать уведомления\"></sf-checkbox>",
      "setting": {
        "name": "disabled",
        "value": true
      },
      "expect": {
        "formData": {
          "news": null
        },
        "disabled": {
          "input[type=\"checkbox\"]": true
        }
      }
    },
    {
      "id": "form-reset-returns-the-default",
      "covers": "form.reset (§17.1 item 4), no events",
      "field": "<sf-checkbox name=\"news\" checked label=\"Получать уведомления\"></sf-checkbox>",
      "given": [
        {
          "user": "keyboard:Space"
        }
      ],
      "form": "reset",
      "expect": {
        "events": [],
        "host": {
          "attributes": {
            "checked": ""
          }
        },
        "formData": {
          "news": "on"
        }
      }
    },
    {
      "id": "custom-validity-blocks-submit",
      "covers": "form.validity custom-error (§17.2)",
      "field": "<sf-checkbox name=\"terms\" label=\"Согласен с условиями\"></sf-checkbox>",
      "action": {
        "name": "set-custom-validity",
        "with": "Нужно согласие"
      },
      "expect": {
        "checkValidity": false,
        "validity": {
          "customError": true,
          "valid": false
        }
      }
    },
    {
      "id": "legacy-error-is-invalid",
      "covers": "aliases.json error -> invalid (§17.2, §16.20)",
      "field": "<sf-checkbox name=\"terms\" label=\"Согласен с условиями\"></sf-checkbox>",
      "setting": {
        "name": "error",
        "value": true
      },
      "expect": {
        "host": {
          "attributes": {
            "invalid": ""
          },
          "props": {
            "invalid": true
          }
        },
        "box": {
          "attributes": {
            "aria-invalid": "true"
          }
        },
        "journal": [
          {
            "from": "error",
            "to": "invalid",
            "kind": "setting",
            "since": "2026-10-27",
            "remove_after": "2026-12-01"
          }
        ]
      }
    },
    {
      "id": "aria-label-names-the-box",
      "covers": "accessibility.name from aria-label (§4.8)",
      "field": "<sf-checkbox name=\"row\" aria-label=\"Выбрать строку\"></sf-checkbox>",
      "form": "reset",
      "expect": {
        "box": {
          "attributes": {
            "aria-label": "Выбрать строку"
          }
        }
      }
    }
  ]
}
