        "text": "Дизайн",
        "closable": true,
        "close-label": "Удалить тег Дизайн"
      },
      "expect": {
        "kind": "default",
        "closable": true
      },
      "studio": {
        "props": {
          "type": "default",
          "text": "Дизайн",
          "closable": true,
          "close-label": "Удалить тег Дизайн"
        },
        "scenario": {}
      }
    },
    {
      "name": "checkbox",
      "title": "Выбранный фильтр",
      "settings": {
        "text": "Новые",
        "active": true
      },
      "expect": {
        "kind": "checkbox",
        "active": true
      }
    },
    {
      "name": "status",
      "title": "Статус",
      "settings": {
        "kind": "default",
        "status": "success",
        "text": "Оплачен"
      },
      "expect": {
        "status": "success"
      }
    },
    {
      "name": "icon",
      "title": "Со значком",
      "settings": {
        "kind": "icon",
        "icon": "sell",
        "text": "Акция"
      },
      "expect": {
