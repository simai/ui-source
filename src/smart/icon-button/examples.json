      },
      "attributes": {
        "aria-label": "Изменить"
      },
      "expect": {
        "appearance": "tonal"
      }
    },
    {
      "name": "outline",
      "title": "Контурная",
      "settings": {
        "icon": "share",
        "appearance": "outline"
      },
      "attributes": {
        "aria-label": "Поделиться"
      },
      "expect": {
        "appearance": "outline"
      }
    },
    {
      "name": "close",
      "title": "Закрыть",
      "settings": {
        "kind": "close",
        "appearance": "link",
