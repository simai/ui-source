      "title": "Настройки",
      "settings": {
        "icon": "settings"
      },
      "attributes": {
        "aria-label": "Настройки"
      },
      "expect": {
        "icon": "settings"
      }
    },
    {
      "name": "tonal",
      "title": "Тональная",
      "settings": {
        "icon": "edit",
