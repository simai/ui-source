      "settings": {
        "placeholder": "Найти страницу, компонент или действие"
      },
      "expect": {
        "placeholder": "Найти страницу, компонент или действие",
        "shortcut": "mod+k /",
        "scopes": true,
        "recent": true
      },
      "studio": {
        "title": "site search reference",
        "scenario": {
          "assertions": [
