  "ai_guidance": {
    "use_when": "Use sf-button-copy to copy an identifier, a key, a command or a code block, naming each button by what it copies.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not leave several icon-only copy buttons named only «Копировать»"
    ],
    "required_reads": [
