      },
      "expect": {
        "size": "1/2"
      }
    },
    {
      "name": "apply",
      "title": "Тема на части страницы",
      "markup": "<div class=\"site-main theme-light\">Содержимое</div>",
      "settings": {
        "value": "#6a1b9a",
        "apply": true,
        "target": ".site-main",
        "selector": ".site-main"
      },
      "expect": {
        "apply": true
      }
    }
