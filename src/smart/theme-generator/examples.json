      }
    },
    {
      "name": "framework",
      "title": "Цвет SIMAI Framework",
      "settings": {},
      "expect": {
        "value": ""
      }
    },
    {
      "name": "tuned",
      "title": "Свой тон и насыщенность",
      "settings": {
        "value": "#2e7d32",
        "hue": 200,
        "chroma": 60
      },
      "expect": {
        "hue": 200,
        "chroma": 60
      }
    },
    {
      "name": "swatches",
      "title": "Цвета продукта",
      "settings": {
        "swatches": "#2e7d32|Лес, #c62828|Кирпич, #6a1b9a|Слива",
