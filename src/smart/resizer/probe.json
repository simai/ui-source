{
  "component": "sf-resizer",
  "probe": "sf-resizer against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
  "format": "stands/15-scenarios (A4 modal: a page, probes in steps); the runner is tests/browser/manifest-probes.browser.mjs",
  "page": {
    "lang": "ru",
    "body": [
      "<style>#panel, #panel2 { inline-size: 300px; } #panel { block-size: 200px; } #panel2 { block-size: 100px; }</style>",
      "<main>",
      "  <nav id=\"panel\"><sf-resizer id=\"r1\" min=\"200\" max=\"400\" step=\"20\"></sf-resizer></nav>",
      "  <nav id=\"panel2\"><sf-resizer id=\"r2\" min=\"200\" max=\"400\" label=\"Ширина меню\" value=\"360\"></sf-resizer></nav>",
      "  <nav id=\"panel3\" aria-label=\"Разделы\" style=\"inline-size: 300px; block-size: 100px\"><sf-resizer id=\"r3\" min=\"200\" max=\"400\" collapsible label=\"Ширина меню\"></sf-resizer></nav>",
      "</main>"
    ]
  },
  "probes": [
    {
      "id": "p1-separator",
      "title": "a focusable separator named by the language file, its value the share of the way from min to max (0-100) with its words, controlling its panel",
      "covers": "accessibility (role, name, value, controls), settings.label default-from runtime.label",
      "steps": [
        {
          "check": "(() => { const r = document.getElementById('r1'); return r.getAttribute('role') === 'separator' && r.getAttribute('aria-label') === 'Изменить ширину' && r.tabIndex === 0 && r.getAttribute('aria-valuenow') === '50' && r.getAttribute('aria-valuemin') === '0' && r.getAttribute('aria-valuemax') === '100' && r.getAttribute('aria-valuetext') === '50\\u00a0%' && r.getAttribute('aria-controls') === 'panel'; })()",
          "wait": 300
        }
      ]
    },
    {
      "id": "p2-keys",
      "title": "ArrowRight steps, Home and End go to the limits; each key sends resize {width, phase: end} and the old sf-resize",
      "covers": "accessibility.keys (step:+1, to:min, to:max), events.resize",
      "steps": [
        {
          "script": "(document.getElementById('r1').focus(), true)"
        },
        {
          "user": "keyboard:ArrowRight",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "width": 320,
                  "phase": "end"
                }
              },
              {
                "name": "sf-resize",
                "count": 1,
                "detail": {
                  "width": 320
                }
              }
            ]
          }
        },
        {
          "user": "keyboard:Home",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "width": 200
                }
              }
            ]
          }
        },
        {
          "user": "keyboard:End",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "width": 400
                }
              }
            ]
          },
          "check": "document.getElementById('panel').style.inlineSize === '400px'"
        }
      ]
    },
    {
      "id": "p3-value",
      "title": "value is a number: the host's kept width is written within the limits",
      "covers": "settings.value (number, nullable)",
      "steps": [
        {
          "check": "document.getElementById('panel2').style.inlineSize === '360px' && document.getElementById('r2').value === 360 && document.getElementById('r2').getAttribute('aria-label') === 'Ширина меню'",
          "wait": 300
        },
        {
          "script": "(document.getElementById('r2').value = 900, document.getElementById('panel2').style.inlineSize)",
          "expect": {
            "returns": "400px"
          }
        }
      ]
    },
    {
      "id": "p4-reset",
      "title": "Enter reverts to the stylesheet's width: resize {phase: reset}",
      "covers": "accessibility.keys Enter (revert)",
      "steps": [
        {
          "script": "(document.getElementById('r1').focus(), true)"
        },
        {
          "user": "keyboard:Enter",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "phase": "reset",
                  "width": 300
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "p5-fold",
      "title": "collapsible: Enter folds the panel (resize width 0, value «Свёрнуто») and Enter gives the width back",
      "covers": "settings.collapsible, accessibility.keys Enter (toggle:folded)",
      "steps": [
        {
          "script": "(document.getElementById('r3').focus(), true)"
        },
        {
          "user": "keyboard:Enter",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "width": 0,
                  "phase": "end"
                }
              }
            ]
          },
          "check": "document.getElementById('panel3').hasAttribute('data-folded') && document.getElementById('r3').getAttribute('aria-valuetext') === 'Свёрнуто' && document.getElementById('r3').getAttribute('aria-valuenow') === '0'"
        },
        {
          "user": "keyboard:Enter",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "width": 300,
                  "phase": "end"
                }
              }
            ]
          },
          "check": "!document.getElementById('panel3').hasAttribute('data-folded') && Math.round(document.getElementById('panel3').getBoundingClientRect().width) === 300"
        }
      ]
    }
  ]
}
