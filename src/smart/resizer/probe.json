{
  "component": "sf-resizer",
  "probe": "sf-resizer against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
  "format": "stands/15-scenarios (A4 modal: a page, probes in steps); the runner is tests/browser/manifest-probes.browser.mjs",
  "page": {
    "lang": "ru",
    "body": [
      "<style>#panel, #panel2 { inline-size: 300px; } #panel { block-size: 200px; } #panel2 { block-size: 100px; }</style>",
      "<main>",
      "  <nav id=\"panel\"><sf-resizer id=\"r1\" min=\"200\" max=\"400\" step=\"20\"></sf-resizer></nav>",
      "  <nav id=\"panel2\"><sf-resizer id=\"r2\" min=\"200\" max=\"400\" label=\"Ширина меню\" value=\"360\"></sf-resizer></nav>",
      "</main>"
    ]
  },
  "probes": [
    {
      "id": "p1-separator",
      "title": "a focusable separator named by the language file, its value the width",
      "covers": "accessibility (role, name), settings.label default-from runtime.label",
      "steps": [
        {
          "check": "(() => { const r = document.getElementById('r1'); return r.getAttribute('role') === 'separator' && r.getAttribute('aria-label') === 'Изменить ширину' && r.tabIndex === 0 && r.getAttribute('aria-valuenow') === '300'; })()",
          "wait": 300
        }
      ]
    },
    {
      "id": "p2-keys",
      "title": "ArrowRight steps, Home and End go to the limits; each key sends resize {width, phase: end} and the old sf-resize",
      "covers": "accessibility.keys (step:+1, to:min, to:max), events.resize",
      "steps": [
        {
          "script": "(document.getElementById('r1').focus(), true)"
        },
        {
          "user": "keyboard:ArrowRight",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "width": 320,
                  "phase": "end"
                }
              },
              {
                "name": "sf-resize",
                "count": 1,
                "detail": {
                  "width": 320
                }
              }
            ]
          }
        },
        {
          "user": "keyboard:Home",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "width": 200
                }
              }
            ]
          }
        },
        {
          "user": "keyboard:End",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "width": 400
                }
              }
            ]
          },
          "check": "document.getElementById('panel').style.inlineSize === '400px'"
        }
      ]
    },
    {
      "id": "p3-value",
      "title": "value is a number: the host's kept width is written within the limits",
      "covers": "settings.value (number, nullable)",
      "steps": [
        {
          "check": "document.getElementById('panel2').style.inlineSize === '360px' && document.getElementById('r2').value === 360 && document.getElementById('r2').getAttribute('aria-label') === 'Ширина меню'",
          "wait": 300
        },
        {
          "script": "(document.getElementById('r2').value = 900, document.getElementById('panel2').style.inlineSize)",
          "expect": {
            "returns": "400px"
          }
        }
      ]
    },
    {
      "id": "p4-reset",
      "title": "Enter reverts to the stylesheet's width: resize {phase: reset}",
      "covers": "accessibility.keys Enter (revert)",
      "steps": [
        {
          "script": "(document.getElementById('r1').focus(), true)"
        },
        {
          "user": "keyboard:Enter",
          "expect": {
            "events": [
              {
                "name": "sf-resizer-resize",
                "count": 1,
                "detail": {
                  "phase": "reset",
                  "width": 300
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
