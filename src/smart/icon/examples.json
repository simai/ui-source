{
  "examples": [
    {
      "name": "reference",
      "title": "Дом, размер 1",
      "settings": {
        "icon": "home",
        "size": "1"
      },
      "expect": {
        "icon": "home",
        "size": "1"
      },
      "studio": {
        "scenario": {}
      }
    },
    {
      "name": "labelled",
      "title": "Значок с подписью",
      "settings": {
        "icon": "verified",
        "label": "Проверено"
      },
      "expect": {
        "label": "Проверено"
      }
    },
    {
      "name": "filled-rounded",
      "title": "Заливка, скруглённый",
      "settings": {
        "icon": "favorite",
        "filled": true,
        "type": "rounded"
      },
      "expect": {
        "filled": true,
        "type": "rounded"
      }
    },
    {
      "name": "weight",
      "title": "Жирный",
