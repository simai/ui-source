          },
          {
            "label": "Решение"
          }
        ],
        "current": 1
      },
      "expect": {
        "name": "Заявка",
        "values": {
          "current": 1
        }
      }
    },
    {
      "name": "count",
      "title": "Строка «Шаг N из M»",
      "settings": {
        "aria-label": "Регистрация организации",
        "layout": "count",
        "items": [
          {
            "label": "Организация"
          },
          {
            "label": "Руководитель"
          },
          {
            "label": "Документы"
          },
          {
            "label": "Проверка"
          }
        ],
        "current": 2
      },
      "expect": {
        "name": "Регистрация организации",
        "values": {
          "current": 2
        }
      }
    },
    {
      "name": "done",
      "title": "Всё пройдено",
      "settings": {
        "aria-label": "Публикация",
        "items": [
          {
            "label": "Черновик"
          },
          {
            "label": "Проверка"
          },
          {
            "label": "Публикация"
          }
        ],
        "current": 3
      },
      "expect": {
        "name": "Публикация",
        "values": {
          "current": 3
        }
      }
    },
    {
      "name": "compact",
      "title": "Половинный размер",
      "settings": {
        "aria-label": "Анкета",
        "size": "1/2",
        "items": [
          {
            "label": "Профиль"
          },
          {
            "label": "Контакты"
          },
          {
            "label": "Подтверждение"
          }
        ]
      },
      "expect": {
        "name": "Анкета"
      }
    }
  ],
  "pages": [
    {
      "name": "conformance",
      "title": "sf-steps against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main>",
          "  <div id=\"area\"><sf-steps id=\"st\" aria-label=\"Этапы публикации\" current=\"1\" navigation=\"free\" items='[{\"label\":\"Черновик\"},{\"label\":\"Проверка\"},{\"label\":\"Готово\"},{\"label\":\"Архив\",\"disabled\":true}]'></sf-steps></div>",
          "  <sf-steps id=\"st-pass\" current=\"2\" items='[{\"label\":\"Корзина\"},{\"label\":\"Доставка\"},{\"label\":\"Оплата\",\"state\":\"error\"}]'></sf-steps>",
          "  <sf-steps id=\"st-done\" aria-label=\"Публикация\" current=\"3\" items='[{\"label\":\"Черновик\"},{\"label\":\"Проверка\"},{\"label\":\"Публикация\"}]'></sf-steps>",
          "  <div id=\"narrow\"><sf-steps id=\"st-auto\" aria-label=\"Создание сайта\" current=\"2\" items='[{\"label\":\"Создание сайта\"},{\"label\":\"Установка WordPress\"},{\"label\":\"Настройка HTTPS\"},{\"label\":\"Проверка сайта\"}]'></sf-steps></div>",
          "  <sf-steps id=\"st-run\" size=\"1/2\" current=\"1\" items='[{\"label\":\"Копия\",\"state\":\"done\"},{\"label\":\"Файлы\",\"state\":\"running\"},{\"label\":\"База\"}]'></sf-steps>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-enter-moves",
          "title": "Tab reaches a step button, Enter moves there: sf-steps-change once, sf-step-change once, noted with its dates",
          "covers": "keyboard.host Tab reach, Enter select, navigation free, events.change, aliases sf-step-change",
          "steps": [
            {
              "script": "(document.querySelector('#st [data-step-index=\"0\"] button').focus(), true)",
              "wait": 60
            },
            {
              "user": "keyboard:Tab",
              "wait": 60,
              "check": "document.activeElement === document.querySelector('#st [data-step-index=\"2\"] button')"
            },
            {
              "user": "keyboard:Enter",
              "expect": {
                "events": [
                  {
                    "name": "sf-steps-change",
                    "count": 1,
                    "detail": {
                      "previous": 1,
                      "current": 2,
                      "item": {
                        "label": "Готово"
                      }
                    }
                  },
                  {
                    "name": "sf-step-change",
                    "count": 1,
                    "detail": {
                      "current": 2,
                      "component": "<sf-steps>",
                      "tagName": "sf-steps"
                    }
                  }
                ],
                "values": {
                  "#st.current": 2
                },
                "journal": [
                  {
                    "from": "sf-step-change",
                    "to": "sf-steps-change",
                    "since": "2026-10-27",
                    "remove_after": "2026-12-01"
                  }
                ]
              },
              "check": "!('component' in (window.__heard.find((one) => one.name === 'sf-steps-change')?.detail ?? {component: 1})) && document.querySelector('#st [aria-current=\"step\"]')?.dataset.stepIndex === '2'"
            }
          ]
        },
        {
          "id": "p2-space-moves",
          "title": "Space on a step button moves there too",
          "covers": "keyboard.host Space select",
          "steps": [
            {
              "script": "(document.querySelector('#st [data-step-index=\"0\"] button').focus(), true)",
              "wait": 60
            },
            {
              "user": "keyboard:Space",
              "expect": {
                "events": [
                  {
                    "name": "sf-steps-change",
                    "count": 1,
                    "detail": {
                      "previous": 1,
                      "current": 0
                    }
                  }
                ],
                "values": {
                  "#st.current": 0
                }
              }
            }
          ]
        },
        {
          "id": "p3-disabled-and-current",
          "title": "a disabled step and the current one are no buttons; go-to-step refuses a disabled step",
          "covers": "settings.items disabled, settings.navigation, actions.go-to-step",
          "steps": [
            {
              "check": "document.querySelector('#st [data-step-index=\"3\"] button') === null && document.querySelector('#st [data-step-index=\"1\"] button') === null && document.querySelectorAll('#st button.sf-step-control').length === 2"
            },
            {
              "action": {
                "name": "go-to-step",
                "with": 3
              },
              "target": "#st",
              "expect": {
                "returns": {
                  "outcome": "refused",
                  "reason": "disabled"
                },
                "values": {
                  "#st.current": 1
                }
              }
            }
          ]
        },
        {
          "id": "p4-action-is-silent",
          "title": "go-to-step applies and sends no change (§8)",
          "covers": "actions.go-to-step, §8",
          "steps": [
            {
              "action": {
                "name": "go-to-step",
                "with": {
                  "index": 2
                }
              },
              "target": "#st",
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "events": [
                  {
                    "name": "sf-steps-change",
                    "count": 0
                  }
                ],
                "values": {
                  "#st.current": 2
                }
              }
            }
          ]
        },
        {
          "id": "p5-passive-list",
          "title": "passive by default: an ordered list named by aria-label, else by the language file; no button; the current item says aria-current; each item its state word",
          "covers": "accessibility.role list, accessibility.name, settings.navigation, lang runtime, C101 (5)",
          "steps": [
            {
              "check": "document.querySelector('#st ol[role=\"list\"]').getAttribute('aria-label') === 'Этапы публикации' && document.querySelector('#st-pass ol[role=\"list\"]').getAttribute('aria-label') === 'Шаги' && document.querySelectorAll('#st-pass button').length === 0 && document.querySelector('#st-pass li[aria-current=\"step\"]') === null && document.querySelector('#st-pass [data-step-index=\"0\"] .sf-step-container').textContent === 'Корзина' && document.querySelector('#st-pass [data-step-index=\"0\"] .sr-only').textContent === ', Пройден' && document.querySelector('#st-pass [data-step-index=\"0\"] .sf-step-marker .sf-icon').textContent === 'check' && document.querySelector('#st-pass [data-step-index=\"2\"] .sr-only').textContent === ', Ошибка' && document.querySelectorAll('#st ol > li').length === 4 && document.querySelectorAll('#st ol > :not(li)').length === 0 && document.querySelector('#st ol > li:nth-child(2)').getAttribute('aria-current') === 'step' && document.querySelector('#st [role=\"group\"]') === null"
            },
            {
              "script": "(document.getElementById('st-pass').setAttribute('lang', 'en'), true)",
              "wait": 300,
              "check": "document.querySelector('#st-pass ol[role=\"list\"]').getAttribute('aria-label') === 'Steps' && document.querySelector('#st-pass [data-step-index=\"1\"] .sr-only').textContent === ', Completed'"
            }
          ]
        },
        {
          "id": "p6-list-property",
          "title": "items as a property draws the list",
          "covers": "settings.items (list)",
          "steps": [
            {
              "script": "(document.getElementById('st-pass').items = [{label: 'Один'}, {label: 'Два'}], true)",
              "wait": 200,
              "check": "document.querySelectorAll('#st-pass .sf-step').length === 2 && document.querySelector('#st-pass [data-step-index=\"1\"]').textContent.includes('Два')"
            }
          ]
        },
        {
          "id": "p7-public-variables",
          "title": "a public variable on an ancestor reaches the steps",
          "covers": "css-variables",
          "steps": [
            {
              "script": "(document.getElementById('area').style.setProperty('--sf-steps-current-border-color', 'rgb(1, 2, 3)'), document.getElementById('area').style.setProperty('--sf-steps-gap', '17px'), true)",
              "wait": 500,
              "check": "getComputedStyle(document.querySelector('#st .sf-step--state-current .sf-step-marker')).outlineColor === 'rgb(1, 2, 3)' && getComputedStyle(document.querySelector('#st .sf-steps-container')).columnGap === '17px'"
            }
          ]
        },
        {
          "id": "p8-auto-layout",
          "title": "layout auto: a row while it fits, a column when it does not, the count line under 20rem; no label breaks inside a word",
          "covers": "settings.layout, R185 ST-1, ST-2, C101 (4)",
          "steps": [
            {
              "script": "(document.getElementById('narrow').style.inlineSize = '60rem', true)",
              "wait": 300,
              "check": "document.querySelector('#st-auto .sf-steps').classList.contains('sf-steps--layout-row') && document.querySelector('#st-auto .sf-steps-container').scrollWidth <= document.querySelector('#st-auto .sf-steps-container').clientWidth + 1"
            },
            {
              "script": "(document.getElementById('narrow').style.inlineSize = '24rem', true)",
              "wait": 300,
              "check": "document.querySelector('#st-auto .sf-steps').classList.contains('sf-steps--layout-column') && [...document.querySelectorAll('#st-auto .sf-step-container')].every((label) => label.textContent.split(/\\s+/).every((word) => { const node = label.firstChild; const at = node.textContent.indexOf(word); const range = document.createRange(); range.setStart(node, at); range.setEnd(node, at + word.length); return range.getClientRects().length === 1; }))"
            },
            {
              "script": "(document.getElementById('narrow').style.inlineSize = '15rem', true)",
              "wait": 300,
              "check": "document.querySelector('#st-auto .sf-steps').classList.contains('sf-steps--layout-count') && getComputedStyle(document.querySelector('#st-auto .sf-steps-container')).display === 'none' && document.querySelector('#st-auto .sf-steps-count-line').textContent.replace(/\\s+/g, ' ').trim() === 'Шаг 3 из 4 · Настройка HTTPS' && document.querySelector('#st-auto sf-progress-bar') !== null"
            },
            {
              "script": "(document.getElementById('narrow').style.removeProperty('inline-size'), true)",
              "wait": 300,
              "check": "document.querySelector('#st-auto .sf-steps').classList.contains('sf-steps--layout-row') || document.querySelector('#st-auto .sf-steps').classList.contains('sf-steps--layout-column')"
            }
          ]
        },
        {
          "id": "p9-all-done",
          "title": "current equal to the number of steps: every step done, none current, every line the progress line",
          "covers": "values.current, C101 (6) ST-4",
          "steps": [
            {
              "check": "document.querySelector('#st-done [aria-current]') === null && document.querySelectorAll('#st-done .sf-step--state-done').length === 3 && document.querySelectorAll('#st-done .sf-step--passed').length === 3 && document.getElementById('st-done').current === 3"
            }
          ]
        },
        {
          "id": "p10-marker-is-the-text-line",
          "title": "the marker box is the rung's text line, at both sizes; the running spinner is the marker's size and centred in it",
          "covers": "C101 (3), (6) running",
          "steps": [
            {
              "check": "[...document.querySelectorAll('#st .sf-step, #st-run .sf-step')].every((step) => { const box = step.querySelector('.sf-step-marker').getBoundingClientRect(); const line = parseFloat(getComputedStyle(step).lineHeight); return Math.abs(box.width - line) < 0.5 && Math.abs(box.height - line) < 0.5; }) && (() => { const mark = document.querySelector('#st-run .sf-step--state-running .sf-step-marker').getBoundingClientRect(); const svg = document.querySelector('#st-run .sf-step--state-running svg').getBoundingClientRect(); return Math.abs(svg.width - mark.width) < 0.5 && Math.abs((svg.left + svg.width / 2) - (mark.left + mark.width / 2)) < 0.5 && Math.abs((svg.top + svg.height / 2) - (mark.top + mark.height / 2)) < 0.5; })()"
            }
          ]
        },
        {
          "id": "p11-old-forms",
          "title": "the old forms still draw and are noted with their dates: the string items, completed, error-step, separator-icon",
          "covers": "C101 (7), ST-12",
          "steps": [
            {
              "script": "(document.getElementById('area').insertAdjacentHTML('beforeend', '<sf-steps id=\"st-old\" current=\"2\" error-step=\"1\" separator-icon=\"chevron_right\" items=\"Корзина::completed|Доставка|Оплата\"></sf-steps>'), true)",
              "wait": 500,
              "expect": {
                "journal": [
                  {
                    "from": "label::flag|label",
                    "remove_after": "2027-01-01"
                  },
                  {
                    "from": "completed",
                    "to": "done",
                    "remove_after": "2027-01-01"
                  },
                  {
                    "from": "error-step",
                    "remove_after": "2027-01-01"
                  },
                  {
                    "from": "separator-icon",
                    "remove_after": "2027-01-01"
                  }
                ]
              },
              "check": "document.querySelector('#st-old [data-step-index=\"0\"]').classList.contains('sf-step--state-done') && document.querySelector('#st-old [data-step-index=\"1\"]').classList.contains('sf-step--state-error') && document.querySelector('#st-old .sf-steps-separator') === null"
            }
          ]
        }
      ]
    }
  ]
}
