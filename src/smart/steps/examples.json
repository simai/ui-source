{
  "examples": [
    {
      "name": "reference",
      "title": "Оформление заказа: можно вернуться к пройденным",
      "settings": {
        "aria-label": "Оформление заказа",
        "navigation": "visited",
        "items": [
          {
            "label": "Корзина"
          },
          {
            "label": "Доставка"
          },
          {
            "label": "Оплата"
          },
          {
            "label": "Подтверждение"
          }
        ],
        "current": 2
      },
      "expect": {
        "name": "Оформление заказа",
        "values": {
          "current": 2
        }
      },
      "from": "studio.fixture.json",
      "studio": {
        "props": {
          "aria-label": "Оформление заказа",
          "current": 2,
          "navigation": "visited",
          "items": [
            {
              "label": "Корзина"
            },
            {
              "label": "Доставка"
            },
            {
              "label": "Оплата"
            },
            {
              "label": "Подтверждение"
            }
          ]
        },
        "scenario": {
          "steps": [
            {
              "invoke": "goToStep",
              "with": [
                3
              ]
            }
          ],
          "assertions": [
            "upgraded",
            {
              "type": "attribute",
              "name": "current",
              "value": "3"
            },
            "no-console-error",
            "no-network"
          ]
        }
      }
    },
    {
      "name": "move",
      "title": "Переход к шагу действием",
      "settings": {
        "items": [
          {
            "label": "Черновик"
          },
          {
            "label": "Проверка"
          },
          {
            "label": "Публикация"
          }
        ],
        "current": 1
      },
      "script": [
        {
          "act": "go-to-step",
          "with": {
            "index": 2
          }
        }
      ],
      "expect": {
        "name": "Шаги",
        "values": {
          "current": 2
        },
        "events": []
      },
      "from": "studio.scenario.json"
    },
    {
      "name": "order",
      "title": "Статус заказа: столбец с датами",
      "settings": {
        "aria-label": "Статус заказа",
        "layout": "column",
        "items": [
          {
            "label": "Заказ принят",
            "text": "12 ноября, 10:14"
          },
          {
            "label": "Собран на складе",
            "text": "12 ноября, 15:40"
          },
          {
            "label": "Передан в службу доставки",
            "text": "ожидается 13 ноября"
          },
          {
            "label": "Получен"
          }
        ],
        "current": 2
      },
      "expect": {
        "name": "Статус заказа",
        "values": {
          "current": 2
        }
      }
    },
    {
      "name": "install",
      "title": "Установка: строка, пока помещается",
      "settings": {
        "aria-label": "Установка сайта",
        "items": [
          {
            "label": "Проверка сервера"
          },
          {
            "label": "База данных"
          },
          {
            "label": "Администратор",
            "text": "Почта и пароль первого администратора"
          },
          {
            "label": "Модули",
            "text": "необязательно"
          },
          {
            "label": "Готово"
          }
        ],
        "current": 2
      },
      "expect": {
        "name": "Установка сайта",
        "values": {
          "current": 2
        }
      }
    },
    {
      "name": "states",
      "title": "Все состояния: пройден, пропущен, выполняется, ошибка, впереди",
      "settings": {
        "aria-label": "Перенос сайта",
        "layout": "column",
        "items": [
          {
            "label": "Резервная копия",
            "state": "done",
            "text": "2 мин"
          },
          {
            "label": "Почта",
            "state": "skipped",
            "text": "пропущено: почты на сайте нет"
          },
          {
            "label": "Файлы сайта",
            "state": "running",
            "text": "1 240 из 3 800 файлов"
          },
          {
            "label": "База данных",
            "state": "error",
            "text": "нет места на диске: нужно 2 ГБ"
          },
          {
            "label": "DNS"
          }
        ],
        "current": 2
      },
      "expect": {
        "name": "Перенос сайта",
        "values": {
          "current": 2
        }
      }
    },
    {
      "name": "dots",
      "title": "Точки: пассивный статус в плотной карточке",
      "settings": {
