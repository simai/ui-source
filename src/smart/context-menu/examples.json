        "entries": [
          {
            "id": "block",
            "text": "Блок",
            "submenu": [
              {
                "id": "text",
                "text": "Текст"
              },
              {
                "id": "image",
                "text": "Изображение"
              }
            ],
            "search": {
              "placeholder": "Найти"
            }
          }
        ]
      },
      "expect": {
