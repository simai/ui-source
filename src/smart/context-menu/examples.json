        "entries": [
          {
            "id": "edit",
            "text": "Изменить",
            "icon": "edit"
          },
          {
            "id": "copy",
            "text": "Копировать"
          },
          {
            "id": "delete",
            "text": "Удалить",
            "danger": true
          }
        ]
      },
      "expect": {
        "name": "Действия"
      },
      "from": "studio.fixture.json",
      "studio": {
        "props": {
          "position": "bottom-start",
          "aria-label": "Действия"
        },
        "children": [
          {
            "element": "sf-button",
            "props": {
              "slot": "content",
              "type": "link",
              "scheme": "on-surface",
              "text": "Открыть"
            },
            "text": "",
            "children": []
          },
          {
            "element": "sf-button",
            "props": {
              "slot": "content",
              "type": "link",
              "scheme": "on-surface",
              "text": "Удалить"
            },
            "text": "",
            "children": []
          }
        ],
        "scenario": {}
      }
    },
    {
      "name": "opened",
      "title": "Открыто у кнопки",
      "settings": {
        "aria-label": "Действия",
        "entries": [
          {
            "id": "edit",
            "text": "Изменить"
          }
        ]
      },
      "script": [
        {
          "act": "open-for",
          "with": {
            "anchor": "#trigger"
          }
        }
      ],
      "expect": {
        "events": [
          "open",
          "opened"
        ]
      },
      "from": "studio.scenario.json"
    },
    {
      "name": "checks",
      "title": "Флажки",
      "settings": {
        "aria-label": "Колонки",
        "entries": [
          {
            "id": "name",
            "text": "Название",
            "kind": "check",
            "checked": true,
            "keepOpen": true
          },
          {
            "id": "date",
            "text": "Дата",
            "kind": "check",
            "keepOpen": true
          }
        ]
      },
      "expect": {
        "name": "Колонки"
      }
    },
    {
      "name": "submenu",
      "title": "Подменю с поиском",
      "settings": {
