{
  "probe": "sf-range-slider against component.json (standard simai.smart-component 1.3.8 §4.2, §4.8 keys, §5.3, §8, §16.20)",
  "component": "sf-slider-range",
  "page": {
    "lang": "ru",
    "markup": "<form id=\"f\">{{field}}<button type=\"submit\">OK</button></form>",
    "listen": [
      "change",
      "sf-range-slider-change",
      "onSliderChange"
    ]
  },
  "format": "ui-source tests/browser/manifest-probes.browser.mjs (stand 15 format: given, one trigger, expect)",
  "checks": [
    {
      "id": "arrow-right-steps-and-the-old-names-follow",
      "covers": "keyboard.host ArrowRight step:+1; events.change once, then sf-range-slider-change and onSliderChange with one detail and a dated journal entry",
      "field": "<sf-slider-range aria-label=\"Громкость\" min=\"0\" max=\"100\" step=\"10\" value=\"50\"></sf-slider-range>",
      "given": [
        {
          "user": "focus:[role=slider]"
        }
      ],
      "user": "keyboard:ArrowRight",
      "expect": {
        "value": "60",
        "events": [
          {
            "type": "change",
            "value": 60,
            "values": [
              60
            ],
            "handleCount": 1,
            "handle": 0
          },
          {
            "type": "sf-range-slider-change",
            "value": 60,
            "values": [
              60
            ],
            "handleCount": 1
          },
          {
            "type": "onSliderChange",
            "value": 60,
            "handleCount": 1
          }
        ],
        "deprecations": [
          {
            "component": "sf-slider-range",
            "kind": "event",
            "from": "sf-range-slider-change",
            "to": "change",
            "since": "2026-10-27",
            "remove_after": "2026-12-01"
          },
          {
            "component": "sf-slider-range",
            "kind": "event",
            "from": "onSliderChange",
            "to": "change",
            "since": "2026-10-27",
            "remove_after": "2026-12-01"
          }
        ]
      }
    },
    {
      "id": "arrow-left-steps-down",
      "covers": "keyboard.host ArrowLeft step:-1",
      "field": "<sf-slider-range aria-label=\"Громкость\" min=\"0\" max=\"100\" step=\"10\" value=\"50\"></sf-slider-range>",
      "given": [
        {
          "user": "focus:[role=slider]"
        }
      ],
      "user": "keyboard:ArrowLeft",
      "expect": {
        "value": "40",
        "events": [
          {
            "type": "change",
            "value": 40
          },
          {
            "type": "sf-range-slider-change"
          },
          {
            "type": "onSliderChange"
          }
        ]
      }
    },
    {
      "id": "arrow-up-and-down",
      "covers": "keyboard.host ArrowUp step:+1, ArrowDown step:-1",
      "field": "<sf-slider-range aria-label=\"Громкость\" min=\"0\" max=\"100\" step=\"10\" value=\"50\"></sf-slider-range>",
      "given": [
        {
          "user": "focus:[role=slider]"
        }
      ],
      "user": [
        "keyboard:ArrowUp",
        "keyboard:ArrowUp",
        "keyboard:ArrowDown"
      ],
      "expect": {
        "value": "60"
      }
    },
    {
      "id": "home-and-end",
      "covers": "keyboard.host Home to:min, End to:max",
      "field": "<sf-slider-range aria-label=\"Громкость\" min=\"10\" max=\"90\" value=\"50\"></sf-slider-range>",
      "given": [
        {
          "user": [
            "focus:[role=slider]",
            "keyboard:End"
          ]
        }
      ],
      "user": "keyboard:Home",
      "expect": {
        "value": "10",
        "evaluate": {
          "el.querySelector('[role=slider]').getAttribute('aria-valuenow')": "10"
        }
      }
    },
    {
      "id": "end-goes-to-max",
      "covers": "keyboard.host End to:max",
      "field": "<sf-slider-range aria-label=\"Громкость\" min=\"10\" max=\"90\" value=\"50\"></sf-slider-range>",
      "given": [
        {
          "user": "focus:[role=slider]"
        }
      ],
      "user": "keyboard:End",
      "expect": {
        "value": "90"
      }
    },
    {
      "id": "page-keys-move-ten-steps",
      "covers": "keyboard.host PageUp step:+page, PageDown step:-page; Shift+ArrowRight moves the same large step (S4)",
      "field": "<sf-slider-range aria-label=\"Цена\" min=\"0\" max=\"50000\" step=\"500\" value=\"5000\"></sf-slider-range>",
      "given": [
        {
          "user": "focus:[role=slider]"
        }
      ],
      "user": [
        "keyboard:PageUp",
        "keyboard:PageUp",
        "keyboard:PageDown",
        "keyboard:Shift+ArrowRight"
      ],
      "expect": {
        "value": "15000",
        "evaluate": {
          "el.querySelector('[role=slider]').getAttribute('aria-valuenow')": "15000"
        }
      }
    },
    {
      "id": "readonly-keys-change-nothing",
      "covers": "settings.readonly (C80 R2): the handle stays focusable and carries aria-readonly; ArrowRight changes nothing and sends no change",
      "field": "<sf-slider-range aria-label=\"Громкость\" min=\"0\" max=\"100\" value=\"40\" readonly></sf-slider-range>",
      "given": [
        {
          "user": "focus:[role=slider]"
        }
      ],
      "user": "keyboard:ArrowRight",
      "expect": {
        "value": "40",
        "events": [],
        "evaluate": {
          "el.querySelector('[role=slider]').getAttribute('aria-readonly')": "true"
        }
      }
    },
    {
      "id": "field-enter-moves-the-handle",
      "covers": "settings.field (C80): typing a number in the from/to field and Enter moves its handle; one change",
      "field": "<sf-slider-range label=\"Цена\" name=\"price\" min=\"0\" max=\"50000\" step=\"500\" value=\"5000,20000\" suffix=\" ₽\" field></sf-slider-range>",
      "given": [
        {
          "user": "focus:.sf-range-slider-field-input[data-handle='1']"
        }
      ],
      "user": [
        "type:12500",
        "keyboard:Enter"
      ],
      "expect": {
        "value": "5000,12500",
        "events": [
          {
            "type": "change",
            "value": [
              5000,
              12500
            ],
            "handle": 1
          }
        ],
        "evaluate": {
          "el.querySelectorAll('[role=slider]')[1].getAttribute('aria-valuenow')": "12500"
        }
      }
    },
    {
      "id": "range-submits-two-entries",
      "covers": "form (S3): a range with a name submits two entries under it",
      "field": "<sf-slider-range label=\"Цена\" name=\"price\" min=\"0\" max=\"50000\" step=\"500\" value=\"5000,20000\"></sf-slider-range>",
      "expect": {
        "evaluate": {
          "JSON.stringify([...new FormData(document.getElementById('f'))])": "[[\"price\",\"5000\"],[\"price\",\"20000\"]]"
        }
      }
    },
    {
      "id": "value-from-code-is-silent",
      "covers": "§8: a value set from outside is not reported back, under no name",
      "field": "<sf-slider-range aria-label=\"Громкость\" value=\"50\"></sf-slider-range>",
      "property": {
        "name": "value",
        "value": "30"
      },
      "expect": {
        "value": "30",
        "events": []
      }
    },
    {
      "id": "prefix-is-prefix-text",
      "covers": "aliases.json setting prefix -> prefix-text (§3.1, §16 item 26)",
      "field": "<sf-slider-range aria-label=\"Цена\" value=\"50\" label=\"text\"></sf-slider-range>",
      "setting": {
        "name": "prefix",
        "value": "от "
      },
      "expect": {
        "host": {
          "attributes": {
            "prefix-text": "от "
          },
          "properties": {
            "prefixText": "от "
          }
        },
        "evaluate": {
          "el.querySelector('.sf-range-slider').dataset.prefix": "от "
        },
        "deprecations": [
          {
            "component": "sf-slider-range",
            "from": "prefix",
            "to": "prefix-text",
            "since": "2026-10-27",
            "remove_after": "2026-12-01"
          }
        ]
      }
    },
    {
      "id": "disabled-is-drawn-by-the-template",
      "covers": "§5.3: the disabled look follows the setting through the template",
      "field": "<sf-slider-range aria-label=\"Громкость\" value=\"50\"></sf-slider-range>",
      "setting": {
        "name": "disabled",
        "value": true
      },
      "expect": {
        "evaluate": {
          "el.querySelector('.sf-range-slider').classList.contains('disabled')": true,
          "el.querySelector('[role=slider]').getAttribute('aria-disabled')": "true"
        }
      }
    },
    {
      "id": "settings-are-typed",
      "covers": "settings.min, max (number), step (number, nullable), a range value",
      "field": "<sf-slider-range aria-label=\"Цена\" min=\"5\" max=\"95\" value=\"20,80\"></sf-slider-range>",
      "script": "return [el.min, el.max, el.step, el.multiple, el.value];",
      "expect": {
        "returns": [
          5,
          95,
          null,
          true,
          "20,80"
        ]
      }
    }
  ]
}
