{
  "schema_version": 2,
  "id": "smart.slider-range",
  "version": "1.4.0",
  "title": "Range Slider",
  "summary": "A slider for one number or a range of two on a track: drag, click or keys move a handle by step, the fill shows the chosen part, and the value can be shown as text or a tooltip on each handle.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "slider-range"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-slider-range",
  "templates": [
    "default"
  ],
