          "none",
          "text",
          "tooltip"
        ]
      },
      "size": {
        "type": "string",
        "default": "1",
        "description": "Size of the step, as every form field: the slider row is the control height (32 / 40 / 48, phone 28 / 36 / 44), the handle 20 / 24 / 28 (S5).",
        "enum": [
          "1/2",
          "1",
          "2"
        ]
      },
      "prefix-text": {
        "type": "string",
        "default": ""
      },
      "suffix": {
        "type": "string",
        "default": ""
      },
      "lower-label": {
        "type": "string",
        "default": ""
      },
      "upper-label": {
        "type": "string",
        "default": ""
      },
      "precision": {
        "type": "integer",
        "description": "Digits after the decimal mark in the value shown and read out; empty takes them from `step` (0.5 has one), as sf-input-quantity. Formerly `decimals`, an alias until 2027-01-01.",
        "minimum": 0,
        "maximum": 20
      },
      "grouping": {
        "type": "boolean",
        "default": true,
        "description": "Group thousands the page's language's way («20 000»); `grouping=\"false\"` writes the digits together, for a year or a code."
      },
      "locale": {
        "type": "string",
        "default": "",
        "description": "The language the value is written in; unset, the page's (`lang`), so a Russian page reads «2,5 кг»."
      },
      "tooltip-position": {
        "type": "string",
        "default": "",
        "description": "Where the value bubble stands while a handle is dragged: top (default) or bottom."
      },
      "text-position": {
        "type": "string",
        "default": "",
        "description": "No effect since 1.4.0: value-display=\"text\" writes the value at the end of the name line. Kept so old markup stays valid."
      },
      "label-position": {
        "type": "string",
        "default": ""
