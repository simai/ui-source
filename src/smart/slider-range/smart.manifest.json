      "label": {
        "type": "string",
        "default": "",
        "description": "The visible name above the slider, as every field's label (owner decision C78); it names the handles unless aria-label, aria-labelledby or lower-label/upper-label do. Until 2027-01-01 the words none, text and tooltip here still mean value-display."
      },
      "value-display": {
        "type": "string",
        "default": "none",
        "description": "How the value is shown: not at all (each handle still reads it out), as text at the end of the name line, or in a bubble over the handle while it is dragged or keyboard-focused (C78). Formerly label, read until 2027-01-01.",
