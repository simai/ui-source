        ]
      },
      "expect": {
        "size": "1/2",
        "inline": false,
        "resettable": true
      },
      "studio": {
        "title": "settings menu reader",
        "scenario": {
          "assertions": [
            "upgraded",
            "no-console-error",
            "no-network"
          ]
        }
      }
    },
