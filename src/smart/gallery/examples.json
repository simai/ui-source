  "pages": [
    {
      "name": "conformance",
      "title": "sf-gallery against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main style=\"inline-size: 40rem\">",
          "  <sf-gallery id=\"g1\" heading=\"Фотографии\">",
          "    <img src=\"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22360%22%3E%3Crect width=%22100%25%22 height=%22100%25%22 fill=%22%233b82f6%22/%3E%3C/svg%3E\" width=\"640\" height=\"360\" alt=\"Синий\">",
          "    <img src=\"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22360%22%3E%3Crect width=%22100%25%22 height=%22100%25%22 fill=%22%2310b981%22/%3E%3C/svg%3E\" width=\"640\" height=\"360\" alt=\"Зелёный\">",
          "    <img src=\"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22360%22%3E%3Crect width=%22100%25%22 height=%22100%25%22 fill=%22%23f59e0b%22/%3E%3C/svg%3E\" width=\"640\" height=\"360\" alt=\"Жёлтый\">",
          "  </sf-gallery>",
          "  <sf-gallery id=\"g-old\" title=\"Старое имя\" blur thumbs=\"false\">",
          "    <img src=\"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22360%22%3E%3Crect width=%22100%25%22 height=%22100%25%22 fill=%22%233b82f6%22/%3E%3C/svg%3E\" width=\"640\" height=\"360\" alt=\"Синий\">",
          "  </sf-gallery>",
          "  <sf-gallery id=\"g-sel\" selection=\"many\" tile-size=\"s\">",
          "    <img src=\"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22360%22%3E%3Crect width=%22100%25%22 height=%22100%25%22 fill=%22%233b82f6%22/%3E%3C/svg%3E\" width=\"640\" height=\"360\" alt=\"Синий\">",
          "    <img src=\"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22360%22%3E%3Crect width=%22100%25%22 height=%22100%25%22 fill=%22%2310b981%22/%3E%3C/svg%3E\" width=\"640\" height=\"360\" alt=\"Зелёный\">",
          "    <img src=\"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22360%22%3E%3Crect width=%22100%25%22 height=%22100%25%22 fill=%22%23f59e0b%22/%3E%3C/svg%3E\" width=\"640\" height=\"360\" alt=\"Жёлтый\">",
          "  </sf-gallery>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-go-to",
          "title": "go-to shows a slide and sends change {previous, current, total, from: api}; the old sf-change follows",
          "covers": "actions.go-to, events.change, values.current",
          "steps": [
            {
              "check": "document.querySelectorAll('#g1 .sf-figure-grid > .sf-figure--tile').length === 3",
              "wait": 900
            },
            {
              "action": {
                "name": "go-to",
                "with": {
                  "index": 3
                }
              },
              "target": "#g1",
              "wait": 700,
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "values": {
                  "#g1.current": 3
                },
                "events": [
                  {
                    "name": "change",
                    "count": 1,
                    "detail": {
                      "previous": 1,
                      "current": 3,
                      "total": 3,
                      "from": "api"
                    }
                  },
                  {
                    "name": "sf-change",
                    "count": 1,
                    "detail": {
                      "current": 3
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p2-next-prev",
          "title": "next and prev move by one and answer applied",
          "covers": "actions.next, actions.prev",
          "steps": [
            {
              "action": {
                "name": "next"
              },
              "target": "#g1",
              "wait": 900,
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "values": {
                  "#g1.current": 2
                }
              }
            },
            {
              "action": {
                "name": "prev"
              },
              "target": "#g1",
              "wait": 700,
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "values": {
                  "#g1.current": 1
                }
              }
            }
          ]
        },
        {
          "id": "p3-lightbox",
          "title": "open at an index opens the full-screen viewer named by heading and sends opened; close sends closed",
          "covers": "actions.open, actions.close, events.opened, events.closed, values.open",
          "steps": [
            {
              "action": {
                "name": "open",
                "with": {
                  "index": 2
                }
              },
              "target": "#g1",
              "wait": 1200,
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "values": {
                  "#g1.current": 2
                },
                "events": [
                  {
                    "name": "sf-gallery-opened",
                    "count": 1,
                    "detail": {
                      "current": 2,
                      "total": 3
                    }
                  }
                ]
              }
            },
            {
              "check": "document.getElementById('g1').hasAttribute('open') && document.querySelector('dialog[data-sf-gallery-viewer]').open && document.querySelector('dialog[data-sf-gallery-viewer]').getAttribute('aria-label') === 'Фотографии' && document.querySelector('.sf-gallery-viewer-count').textContent.trim() === '2 / 3'"
            },
            {
              "action": {
                "name": "close"
              },
              "target": "#g1",
              "wait": 1200,
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "events": [
                  {
                    "name": "sf-gallery-closed",
                    "count": 1,
                    "detail": {
                      "current": 2
                    }
                  }
                ]
              }
            },
            {
              "action": {
                "name": "close"
              },
              "target": "#g1",
              "expect": {
                "returns": {
                  "outcome": "refused",
                  "reason": "closed"
                }
              }
            }
          ]
        },
        {
          "id": "p4-select",
          "title": "selection many: a check box chooses, select {selected, count, total} goes out, the bar says «Выбрано 1»; clear-selection empties it",
          "covers": "settings.selection, values.selected, events.select, actions.clear-selection",
          "steps": [
            {
              "check": "document.querySelectorAll('#g-sel [data-sf-gallery-pick]').length === 3",
              "wait": 900
            },
            {
              "script": "new Promise((done) => { const g = document.getElementById('g-sel'); let heard = null; g.addEventListener('sf-gallery-select', (e) => { heard = e.detail; }, {once: true}); g.querySelector('[data-sf-gallery-pick=\"2\"]').click(); setTimeout(() => done(JSON.stringify([heard, g.selected, g.querySelector('.sf-gallery-bar-count').textContent.trim()])), 300); })",
              "expect": {
                "returns": "[{\"selected\":[2],\"count\":1,\"total\":3},[2],\"Выбрано 1\"]"
              }
            },
            {
              "action": {
                "name": "clear-selection"
              },
              "target": "#g-sel",
              "wait": 300,
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "values": {
                  "#g-sel.selected": []
                }
              }
            }
          ]
        },
        {
          "id": "p5-aliases",
          "title": "title and blur answer as heading and backdrop-blur; getModal is kept, answers null and is noted",
          "covers": "aliases.json",
          "steps": [
            {
              "check": "(() => { const g = document.getElementById('g-old'); return g.getAttribute('heading') === 'Старое имя' && g.hasAttribute('backdrop-blur') && g.querySelector('.sf-figure-grid').getAttribute('aria-label') === 'Старое имя'; })()",
              "wait": 600
            },
            {
              "script": "document.getElementById('g-old').getModal() === null",
              "expect": {
                "returns": true,
                "journal": [
                  {
                    "from": "getModal",
                    "remove_after": "2026-12-01"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
