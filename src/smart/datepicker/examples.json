{
  "examples": [
    {
      "name": "reference",
      "title": "Дата публикации",
      "settings": {
        "value": "2026-09-03",
        "locale": "ru",
        "label": "Дата публикации"
      },
      "expect": {
        "values": {
          "value": "2026-09-03",
          "open": false
        }
      },
      "studio": {
        "title": "Выбор даты",
        "summary": "Одиночная дата в подписанном поле с открытым календарём.",
        "props": {
          "value": "2026-09-03",
          "locale": "ru",
          "label": "Дата публикации",
          "open": true
        },
        "state": "open",
        "scenario": {
          "id": "keyboard-selection"
        }
      }
    },
    {
      "name": "range",
      "title": "Период",
      "settings": {
        "range": true,
        "label": "Период",
        "start-value": "2026-09-01",
        "end-value": "2026-09-07"
      },
      "expect": {
        "values": {
          "value": [
            "2026-09-01",
            "2026-09-07"
          ]
        },
        "form": "2026-09-01/2026-09-07"
      }
    },
    {
      "name": "presets",
      "title": "Быстрый выбор",
      "settings": {
        "range": true,
        "label": "Период",
        "presets": "today,last-7-days,this-month"
      },
      "expect": {
        "values": {
          "open": false
        }
      }
    },
    {
      "name": "inline",
      "title": "Календарь без поля",
      "settings": {
        "input": false,
        "value": "2026-09-03"
      },
      "expect": {
        "role": "group"
      },
      "first-paint": {
        "max-bytes": 16384,
        "why": "inline mode draws the calendar open on the page: the month grid of six weeks is the first paint"
      }
    },
    {
      "name": "required",
      "title": "Обязательная дата",
      "settings": {
        "label": "Срок",
        "name": "due",
        "required": true
      },
      "expect": {
        "validity": {
          "valueMissing": true
        }
      }
    },
    {
      "name": "hint",
      "title": "С подсказкой",
      "settings": {
        "label": "Дата публикации",
        "value": "2026-09-03",
        "locale": "ru",
        "hint": "Дата публикации, её можно изменить позже.",
        "hint-icon": "help"
      },
      "expect": {
        "values": {
          "value": "2026-09-03"
        }
      }
    },
    {
      "name": "bounds",
      "title": "С границами",
      "settings": {
        "label": "Дата",
        "min-date": "2026-09-01",
        "max-date": "2026-09-30",
        "value": "2026-09-15"
      },
      "expect": {
        "values": {
          "value": "2026-09-15"
        }
      }
    }
  ],
  "pages": [
    {
      "name": "conformance",
      "x-probe": {
        "probe": "sf-datepicker against component.json (standard simai.smart-component 1.3.8 §4.4, §4.8 keys, §7.1.1, §8, §16.20, §17.1, §17.2)",
        "component": "sf-datepicker",
        "page": {
          "lang": "ru",
          "markup": "<form id=\"f\">{{field}}<button type=\"submit\">OK</button></form>",
          "listen": [
            "change",
            "sf-datepicker-change",
            "sf-change"
          ]
        },
        "format": "ui-source tests/browser/manifest-probes.browser.mjs (stand 15 format: given, one trigger, expect)",
        "checks": [
          {
            "id": "a-chosen-day-changes-once-and-the-old-names-follow",
            "covers": "events.change once, then sf-datepicker-change and sf-change with one detail and dated journal entries; the form gets the ISO date",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              }
            ],
            "user": "click:.sf-datepicker-day[data-date='2026-09-10']",
            "expect": {
              "value": "2026-09-10",
              "events": [
                {
                  "type": "change",
                  "value": "2026-09-10",
                  "isoValue": "2026-09-10",
                  "range": false
                },
                {
                  "type": "sf-datepicker-change",
                  "value": "2026-09-10"
                },
                {
                  "type": "sf-change",
                  "value": "2026-09-10"
                }
              ],
              "deprecations": [
                {
                  "component": "sf-datepicker",
                  "kind": "event",
                  "from": "sf-datepicker-change",
                  "to": "change",
                  "since": "2026-10-27",
                  "remove_after": "2026-12-01"
                },
                {
                  "component": "sf-datepicker",
                  "kind": "event",
                  "from": "sf-change",
                  "to": "change",
                  "since": "2026-10-27",
                  "remove_after": "2026-12-01"
                }
              ],
              "formData": {
                "d": "2026-09-10"
              },
              "evaluate": {
                "el.querySelector('sf-input').hasAttribute('name')": false,
                "el.querySelector('input').name": "",
                "[...form.elements].includes(el)": true
              }
            }
          },
          {
            "id": "the-form-gets-the-iso-date",
            "covers": "§17.1 item 2: the form format never depends on the display format or the language",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "form": "submit",
            "expect": {
              "submitted": true,
              "formData": {
                "d": "2026-09-03"
              },
              "evaluate": {
                "el.querySelector('input').value": "03.09.2026"
              }
            }
          },
          {
            "id": "a-range-submits-an-interval",
            "covers": "form.submits in range mode: start/end",
            "field": "<sf-datepicker name=\"p\" label=\"Период\" range start-value=\"2026-09-01\" end-value=\"2026-09-07\"></sf-datepicker>",
            "form": "submit",
            "expect": {
              "submitted": true,
              "formData": {
                "p": "2026-09-01/2026-09-07"
              },
              "value": [
                "2026-09-01",
                "2026-09-07"
              ]
            }
          },
          {
            "id": "required-blocks-submit",
            "covers": "form.required, validity value-missing (§17.2)",
            "field": "<sf-datepicker name=\"due\" label=\"Срок\" required></sf-datepicker>",
            "form": "submit",
            "expect": {
              "submitted": false,
              "checkValidity": false,
              "validity": {
                "host": {
                  "valueMissing": true,
                  "valid": false
                }
              },
              "evaluate": {
                "el.validationMessage": "Выберите дату."
              }
            }
          },
          {
            "id": "nothing-while-disabled",
            "covers": "form.disabled (§17.1 item 3); open-panel refused {reason: disabled}",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" disabled></sf-datepicker>",
            "script": "const outcome = el.openPanel(); form.requestSubmit(); return outcome;",
            "expect": {
              "returns": {
                "outcome": "refused",
                "reason": "disabled"
              },
              "formData": {
                "d": null
              }
            }
          },
          {
            "id": "form-reset-returns-the-default",
            "covers": "form.reset (§17.1 item 4): no events",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              },
              {
                "user": "click:.sf-datepicker-day[data-date='2026-09-12']"
              }
            ],
            "form": "reset",
            "wait": 300,
            "expect": {
              "events": [],
              "value": "2026-09-03",
              "formData": {
                "d": "2026-09-03"
              }
            }
          },
          {
            "id": "value-from-code-is-silent",
            "covers": "§8: a value set from outside is not reported back",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "property": {
              "name": "value",
              "value": "2026-01-02"
            },
            "wait": 300,
            "expect": {
              "value": "2026-01-02",
              "events": [],
              "formData": {
                "d": "2026-01-02"
              }
            }
          },
          {
            "id": "custom-error-blocks-submit",
            "covers": "validity custom-error (§17.2)",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "script": "el.setCustomValidity('Дата занята'); form.requestSubmit();",
            "expect": {
              "submitted": false,
              "validity": {
                "host": {
                  "customError": true
                }
              }
            }
          },
          {
            "id": "shift-tab-reaches-the-field",
            "covers": "keyboard.host Shift+Tab reach (and Tab)",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "script": "form.querySelector(\"button[type=submit]\").focus();"
              }
            ],
            "user": "keyboard:Shift+Tab",
            "expect": {
              "evaluate": {
                "el.contains(document.activeElement)": true
              }
            }
          },
          {
            "id": "arrow-down-opens-escape-closes",
            "covers": "keyboard.host ArrowDown open, Escape close",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "user": [
                  "focus:input",
                  "keyboard:ArrowDown"
                ],
                "wait": 300
              }
            ],
            "user": "keyboard:Escape",
            "wait": 300,
            "expect": {
              "host": {
                "properties": {
                  "open": false
                }
              },
              "evaluate": {
                "document.activeElement === el.querySelector('input')": true
              }
            }
          },
          {
            "id": "arrow-down-opens-the-calendar",
            "covers": "keyboard.host ArrowDown open",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "user": "focus:input"
              }
            ],
            "user": "keyboard:ArrowDown",
            "wait": 300,
            "expect": {
              "host": {
                "properties": {
                  "open": true
                }
              },
              "evaluate": {
                "el.querySelector('[role=dialog]') !== null": true
              }
            }
          },
          {
            "id": "arrows-move-by-day-and-week",
            "covers": "keyboard.panel ArrowRight focus:next, ArrowDown step:+7, ArrowLeft focus:prev, ArrowUp step:-7",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              }
            ],
            "user": [
              "keyboard:ArrowRight",
              "keyboard:ArrowDown",
              "keyboard:ArrowDown",
              "keyboard:ArrowLeft",
              "keyboard:ArrowUp"
            ],
            "wait": 300,
            "expect": {
              "evaluate": {
                "document.activeElement.dataset.date": "2026-09-10"
              }
            }
          },
          {
            "id": "home-and-end-reach-the-week-ends",
            "covers": "keyboard.panel End focus:last, Home focus:first (the week)",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              },
              {
                "user": "keyboard:End",
                "wait": 300
              }
            ],
            "user": "keyboard:Home",
            "wait": 300,
            "expect": {
              "evaluate": {
                "document.activeElement.dataset.date": "2026-08-31"
              }
            }
          },
          {
            "id": "page-keys-move-a-month",
            "covers": "keyboard.panel PageDown step:+page, PageUp step:-page",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              },
              {
                "user": "keyboard:PageDown",
                "wait": 300
              }
            ],
            "user": [
              "keyboard:PageDown",
              "keyboard:PageUp"
            ],
            "wait": 300,
            "expect": {
              "evaluate": {
                "document.activeElement.dataset.date": "2026-10-03"
              }
            }
          },
          {
            "id": "enter-chooses-the-focused-day",
            "covers": "keyboard.panel Enter select",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              },
              {
                "user": "keyboard:ArrowRight",
                "wait": 300
              }
            ],
            "user": "keyboard:Enter",
            "wait": 300,
            "expect": {
              "value": "2026-09-04",
              "events": [
                {
                  "type": "change",
                  "value": "2026-09-04"
                },
                {
                  "type": "sf-datepicker-change"
                },
                {
                  "type": "sf-change"
                }
              ]
            }
          },
          {
            "id": "space-chooses-the-focused-day",
            "covers": "keyboard.panel Space select; Escape in the panel closes it",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              },
              {
                "user": "keyboard:ArrowLeft",
                "wait": 300
              }
            ],
            "user": "keyboard:Space",
            "wait": 300,
            "expect": {
              "value": "2026-09-02"
            }
          },
          {
            "id": "escape-in-the-panel-closes-it",
            "covers": "keyboard.panel Escape close",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              }
            ],
            "user": "keyboard:Escape",
            "wait": 300,
            "expect": {
              "host": {
                "properties": {
                  "open": false
                }
              }
            }
          },
          {
            "id": "open-panel-answers-an-outcome",
            "covers": "actions.open-panel applied, close-panel then unchanged (§4.4)",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\"></sf-datepicker>",
            "script": "const opened = el.openPanel(); const closed = el.closePanel(); const again = el.closePanel(); return [opened.outcome, closed.outcome, again.outcome, again.reason];",
            "expect": {
              "returns": [
                "applied",
                "applied",
                "refused",
                "unchanged"
              ]
            }
          },
          {
            "id": "the-panel-id-comes-from-the-instance-path",
            "covers": "§7.1.1: no counter in the ids the template writes",
            "field": "<sf-datepicker id=\"due\" name=\"d\" label=\"Дата\" value=\"2026-09-03\"></sf-datepicker>",
            "given": [
              {
                "action": {
                  "name": "open-panel",
                  "with": {
                    "options": {
                      "focusCalendar": true
                    }
                  }
                },
                "wait": 300
              }
            ],
            "script": "return [el.querySelector('.sf-datepicker').id, el.querySelector('input').getAttribute('aria-controls')];",
            "expect": {
              "returns": [
                "page-due--panel",
                "page-due--panel"
              ]
            }
          },
          {
            "id": "disabled-reaches-the-inline-panel",
            "covers": "settings.disabled: the inline panel's days, arrows and month and year toggles are disabled, and the grid paths choose nothing (1.1.5)",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" input=\"false\" disabled locale=\"ru\"></sf-datepicker>",
            "given": [
              {
                "wait": 300
              }
            ],
            "script": "const day = el.days.find((one) => one.value === '2026-09-10'); el.selectDate(day); el.shiftMonth(1); el.shiftYearPage(1); el.toggleContext('year'); return [...el.querySelectorAll('.sf-datepicker button')].filter((button) => !button.disabled).map((button) => button.className || button.textContent.trim());",
            "wait": 300,
            "expect": {
              "returns": [],
              "value": "2026-09-03",
              "events": [],
              "formData": {
                "d": null
              },
              "disabled": {
                ".sf-datepicker-day[data-date='2026-09-10']": true
              },
              "evaluate": {
                "el.querySelectorAll('.sf-datepicker button').length": 46,
                "el.month": 8,
                "el.contextMode": "",
                "el.querySelector('.sf-datepicker').getAttribute('aria-disabled')": "true"
              }
            }
          },
          {
            "id": "disabled-reaches-a-panel-held-open",
            "covers": "settings.disabled: a panel the host opens with the open attribute takes no click on a day (1.1.5)",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" locale=\"ru\" disabled open></sf-datepicker>",
            "given": [
              {
                "wait": 300
              }
            ],
            "script": "el.querySelector(\".sf-datepicker-day[data-date='2026-09-10']\").click(); return [...el.querySelectorAll('.sf-datepicker button')].filter((button) => !button.disabled).map((button) => button.className || button.textContent.trim());",
            "wait": 300,
            "expect": {
              "returns": [],
              "value": "2026-09-03",
              "events": [],
              "evaluate": {
                "el.querySelectorAll('.sf-datepicker-day').length": 42
              }
            }
          },
          {
            "id": "disabled-refuses-the-quick-ranges",
            "covers": "settings.disabled: choose-preset and choose-custom-range refuse {reason: disabled}; every quick range and «Свой период» are disabled (1.1.5)",
            "field": "<sf-datepicker name=\"p\" label=\"Период\" range input=\"false\" disabled presets=\"today,last-7-days\" start-value=\"2026-09-01\" end-value=\"2026-09-07\"></sf-datepicker>",
            "given": [
              {
                "wait": 300
              }
            ],
            "script": "const preset = el.choosePreset({item: el.presetItems[0]}); const custom = el.chooseCustomRange(); return [preset, custom, [...el.querySelectorAll('.sf-datepicker-preset')].filter((button) => !button.disabled).length, el.querySelectorAll('.sf-datepicker-preset').length];",
            "wait": 300,
            "expect": {
              "returns": [
                {
                  "outcome": "refused",
                  "reason": "disabled"
                },
                {
                  "outcome": "refused",
                  "reason": "disabled"
                },
                0,
                3
              ],
              "value": [
                "2026-09-01",
                "2026-09-07"
              ],
              "events": []
            }
          },
          {
            "id": "value-takes-a-string-or-a-pair",
            "covers": "values.value: an ISO string, [start, end] in range mode; the legacy object {start, end} is still read as the pair (1.1.5)",
            "field": "<sf-datepicker name=\"p\" label=\"Период\" range></sf-datepicker>",
            "script": "el.value = ['2026-09-01', '2026-09-07']; const pair = el.value; el.value = {start: '2026-10-01', end: '2026-10-05'}; const legacy = el.value; return [pair, legacy];",
            "wait": 300,
            "expect": {
              "returns": [
                [
                  "2026-09-01",
                  "2026-09-07"
                ],
                [
                  "2026-10-01",
                  "2026-10-05"
                ]
              ],
              "events": [],
              "formData": {
                "p": "2026-10-01/2026-10-05"
              }
            }
          },
          {
            "id": "the-hint-and-its-marker-reach-the-field",
            "covers": "settings.hint, settings.hint-icon forwarded to the inner sf-input (field parity, 1.2.0): the text under the field, read to the native input as its description, and the marker at the field's end; an error-message takes the hint's place while the field is invalid and the hint comes back when it is removed",
            "field": "<sf-datepicker name=\"d\" label=\"Дата\" value=\"2026-09-03\" hint=\"Дата публикации, её можно изменить позже.\" hint-icon=\"help\"></sf-datepicker>",
            "script": "const frame = () => new Promise((done) => requestAnimationFrame(() => requestAnimationFrame(done))); const read = () => { const box = el.querySelector('input'); const message = el.querySelector('.sf-input-hint-text-wrap'); const described = String(box?.getAttribute('aria-describedby') || '').split(/\\s+/); return {text: message?.textContent ?? null, kind: message?.dataset.fieldMessage ?? null, described: Boolean(message && described.includes(message.id)), icon: el.querySelector('.sf-input-hint sf-icon')?.getAttribute('icon') ?? null}; }; const hint = read(); el.setAttribute('error-message', 'Выберите дату.'); el.setAttribute('invalid', ''); await frame(); const error = read(); el.removeAttribute('invalid'); await frame(); return [hint, error, read()];",
            "wait": 300,
            "expect": {
              "returns": [
                {
                  "text": "Дата публикации, её можно изменить позже.",
                  "kind": "hint",
                  "described": true,
                  "icon": "help"
                },
                {
                  "text": "Выберите дату.",
                  "kind": "error",
                  "described": true,
                  "icon": "help"
                },
                {
                  "text": "Дата публикации, её можно изменить позже.",
                  "kind": "hint",
                  "described": true,
                  "icon": "help"
                }
              ],
              "events": []
            }
          }
        ]
      }
    }
  ]
}
