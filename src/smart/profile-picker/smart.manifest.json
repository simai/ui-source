{
  "schema_version": 2,
  "id": "smart.profile-picker",
  "version": "1.1.12",
  "title": "Profile picker",
  "summary": "One way to choose, make, rename, remove and reset a profile: a field-like button naming the profile in use, and a panel where every act happens inline. The profiles and the rights are the host's; the component says what was asked.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "profiles",
    "views",
    "picker"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "responsive"
  ],
  "custom_element": "sf-profile-picker",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.button",
      "smart.icon"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "label": {
        "type": "string",
        "description": "What a profile is called here («Профиль», «Вид»); the page language's «Profile» when empty."
      },
      "size": {
        "type": "string",
        "default": "1/2",
        "enum": [
          "1/2",
          "1"
        ]
      },
      "resettable": {
        "type": "boolean",
        "default": false,
        "description": "Offers «Сбросить к стандартному» at the foot."
      },
      "message": {
        "type": "string",
        "default": "",
        "description": "Why the host refused the last act, shown in the panel."
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "current": {
        "type": "string",
        "default": "",
        "description": "The id of the profile in use."
      },
      "profiles": {
        "type": "array",
        "description": "The profiles the host offers, [{id, label, shared, builtin, editable}]: builtin is the standard one, never renamed or removed; editable false may be chosen but not changed. The picker never changes its own list."
      },
      "rights": {
        "type": "object",
        "description": "What this person may create, {create: {personal, shared}}; with neither, no new profile is offered. Reset is the resettable setting."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "profiles": {
      "type": "array",
      "description": "Set as a property: [{id, label, shared, builtin, editable}]. editable false is chosen but not changed; builtin is never renamed or removed."
    },
    "rights": {
      "type": "object",
      "description": "Set as a property: {create: {personal, shared}} -- what this person may make."
    }
  },
  "methods": {
    "open": {
      "summary": "The action open.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "close": {
      "summary": "The action close.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    },
    "toggle": {
      "summary": "The action toggle.",
      "arguments": [],
      "returns": {
        "type": "object"
      }
    }
  },
  "events": {
    "sf-profile-picker-select": {
      "summary": "select (vocabulary).",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ids": {
            "type": "array"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-profile-picker-create": {
      "summary": "create (vocabulary).",
      "payload": {
        "type": "object",
        "required": [
          "label",
          "shared",
          "from",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "shared": {
            "type": "boolean"
          },
          "from": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "personal",
              "shared"
            ]
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-profile-picker-rename": {
      "summary": "rename (vocabulary).",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "label",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-profile-picker-delete": {
      "summary": "delete (vocabulary).",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ids": {
            "type": "array"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-profile-picker-reset": {
      "summary": "reset (vocabulary).",
      "payload": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-profile-select": {
      "summary": "The person chose a profile. It carries the same detail as sf-profile-picker-select.",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ids": {
            "type": "array"
          }
        }
      },
      "alias_of": "sf-profile-picker-select"
    },
    "sf-profile-create": {
      "summary": "The person asked for a new profile, a copy of the current one. It carries the same detail as sf-profile-picker-create.",
      "payload": {
        "type": "object",
        "required": [
          "label",
          "shared",
          "from",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "shared": {
            "type": "boolean"
          },
          "from": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "personal",
              "shared"
            ]
          }
        }
      },
      "alias_of": "sf-profile-picker-create"
    },
    "sf-profile-rename": {
      "summary": "The person renamed a profile. It carries the same detail as sf-profile-picker-rename.",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "label",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "alias_of": "sf-profile-picker-rename"
    },
    "sf-profile-delete": {
      "summary": "The person confirmed removing a profile. It carries the same detail as sf-profile-picker-delete.",
      "payload": {
        "type": "object",
        "required": [
          "id",
          "ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ids": {
            "type": "array"
          }
        }
      },
      "alias_of": "sf-profile-picker-delete"
    },
    "sf-profile-reset": {
      "summary": "The person asked for the current profile back as the standard one. It carries the same detail as sf-profile-picker-reset.",
      "payload": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "alias_of": "sf-profile-picker-reset"
    }
  },
  "state": {
    "machines": {
      "panel": [
        "closed",
        "open",
        "creating",
        "renaming",
        "confirming"
      ]
    },
    "visual_states": [
      "default",
      "open",
      "disabled"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "saving the width on a server"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "menu",
    "accessible_name": "recommended",
    "keyboard": [
      "ArrowUp",
      "ArrowDown",
      "Home",
      "End",
      "Enter",
      "Space",
      "F2",
      "Delete",
      "Escape"
    ],
    "focus": "The trigger is a button with aria-haspopup=menu; the panel's rows are menuitemradio, the current one checked. Arrows, Home and End move between rows, Enter chooses, F2 renames, Delete asks to remove, Escape closes the form and then the panel, returning focus to the trigger."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "ltr",
      "rtl",
      "reduced-motion"
    ],
    "skeleton": {
      "shape": "block",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "runnable",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke",
      "keyboard",
      "responsive",
      "a11y"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": []
  },
  "provenance": {
