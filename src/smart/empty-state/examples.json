{
  "examples": [
    {
      "name": "reference",
      "title": "Ничего не найдено",
      "settings": {
        "kind": "nothing-found",
        "size": "1",
        "heading-level": 3
      },
      "expect": {
        "name": "Ничего не найдено",
        "role": "status"
      },
      "from": "studio.fixture.json",
      "studio": {
        "title": "empty state reference",
        "props": {
          "kind": "nothing-found",
          "size": "1",
          "heading-level": "3"
        },
        "scenario": {
          "assertions": [
            "upgraded",
            "no-console-error",
            "no-network"
          ]
        }
      }
    },
    {
      "name": "no-data",
      "title": "Записей пока нет",
      "settings": {
        "kind": "no-data"
      },
      "expect": {
        "name": "Записей пока нет",
        "role": null
      }
    },
    {
      "name": "error-retry",
      "title": "Ошибка с повтором",
      "settings": {
        "kind": "error"
      },
      "script": [
        {
          "press": "[data-action=\"retry\"]"
        }
      ],
      "expect": {
        "events": [
          {
            "action": {
              "id": "retry"
            }
          }
        ]
      }
    },
    {
      "name": "inline",
      "title": "В строку",
      "settings": {
        "kind": "nothing-found",
        "layout": "inline",
        "size": "1/2"
      },
      "expect": {
        "heading": null
      }
    },
    {
      "name": "actions",
      "title": "Свои действия",
      "settings": {
        "kind": "no-data",
        "heading": "Нет проектов",
        "actions": [
          {
            "id": "create",
            "text": "Создать проект"
          }
        ]
      },
      "expect": {
        "name": "Нет проектов"
      }
    },
    {
      "name": "processing",
      "title": "Готовится",
      "settings": {
        "kind": "processing",
        "heading": "Расшифровка готовится",
        "text": "Обычно это занимает несколько минут. Пришлём письмо, когда она будет готова — страницу можно закрыть."
      },
      "expect": {
        "name": "Расшифровка готовится",
        "role": "status"
      }
    },
    {
      "name": "processing-share",
      "title": "Готовится, доля известна",
      "settings": {
        "kind": "processing",
        "value": 40,
        "heading": "Расшифровка готовится",
        "text": "Пришлём письмо, когда она будет готова — страницу можно закрыть."
      },
      "expect": {
        "name": "Расшифровка готовится",
        "role": "status"
      }
    },
    {
      "name": "first-use",
      "title": "Первый раз",
      "settings": {
        "kind": "first-use",
        "icon": "widgets",
        "heading": "Добавьте первый блок",
        "text": "Заголовок, текст, кнопка, товары — в Библиотеке."
      },
      "expect": {
        "name": "Добавьте первый блок",
        "role": null
      }
    },
    {
      "name": "offline",
      "title": "Нет связи",
      "settings": {
        "kind": "offline"
      },
      "script": [
        {
          "press": "[data-action=\"retry\"]"
        }
      ],
      "expect": {
        "name": "Нет связи",
        "role": "status",
        "events": [
          {
            "action": {
              "id": "retry"
            }
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "conformance",
      "title": "sf-empty-state against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main>",
          "  <sf-empty-state id=\"e1\" kind=\"nothing-found\" heading-level=\"2\"></sf-empty-state>",
          "  <sf-empty-state id=\"e2\" kind=\"error\"></sf-empty-state>",
          "  <sf-empty-state id=\"e3\" kind=\"no-data\" heading=\"Нет проектов\"></sf-empty-state>",
          "  <sf-empty-state id=\"e4\" kind=\"error\" live=\"alert\"></sf-empty-state>",
          "  <sf-empty-state id=\"e-old\" title=\"Старое имя\"></sf-empty-state>",
          "  <sf-empty-state id=\"e5\" kind=\"processing\" heading=\"Расшифровка готовится\"></sf-empty-state>",
          "  <sf-empty-state id=\"e6\" kind=\"first-use\" icon=\"widgets\"></sf-empty-state>",
          "  <sf-empty-state id=\"e7\" kind=\"offline\"></sf-empty-state>",
          "  <sf-empty-state id=\"e8\" kind=\"processing\" size=\"2\" value=\"40\" heading=\"Расшифровка готовится\"></sf-empty-state>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-status-and-heading",
          "title": "nothing-found is a polite status with a real heading at heading-level",
          "covers": "accessibility (role when), settings.heading-level",
          "steps": [
            {
              "check": "(() => { const r = document.querySelector('#e1 .sf-empty-state'); const h = r.querySelector('h2.sf-empty-state-title'); return r.getAttribute('role') === 'status' && h && h.textContent.trim() === 'Ничего не найдено'; })()",
              "expect": {
                "values": {
                  "#e1.headingLevel": 2
                }
              }
            }
          ]
        },
        {
          "id": "p2-no-role",
          "title": "no-data says nothing; live alert makes an alert",
          "covers": "accessibility (otherwise none, live alert)",
          "steps": [
            {
              "check": "!document.querySelector('#e3 .sf-empty-state').hasAttribute('role') && document.querySelector('#e4 .sf-empty-state').getAttribute('role') === 'alert' && document.querySelector('#e3 .sf-empty-state-title').textContent.trim() === 'Нет проектов'"
            }
          ]
        },
        {
          "id": "p3-retry",
          "title": "an error offers «Повторить»; pressing it sends action {id: retry}",
          "covers": "events.action (own verb)",
          "steps": [
            {
              "user": "click:#e2 .sf-empty-state-actions button",
              "expect": {
                "events": [
                  {
                    "name": "sf-empty-state-action",
                    "count": 1,
                    "detail": {
                      "id": "retry"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p4-actions-list",
          "title": "actions is a list setting: each entry draws a button",
          "covers": "settings.actions",
          "steps": [
            {
              "script": "(document.getElementById('e3').actions = [{id: 'create', text: 'Создать проект'}], true)",
              "wait": 400,
              "check": "Boolean(document.querySelector('#e3 .sf-empty-state-actions')?.textContent.includes('Создать проект'))"
            },
            {
              "user": "click:#e3 .sf-empty-state-actions button",
              "expect": {
                "events": [
                  {
                    "name": "sf-empty-state-action",
                    "count": 1,
                    "detail": {
                      "id": "create"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p5-alias",
          "title": "title answers as heading, noted with its dates",
          "covers": "aliases.json",
          "steps": [
            {
              "check": "document.getElementById('e-old').getAttribute('heading') === 'Старое имя' && document.querySelector('#e-old .sf-empty-state-title').textContent.trim() === 'Старое имя'"
            }
          ]
        },
        {
          "id": "p6-processing",
          "title": "processing: a spinner in the soft neutral circle, no glyph, a polite status with the heading and the promise, no action",
          "covers": "settings.kind processing, accessibility (role when)",
          "steps": [
            {
              "wait": 400,
              "check": "(() => { const r = document.querySelector('#e5 .sf-empty-state'); const c = r.querySelector('.sf-featured-icon.sf-featured-icon--neutral.sf-featured-icon--soft'); return r.getAttribute('role') === 'status' && c && c.querySelector('sf-spinner') && !c.querySelector('.sf-icon') && r.querySelector('.sf-empty-state-title').textContent.trim() === 'Расшифровка готовится' && r.querySelector('.sf-empty-state-text').textContent.trim().length > 0 && !r.querySelector('.sf-empty-state-actions'); })()"
            }
          ]
        },
        {
          "id": "p7-first-use",
          "title": "first-use: the section's icon in the primary role and a primary «Создать» sending action {id: create}",
          "covers": "settings.kind first-use, settings.icon, events.action",
          "steps": [
            {
              "check": "(() => { const r = document.querySelector('#e6 .sf-empty-state'); const c = r.querySelector('.sf-featured-icon'); return c.classList.contains('sf-featured-icon--primary') && c.textContent.trim() === 'widgets' && !r.hasAttribute('role') && r.querySelector('.sf-empty-state-actions sf-button').getAttribute('scheme') === 'primary'; })()"
            },
            {
              "user": "click:#e6 .sf-empty-state-actions button",
              "expect": {
                "events": [
                  {
                    "name": "sf-empty-state-action",
                    "count": 1,
                    "detail": {
                      "id": "create"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p8-offline",
          "title": "offline: cloud_off in the warning role, a polite status, «Повторить»; the window's online event sends action {id: retry, auto: true}",
          "covers": "settings.kind offline, events.action (auto)",
          "steps": [
            {
              "check": "(() => { const r = document.querySelector('#e7 .sf-empty-state'); const c = r.querySelector('.sf-featured-icon'); return c.classList.contains('sf-featured-icon--warning') && c.textContent.trim() === 'cloud_off' && r.getAttribute('role') === 'status'; })()"
            },
            {
              "script": "(window.dispatchEvent(new Event('online')), true)",
              "expect": {
                "events": [
                  {
                    "name": "sf-empty-state-action",
                    "count": 1,
                    "detail": {
                      "id": "retry",
                      "auto": true
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p9-processing-share",
          "title": "processing with value: an sf-progress-ring of the circle's size step (3 at size 2) is the circle, its box the circle's, the percentage in it, a progressbar named «Готово» with the share; a new value moves the ring only",
          "covers": "settings.value, accessibility (processing ring)",
          "steps": [
            {
              "wait": 400,
              "check": "(() => { const r = document.querySelector('#e8 .sf-empty-state'); const c = r.querySelector('.sf-featured-icon.sf-featured-icon--neutral.sf-featured-icon--soft.sf-empty-state-icon--ring'); const ring = c && c.querySelector('sf-progress-ring'); const box = ring && ring.querySelector('.sf-progress-ring'); const bar = box && box.querySelector('.sf-progress-ring-indicator'); if (!bar) return false; const a = c.getBoundingClientRect(); const b = box.getBoundingClientRect(); return r.getAttribute('role') === 'status' && !c.hasAttribute('aria-hidden') && ring.getAttribute('size') === '3' && !c.querySelector('sf-spinner') && Math.abs(a.width - b.width) < 0.5 && Math.abs(a.height - b.height) < 0.5 && bar.getAttribute('role') === 'progressbar' && bar.getAttribute('aria-label') === 'Готово' && bar.getAttribute('aria-valuenow') === '40' && box.querySelector('.sf-progress-ring-content').textContent.trim() === '40%'; })()"
            },
            {
              "script": "(document.getElementById('e8').value = 72.4, true)",
              "wait": 400,
              "check": "document.querySelector('#e8 .sf-progress-ring-indicator').getAttribute('aria-valuenow') === '72' && document.querySelector('#e8 .sf-empty-state-title').textContent.trim() === 'Расшифровка готовится'"
            },
            {
              "script": "(document.getElementById('e8').value = null, true)",
              "wait": 400,
              "check": "!!document.querySelector('#e8 sf-spinner') && !document.querySelector('#e8 sf-progress-ring')"
            }
          ]
        }
      ]
    }
  ]
}
