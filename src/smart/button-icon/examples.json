{
  "examples": [
    {
      "name": "reference",
      "title": "Настройки",
      "settings": {
        "icon": "settings"
      },
      "attributes": {
        "aria-label": "Настройки"
      },
      "expect": {
        "icon": "settings"
      },
      "studio": {
        "scenario": {
          "steps": [
            {
              "invoke": "setDisabled",
              "with": [
                true
              ]
            }
          ],
          "assertions": [
            "upgraded",
            "no-console-error",
            "no-network"
          ]
        }
      }
    },
    {
      "name": "tonal",
      "title": "Тональная",
      "settings": {
        "icon": "edit",
        "appearance": "tonal",
        "scheme": "on-surface"
      },
      "attributes": {
        "aria-label": "Изменить"
      },
      "expect": {
        "appearance": "tonal"
      }
    },
    {
      "name": "outline",
      "title": "Контурная",
      "settings": {
        "icon": "share",
        "appearance": "outline"
      },
      "attributes": {
        "aria-label": "Поделиться"
      },
      "expect": {
        "appearance": "outline"
      }
    },
    {
      "name": "quiet",
      "title": "Тихая кнопка-значок",
      "settings": {
        "icon": "share",
        "appearance": "ghost",
        "scheme": "on-surface-variant"
      },
      "attributes": {
        "aria-label": "Поделиться"
      },
      "expect": {
        "scheme": "on-surface-variant",
        "appearance": "ghost"
      }
    },
    {
      "name": "close",
      "title": "Закрыть",
      "settings": {
        "kind": "close",
        "appearance": "ghost",
        "scheme": "on-surface"
      },
      "attributes": {
        "aria-label": "Закрыть"
      },
      "expect": {
        "kind": "close"
      }
    },
    {
      "name": "danger",
      "title": "Удалить",
      "settings": {
        "icon": "delete",
        "status": "danger"
      },
      "attributes": {
        "aria-label": "Удалить"
      },
      "expect": {
        "status": "danger"
      }
    },
    {
      "name": "cycle",
      "title": "Повтор одной кнопкой",
      "settings": {
        "appearance": "ghost",
        "scheme": "on-surface",
        "value": "off",
        "cycle": [
          {
            "value": "off",
            "label": "выключен",
            "icon": "repeat"
          },
          {
            "value": "all",
            "label": "весь список",
            "icon": "repeat",
            "pressed": true
          },
          {
            "value": "one",
            "label": "один трек",
            "icon": "repeat_one",
            "pressed": true
          }
        ]
      },
      "attributes": {
        "aria-label": "Повтор"
      },
      "expect": {
        "value": "off"
      }
    },
    {
      "name": "theme-cycle",
      "title": "Тема одной кнопкой",
      "settings": {
        "theme-cycle": "",
        "appearance": "ghost",
        "scheme": "on-surface"
      },
      "expect": {
        "appearance": "ghost"
      }
    },
    {
      "name": "badge",
      "title": "Со счётчиком",
      "settings": {
        "icon": "notifications",
        "badge-count": "3",
        "size": "2"
      },
      "attributes": {
        "aria-label": "Уведомления"
      },
      "expect": {
        "badge-count": "3"
      }
    },
    {
      "name": "loading",
      "title": "Загрузка",
      "settings": {
        "icon": "refresh",
        "loading": true
      },
      "attributes": {
        "aria-label": "Обновить"
      },
      "expect": {
        "loading": true
      }
    },
    {
      "name": "disabled",
      "title": "Недоступна",
      "settings": {
        "icon": "add",
        "disabled": true
      },
      "attributes": {
        "aria-label": "Добавить"
      },
      "expect": {
        "disabled": true
      }
    },
    {
      "name": "segments",
      "title": "Сегмент в начале",
      "settings": {
        "icon": "format_bold",
        "segment": "start",
        "appearance": "outline"
      },
      "attributes": {
        "aria-label": "Полужирный"
      },
      "expect": {
        "segment": "start"
      }
    }
  ],
  "pages": [
    {
      "name": "conformance",
      "title": "sf-icon-button against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main>",
          "  <sf-button-icon id=\"ib\" icon=\"settings\" aria-label=\"Настройки\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-close\" kind=\"close\" aria-label=\"Закрыть\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-old\" variant=\"close\" type=\"tonal\" tightness=\"low\" aria-label=\"Старые имена\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-badge\" icon=\"notifications\" badge-count=\"3\" size=\"2\" aria-label=\"Уведомления\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-load\" icon=\"refresh\" loading aria-label=\"Обновить\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-bad\" icon=\"add\" appearance=\"primary\" size=\"7\" aria-label=\"Неизвестно\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-err\" icon=\"delete\" status=\"error\" aria-label=\"Удалить\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-surface\" icon=\"tune\" appearance=\"surface\" aria-label=\"Фильтры\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-surface-err\" icon=\"delete\" appearance=\"surface\" status=\"danger\" aria-label=\"Удалить\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-old-looks\" icon=\"share\" appearance=\"link\" scheme=\"secondary\" aria-label=\"Поделиться\"></sf-button-icon>",
          "  <sf-button-icon id=\"ib-cyc\" aria-label=\"Повтор\" value=\"off\" label-pressed=\"Не так\" cycle='[{\"value\":\"off\",\"label\":\"выключен\",\"icon\":\"repeat\"},{\"value\":\"all\",\"label\":\"весь список\",\"icon\":\"repeat\",\"pressed\":true},{\"value\":\"one\",\"label\":\"один трек\",\"icon\":\"repeat_one\",\"pressed\":true}]'></sf-button-icon>",
          "  <sf-button-icon id=\"ib-theme\" theme-cycle></sf-button-icon>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-native-button",
          "title": "draws one native button named by the host's aria-label; the host has no box",
          "covers": "accessibility.role button, accessibility.name aria-label",
          "steps": [
            {
              "check": "(() => { const host = document.querySelector('#ib'); const b = host.querySelector('button.sf-icon-button'); return getComputedStyle(host).display === 'contents' && b && b.getAttribute('aria-label') === 'Настройки' && b.querySelector('sf-icon').getAttribute('icon') === 'settings' && b.classList.contains('sf-icon-button--icon') && b.classList.contains('sf-icon-button--default') && b.classList.contains('sf-icon-button--primary'); })()",
              "expect": {
                "values": {
                  "#ib.kind": "icon",
                  "#ib.appearance": "default",
                  "#ib.size": "1"
                }
              }
            }
          ]
        },
        {
          "id": "p2-close",
          "title": "the close kind draws sf-close at the button's size",
          "covers": "settings.kind close",
          "steps": [
            {
              "check": "document.querySelector('#ib-close button').classList.contains('sf-icon-button--close') && document.querySelector('#ib-close button sf-button-close').getAttribute('size') === '1'"
            }
          ]
        },
        {
          "id": "p3-dated-aliases",
          "title": "variant, type and tightness still draw, each noted with its dates",
          "covers": "aliases.json variant, type, tightness, low",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#ib-old button'); return b.classList.contains('sf-icon-button--close') && b.classList.contains('sf-icon-button--tonal') && b.classList.contains('tightness-low'); })()",
              "expect": {
                "values": {
                  "#ib-old.kind": "close",
                  "#ib-old.appearance": "tonal",
                  "#ib-old.spacing": "compact"
                }
              }
            },
            {
              "check": "['variant', 'type', 'tightness'].every((from) => [...SF.__deprecationNotes.values()].some((note) => note.component === 'sf-button-icon' && note.from === from && note.remove_after === '2026-12-01'))"
            }
          ]
        },
        {
          "id": "p4-badge",
          "title": "a count stands on the button and joins its name",
          "covers": "settings.badge-count",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#ib-badge button'); return Boolean(b.querySelector('.sf-badge')) && b.getAttribute('aria-label').startsWith('Уведомления') && b.getAttribute('aria-label').includes('3'); })()"
            }
          ]
        },
        {
          "id": "p5-loading",
          "title": "loading puts the spinner in place of the icon and disables the button",
          "covers": "settings.loading",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#ib-load button'); return b.disabled && b.getAttribute('aria-busy') === 'true' && !b.querySelector('sf-icon') && Boolean(b.querySelector('.sf-icon-button-spinner')); })()"
            }
          ]
        },
        {
          "id": "p6-unknown-values",
          "title": "a value off a list draws the default",
          "covers": "settings.appearance enum, settings.size enum",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#ib-bad button'); return b.classList.contains('sf-icon-button--default') && b.classList.contains('sf-icon-button--size-1'); })()",
              "expect": {
                "values": {
                  "#ib-bad.appearance": "default",
                  "#ib-bad.size": "1"
                }
              }
            }
          ]
        },
        {
          "id": "p7-click-bubbles",
          "title": "a click on the native button reaches the host",
          "covers": "native activation",
          "steps": [
            {
              "script": "(() => { window.__ibClicks = 0; document.querySelector('#ib').addEventListener('click', () => { window.__ibClicks += 1; }); return true; })()"
            },
            {
              "user": "click:#ib button"
            },
            {
              "check": "window.__ibClicks === 1"
            }
          ]
        },
        {
          "id": "p8-button-attributes",
          "title": "setButtonAttributes writes the object setting, not an attribute",
          "covers": "settings.button-attributes (x-decisions setter)",
          "steps": [
            {
              "script": "(() => { document.querySelector('#ib').setButtonAttributes({title: 'x'}); return true; })()"
            },
            {
              "check": "document.querySelector('#ib').buttonAttributes.title === 'x' && !document.querySelector('#ib').hasAttribute('button-attributes')"
            }
          ]
        },
        {
          "id": "p9-public-variable",
          "title": "--sf-icon-button-background-color fills the button",
          "covers": "css-variables --sf-icon-button-background-color",
          "steps": [
            {
              "script": "(() => { document.querySelector('#ib').style.setProperty('--sf-icon-button-background-color', 'rgb(1, 2, 3)'); return true; })()"
            },
            {
              "check": "getComputedStyle(document.querySelector('#ib button')).backgroundColor === 'rgb(1, 2, 3)'"
            }
          ]
        },
        {
          "id": "p8-danger-looks",
          "title": "error reads as danger, link as ghost, secondary as on-surface-variant, surface as tonal on-surface; surface with danger is red, not grey",
          "covers": "settings.status danger, settings.appearance ghost, settings.scheme, aliases.json error, link, secondary; retired surface",
          "steps": [
            {
              "check": "(() => { const c = (id) => document.querySelector(id + ' button').classList; return c('#ib-err').contains('sf-icon-button--danger') && c('#ib-err').contains('sf-icon-button--error') && c('#ib-surface').contains('sf-icon-button--tonal') && c('#ib-surface').contains('sf-icon-button--on-surface') && c('#ib-surface-err').contains('sf-icon-button--tonal') && c('#ib-surface-err').contains('sf-icon-button--danger') && c('#ib-old-looks').contains('sf-icon-button--link') && c('#ib-old-looks').contains('sf-icon-button--on-surface-variant'); })()",
              "expect": {
                "values": {
                  "#ib-err.status": "danger",
                  "#ib-surface.appearance": "tonal",
                  "#ib-surface.scheme": "on-surface",
                  "#ib-old-looks.appearance": "ghost",
                  "#ib-old-looks.scheme": "on-surface-variant"
                }
              }
            },
            {
              "check": "(() => { const b = document.querySelector('#ib-surface-err button'); const fill = getComputedStyle(b).backgroundColor; const probe = document.createElement('i'); probe.style.color = 'var(--sf-error-container)'; document.body.append(probe); const want = getComputedStyle(probe).color; probe.remove(); return fill === want; })()"
            },
            {
              "check": "['error', 'link', 'secondary', 'surface'].every((from) => [...SF.__deprecationNotes.values()].some((note) => note.component === 'sf-button-icon' && note.from === from && note.remove_after === '2027-01-01'))"
            }
          ]
        },
        {
          "id": "p9-cycle",
          "title": "a cycle shows the current item's icon and pressed look, names it, steps, wraps, sends change and announces; label-pressed beside it is ignored",
          "covers": "settings.cycle, settings.value, events.change",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#ib-cyc button'); return b.getAttribute('aria-label') === 'Повтор: выключен' && b.querySelector('sf-icon').getAttribute('icon') === 'repeat' && !b.classList.contains('sf-icon-button--pressed') && !b.hasAttribute('aria-pressed') && b.title.includes('весь список'); })()"
            },
            {
              "user": "click:#ib-cyc button",
              "expect": {
                "events": [
                  {
                    "name": "change",
                    "count": 1
                  }
                ]
              }
            },
            {
              "check": "(() => { const h = document.querySelector('#ib-cyc'); const b = h.querySelector('button'); return h.getAttribute('value') === 'all' && b.classList.contains('sf-icon-button--pressed') && b.getAttribute('aria-label') === 'Повтор: весь список' && h.querySelector('.sf-icon-button-announce').textContent.trim() === 'Повтор: весь список'; })()"
            },
            {
              "user": "click:#ib-cyc button"
            },
            {
              "check": "document.querySelector('#ib-cyc button sf-icon').getAttribute('icon') === 'repeat_one'"
            },
            {
              "user": "click:#ib-cyc button"
            },
            {
              "check": "document.querySelector('#ib-cyc').getAttribute('value') === 'off'"
            }
          ]
        },
        {
          "id": "p10-theme-cycle",
          "title": "a theme cycle names the theme, shows contrast for «as the system» and offers the opposite of the visible theme first",
          "covers": "settings.theme-cycle",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#ib-theme button'); const pref = SF.Loader?.themePreference || 'system'; const icon = b.querySelector('sf-icon').getAttribute('icon'); const want = {system: 'contrast', light: 'light_mode', dark: 'dark_mode'}[pref]; return icon === want && b.getAttribute('aria-label').startsWith('Тема: ') && b.title.includes('Нажмите'); })()"
            }
          ]
        }
      ]
    }
  ]
}
