        "has-next": true,
        "top": false,
        "bottom": false
      },
      "expect": {
        "name": "Страницы результатов",
        "values": {
          "current": 3
        }
      }
    },
    {
      "name": "bulk",
      "title": "Действия с отмеченными",
      "settings": {
        "size": "1/2",
        "total": 120,
        "selected-count": 4,
        "actions": "archive:В архив|delete:Удалить",
        "show-action-for-all": true,
        "top": false
      },
      "expect": {
        "name": "Страницы результатов"
      },
      "first-paint": {
        "max-bytes": 10000,
        "why": "The bulk row is shown at rest beside the pages: two closed dropdowns, a button, a checkbox and a clear button, each a printed Smart element with its own markup."
      }
