  "ai_guidance": {
    "use_when": "Use sf-spinner for a bounded waiting state whose progress cannot be expressed as a meaningful percentage.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component",
      "Do not use Spinner when determinate Progress or content-matched Skeleton is more accurate",
      "Do not make Spinner focusable",
      "Do not omit the containing region's aria-busy state",
      "Do not announce an empty or non-localized label",
      "Do not choose a spinner look: there is one, the arc; breathing, comet, dots and data-sf-spinner are former names until 2027-01-01",
