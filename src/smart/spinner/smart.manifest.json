{
  "schema_version": 2,
  "id": "smart.spinner",
  "version": "1.4.0",
  "title": "Spinner",
  "summary": "Indeterminate waiting indicator, one look (the arc) on the size ladder, shown after a delay (1 s by default), in the place's quiet ink, with optional polite status announcement and Framework-owned motion.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "spinner"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "loading-status",
    "reduced-motion"
  ],
  "custom_element": "sf-spinner",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.spinner"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "size": {
        "type": "string",
        "default": "1",
        "description": "The size ladder: at each step the spinner is the icon of an sf-button of the same size (diameter and stroke), so it can stand in for that icon.",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "label": {
        "type": "string",
        "description": "Empty: the text of the page's language (\"Loading…\" in English)."
      },
      "delay": {
        "type": "integer",
        "default": 1000,
        "description": "Milliseconds before the spinner shows (owner decision C130 (8); the name is final by C138): a wait shorter than that shows nothing. 0 shows at once. Written as data-delay; without the attribute the sheet's 1 s holds.",
        "minimum": 0
      },
      "label-hidden": {
        "type": "boolean",
        "default": false,
        "description": "The label is said and not shown (SP-07; the name is final by C138): it stays the spinner's name for a screen reader (and what announce says) while the page shows the ring alone. label=\"\" takes the words from both."
      },
      "kind": {
        "type": "string",
        "default": "",
        "description": "One look, the arc (owner decision C130 (5)). breathing, comet and dots are former values until 2027-01-01 and draw the arc; so does a page's data-sf-spinner.",
        "enum": [
          "",
          "arc"
        ]
      },
      "dots": {
        "type": "integer",
        "default": 8,
        "minimum": 1,
        "pattern": "^(?:[3-9]|[12][0-9]|3[0-2])$"
      },
      "filled": {
        "type": "integer",
        "default": 3,
        "minimum": 0,
        "pattern": "^(?:[1-9]|[12][0-9]|3[0-2])$"
      },
      "infinite": {
        "type": "boolean",
        "default": false
      },
      "announce": {
        "type": "boolean",
        "default": false
      },
      "direction": {
        "type": "string",
        "default": "clockwise",
        "enum": [
          "clockwise",
          "counterclockwise"
        ]
      },
      "variant": {
        "type": "string",
        "default": "",
        "description": "Legacy name for kind, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "",
          "arc"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "refreshSpinner": {
      "summary": "Re-renders the bound spinner root from its current configuration; does nothing before it is bound.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "getSpinnerRoot": {
      "summary": "Returns the inner spinner root (.sf-loader-container), or null before render.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    }
  },
  "events": {},
  "state": {
    "machines": {
