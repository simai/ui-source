{
  "examples": [
    {
      "name": "set",
      "title": "Выбранный цвет",
      "settings": {
        "label": "Цвет акцента",
        "name": "accent",
        "value": "#1f6feb"
      },
      "expect": {
        "values": {
          "value": "#1f6feb",
          "effective-value": "#1f6feb"
        }
      }
    },
    {
      "name": "palette",
      "title": "Цвет палитры",
      "settings": {
        "label": "Цвет метки",
        "name": "label-color",
        "value": "blue",
        "custom": false
      },
      "expect": {
        "values": {
          "value": "blue",
          "effective-value": "blue"
        }
      }
    },
    {
      "name": "inherited",
      "title": "Цвет наследуется",
      "settings": {
        "label": "Цвет акцента",
        "name": "accent",
        "inherited-value": "#d1242f"
      },
      "expect": {
        "values": {
          "value": "",
          "effective-value": "#d1242f"
        },
        "host-states": {
          "data-inherited": true
        }
      }
    },
    {
      "name": "swatches",
      "title": "Цвета продукта",
      "settings": {
        "label": "Цвет метки",
        "swatches": "#1f6feb|Фирменный синий, red|Тревога, #1a7f37|Зелёный"
      },
      "expect": {
        "values": {
          "value": ""
        }
      }
    },
    {
      "name": "clearable",
      "title": "Со сбросом",
      "settings": {
        "label": "Цвет",
        "value": "#1a7f37",
        "clearable": true
      },
      "expect": {
        "values": {
          "value": "#1a7f37"
        }
      }
    },
    {
      "name": "alpha",
      "title": "С прозрачностью",
      "settings": {
        "label": "Цвет свечения",
        "value": "#1f6feb80",
        "alpha": true
      },
      "expect": {
        "values": {
          "value": "#1f6feb80"
        }
      }
    },
    {
      "name": "disabled",
      "title": "Недоступен",
      "settings": {
        "label": "Цвет",
        "value": "#1a7f37",
        "disabled": true
      },
      "expect": {
        "values": {
          "value": "#1a7f37"
        }
      }
    },
    {
      "name": "theme",
      "title": "Цвет темы",
      "settings": {
        "variant": "theme",
        "clearable": true
      },
      "expect": {
        "values": {
          "value": ""
        }
      }
    }
  ],
  "pages": [
    {
      "name": "conformance",
      "x-probe": {
        "probe": "sf-input-color against component.json (standard simai.smart-component 1.3.8 §4.1, §4.3, §4.4, §8, §16.20, §17.1, §20.2; owner decision C83: the window)",
        "component": "sf-input-color",
        "page": {
          "lang": "ru",
          "markup": "<form id=\"f\">{{field}}<button type=\"submit\">OK</button></form>",
          "listen": [
            "input",
            "change",
            "sf-field-reset",
            "sf-field:reset"
          ]
        },
        "format": "ui-source tests/browser/manifest-probes.browser.mjs (stand 15 format: given, one trigger, expect)",
        "checks": [
          {
            "id": "swatch-press-commits",
            "covers": "events.input, events.change {value, name}, form.submits; a press on a swatch of the window commits and closes it",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" swatches=\"#1f6feb|Синий, #d1242f|Красный\"></sf-input-color>",
            "given": [
              {
                "user": "click:.sf-color-trigger"
              }
            ],
            "user": "click:.sf-color-option[aria-label='Красный']",
            "expect": {
              "value": "#d1242f",
              "events": [
                {
                  "type": "input",
                  "value": "#d1242f",
                  "name": "accent"
                },
                {
                  "type": "change",
                  "value": "#d1242f",
                  "name": "accent"
                }
              ],
              "formData": {
                "accent": "#d1242f"
              },
              "evaluate": {
                "el.querySelector('input[type=hidden]')": null,
                "[...form.elements].includes(el)": true,
                "el.querySelector('.sf-color-window')": null
              }
            }
          },
          {
            "id": "enter-on-a-swatch-selects",
            "covers": "keyboard.window Enter select",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" swatches=\"#1f6feb|Синий, #d1242f|Красный\"></sf-input-color>",
            "given": [
              {
                "user": "click:.sf-color-trigger"
              },
              {
                "user": "focus:.sf-color-option[aria-label='Синий']"
              }
            ],
            "user": "keyboard:Enter",
            "expect": {
              "value": "#1f6feb",
              "formData": {
                "accent": "#1f6feb"
              }
            }
          },
          {
            "id": "space-on-a-swatch-selects",
            "covers": "keyboard.window Space select",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" swatches=\"#1f6feb|Синий, #d1242f|Красный\"></sf-input-color>",
            "given": [
              {
                "user": "click:.sf-color-trigger"
              },
              {
                "user": "focus:.sf-color-option[aria-label='Красный']"
              }
            ],
            "user": "keyboard:Space",
            "expect": {
              "value": "#d1242f"
            }
          },
          {
            "id": "inherited-submits-empty",
            "covers": "§20.2: the form value is empty and the host carries data-inherited; effective-value is the inherited colour; shown is the base value",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" inherited-value=\"#D1242F\"></sf-input-color>",
            "form": "submit",
            "expect": {
              "submitted": true,
              "formData": {
                "accent": ""
              },
              "host": {
                "attributes": {
                  "data-inherited": "true"
                },
                "properties": {
                  "effectiveValue": "#d1242f",
                  "shown": true,
                  "started": true
                }
              }
            }
          },
          {
            "id": "reset-to-inherited-sends-the-new-name-first",
            "covers": "aliases.json sf-field:reset -> sf-field-reset (same-detail, dated), then input and change",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"#1a7f37\" inherited-value=\"#d1242f\"></sf-input-color>",
            "script": "return el.resetToInherited();",
            "expect": {
              "returns": true,
              "value": "",
              "events": [
                {
                  "type": "sf-field-reset",
                  "tag": "sf-input-color",
                  "value": "#1a7f37",
                  "inheritedValue": "#d1242f",
                  "name": "accent"
                },
                {
                  "type": "sf-field:reset",
                  "tag": "sf-input-color",
                  "value": "#1a7f37",
                  "inheritedValue": "#d1242f",
                  "name": "accent"
                },
                {
                  "type": "input",
                  "value": ""
                },
                {
                  "type": "change",
                  "value": ""
                }
              ],
              "deprecations": [
                {
                  "component": "sf-input-color",
                  "kind": "event",
                  "from": "sf-field:reset",
                  "to": "sf-field-reset",
                  "since": "2026-10-27",
                  "remove_after": "2026-12-01"
                }
              ],
              "host": {
                "attributes": {
                  "data-inherited": "true"
                }
              }
            }
          },
          {
            "id": "clear-answers-an-outcome",
            "covers": "actions.clear (§4.4)",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"#1a7f37\" clearable></sf-input-color>",
            "action": {
              "name": "clear"
            },
            "expect": {
              "returns": {
                "outcome": "applied"
              },
              "value": "",
              "events": [
                {
                  "type": "input",
                  "value": ""
                },
                {
                  "type": "change",
                  "value": ""
                }
              ]
            }
          },
          {
            "id": "clear-with-nothing-is-refused",
            "covers": "actions.clear refused {reason}",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\"></sf-input-color>",
            "action": {
              "name": "clear"
            },
            "expect": {
              "returns": {
                "outcome": "refused",
                "reason": "unchanged"
              },
              "events": []
            }
          },
          {
            "id": "value-from-code-is-silent",
            "covers": "§8: a value set from outside is not reported back",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\"></sf-input-color>",
            "property": {
              "name": "value",
              "value": "ABCDEF"
            },
            "expect": {
              "value": "#abcdef",
              "events": [],
              "formData": {
                "accent": "#abcdef"
              }
            }
          },
          {
            "id": "nothing-while-disabled",
            "covers": "form.disabled (§17.1 item 3)",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"#1a7f37\" disabled></sf-input-color>",
            "form": "submit",
            "expect": {
              "submitted": true,
              "formData": {
                "accent": null
              }
            }
          },
          {
            "id": "form-reset-returns-the-default",
            "covers": "form.reset (§17.1 item 4): no events",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"#1a7f37\" swatches=\"#d1242f|Красный\"></sf-input-color>",
            "given": [
              {
                "user": "click:.sf-color-trigger"
              },
              {
                "user": "click:.sf-color-option[aria-label='Красный']"
              }
            ],
            "form": "reset",
            "expect": {
              "value": "#1a7f37",
              "events": [],
              "formData": {
                "accent": "#1a7f37"
              }
            }
          },
          {
            "id": "custom-error-blocks-submit",
            "covers": "validity custom-error (§17.2)",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"#1a7f37\"></sf-input-color>",
            "script": "el.setCustomValidity('Слишком светлый'); form.requestSubmit();",
            "expect": {
              "submitted": false,
              "validity": {
                "host": {
                  "customError": true,
                  "valid": false
                }
              }
            }
          },
          {
            "id": "enter-on-the-field-opens-the-window",
            "covers": "keyboard.host Enter open: the trigger opens the window, aria-expanded true, focus inside on the chosen swatch",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"blue\"></sf-input-color>",
            "given": [
              {
                "user": "focus:.sf-color-trigger"
              }
            ],
            "user": "keyboard:Enter",
            "expect": {
              "evaluate": {
                "Boolean(el.querySelector('.sf-color-window'))": true,
                "el.querySelector('.sf-color-trigger').getAttribute('aria-expanded')": "true"
              },
              "focus": ".sf-color-option[aria-checked='true']",
              "events": []
            }
          },
          {
            "id": "space-on-the-field-opens-the-window",
            "covers": "keyboard.host Space open",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\"></sf-input-color>",
            "given": [
              {
                "user": "focus:.sf-color-trigger"
              }
            ],
            "user": "keyboard:Space",
            "expect": {
              "evaluate": {
                "Boolean(el.querySelector('.sf-color-window'))": true
              },
              "events": []
            }
          },
          {
            "id": "escape-closes-the-window",
            "covers": "keyboard.window Escape close: the window closes and focus returns to the trigger, nothing changes",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"blue\"></sf-input-color>",
            "given": [
              {
                "user": "click:.sf-color-trigger"
              }
            ],
            "user": "keyboard:Escape",
            "expect": {
              "value": "blue",
              "events": [],
              "evaluate": {
                "el.querySelector('.sf-color-window')": null
              },
              "focus": ".sf-color-trigger"
            }
          },
          {
            "id": "arrow-moves-the-palette-choice",
            "covers": "keyboard.window ArrowRight move: the palette is a radio group, an arrow chooses the next hue and keeps the window open; the value is the hue's name (C83)",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"blue\"></sf-input-color>",
            "given": [
              {
                "user": "click:.sf-color-trigger"
              }
            ],
            "user": "keyboard:ArrowRight",
            "expect": {
              "value": "indigo",
              "events": [
                {
                  "type": "input",
                  "value": "indigo",
                  "name": "accent"
                },
                {
                  "type": "change",
                  "value": "indigo",
                  "name": "accent"
                }
              ],
              "formData": {
                "accent": "indigo"
              },
              "evaluate": {
                "Boolean(el.querySelector('.sf-color-window'))": true
              }
            }
          },
          {
            "id": "arrows-walk-the-grid",
            "covers": "keyboard.window ArrowLeft, ArrowDown, ArrowUp, Home, End move: eight columns, the ends clamp",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" value=\"blue\"></sf-input-color>",
            "given": [
              {
                "user": "click:.sf-color-trigger"
              }
            ],
            "user": [
              "keyboard:ArrowLeft",
              "keyboard:ArrowDown",
              "keyboard:ArrowUp",
              "keyboard:Home",
              "keyboard:End"
            ],
            "expect": {
              "value": "gray"
            }
          },
          {
            "id": "palette-name-from-code",
            "covers": "values.value: a palette name is stored as written in every language, lowercase",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\"></sf-input-color>",
            "property": {
              "name": "value",
              "value": "Blue"
            },
            "expect": {
              "value": "blue",
              "events": [],
              "formData": {
                "accent": "blue"
              },
              "texts": {
                ".sf-color-text": "Синий"
              }
            }
          },
          {
            "id": "alpha-off-drops-the-alpha",
            "covers": "settings.alpha: without alpha a translucent code keeps its colour",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\"></sf-input-color>",
            "property": {
              "name": "value",
              "value": "#1f6feb80"
            },
            "expect": {
              "value": "#1f6feb",
              "formData": {
                "accent": "#1f6feb"
              }
            }
          },
          {
            "id": "alpha-on-keeps-the-alpha",
            "covers": "settings.alpha: with alpha the value may be #rrggbbaa, the swatch is split (C86)",
            "field": "<sf-input-color name=\"accent\" label=\"Цвет\" alpha></sf-input-color>",
            "property": {
              "name": "value",
              "value": "#1F6FEB80"
            },
            "expect": {
              "value": "#1f6feb80",
              "evaluate": {
                "el.querySelector('.sf-color-chip').hasAttribute('data-alpha')": true
              }
            }
          }
        ]
      }
    }
  ]
}
