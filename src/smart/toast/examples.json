      },
      "expect": {
        "name": "Запись удалена"
      }
    },
    {
      "name": "statuses",
      "title": "Статусы",
      "settings": {
        "heading": "Ошибка сохранения",
        "status": "error",
        "role": "alert"
      },
      "expect": {
        "name": "Ошибка сохранения"
      }
    },
    {
      "name": "timed",
      "title": "Скрывается сам",
      "settings": {
        "heading": "Скопировано",
