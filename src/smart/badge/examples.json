  "pages": [
    {
      "name": "conformance",
      "title": "sf-badge against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main>",
          "  <sf-badge id=\"bd\" text=\"Новый\" scheme=\"primary\"></sf-badge>",
          "  <sf-badge id=\"bd-status\" text=\"Оплачен\" status=\"success\" appearance=\"tonal\"></sf-badge>",
          "  <sf-badge id=\"bd-old\" text=\"Старые имена\" type=\"outline\" status=\"danger\" icon-left=\"check\"></sf-badge>",
          "  <sf-badge id=\"bd-scheme\" text=\"Статус в схеме\" scheme=\"warning\"></sf-badge>",
          "  <sf-badge id=\"bd-label\" text=\"99+\" aria-label=\"Больше 99 новых\"></sf-badge>",
          "  <sf-badge id=\"bd-empty\" icon-start=\"\" icon=\"star\"></sf-badge>",
          "  <sf-badge id=\"bd-running\" activity=\"running\"></sf-badge>",
          "  <sf-badge id=\"bd-waiting\" activity=\"waiting\"></sf-badge>",
          "  <sf-badge id=\"bd-over\" activity=\"failed\" status=\"success\" scheme=\"primary\"></sf-badge>",
          "  <sf-badge id=\"bd-own\" activity=\"running\" text=\"Build\" icon=\"sync\"></sf-badge>",
          "  <sf-badge id=\"bd-empty-mark\" activity=\"done\" icon-start=\"\"></sf-badge>",
          "  <sf-badge id=\"bd-icon-only\" activity=\"stopped\" icon-only></sf-badge>",
          "  <sf-badge id=\"bd-compact-alias\" activity=\"stopped\" compact></sf-badge>",
          "  <sf-badge id=\"bd-paused\" activity=\"paused\"></sf-badge>",
          "  <sf-badge id=\"bd-queued\" activity=\"queued\"></sf-badge>",
          "  <sf-badge id=\"bd-icon-only-bare\" text=\"Bare\" icon-only></sf-badge>",
          "  <sf-badge id=\"bd-tight\" text=\"Черновик\" appearance=\"tonal\" tight></sf-badge>",
          "  <sf-badge id=\"bd-figure\" text=\"3\" scheme=\"primary\"></sf-badge>",
          "  <sf-badge id=\"bd-figures\" text=\"12\" scheme=\"primary\"></sf-badge>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-draws",
          "title": "draws its text on the appearance, colour and size classes",
          "covers": "settings.text, appearance, scheme, size",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#bd .sf-badge'); return b.textContent.trim() === 'Новый' && b.classList.contains('sf-badge--main') && b.classList.contains('sf-badge--primary') && b.classList.contains('sf-badge--size-1/3'); })()",
              "expect": {
                "values": {
                  "#bd.appearance": "main",
                  "#bd.scheme": "primary",
                  "#bd.size": "1/3"
                }
              }
            }
          ]
        },
        {
          "id": "p2-status-wins",
          "title": "a status paints instead of the colour role",
          "covers": "settings.status",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#bd-status .sf-badge'); return b.classList.contains('sf-badge--success') && b.classList.contains('sf-badge--tonal'); })()",
              "expect": {
                "values": {
                  "#bd-status.status": "success"
                }
              }
            }
          ]
        },
        {
          "id": "p3-dated-aliases",
          "title": "type, danger and icon-left still draw, each noted with its dates",
          "covers": "aliases.json type, icon-left, danger",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#bd-old .sf-badge'); return b.classList.contains('sf-badge--outline') && b.classList.contains('sf-badge--error') && b.querySelector('.sf-icon')?.textContent.trim() === 'check'; })()",
              "expect": {
                "values": {
                  "#bd-old.appearance": "outline",
                  "#bd-old.status": "error",
                  "#bd-old.iconStart": "check"
                }
              }
            },
            {
              "check": "['type', 'danger', 'icon-left'].every((from) => [...SF.__deprecationNotes.values()].some((note) => note.component === 'sf-badge' && note.from === from && note.remove_after === '2026-12-01'))"
            }
          ]
        },
        {
          "id": "p4-scheme-routes-status",
          "title": "a status word written as scheme reaches status",
          "covers": "x-decisions scheme routing",
          "steps": [
            {
              "check": "document.querySelector('#bd-scheme .sf-badge').classList.contains('sf-badge--warning')",
              "expect": {
                "values": {
                  "#bd-scheme.status": "warning",
                  "#bd-scheme.scheme": "neutral"
                }
              }
            }
          ]
        },
        {
          "id": "p5-label",
          "title": "aria-label is said through a hidden span, the visible text hidden",
          "covers": "accessibility.name aria-label",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#bd-label .sf-badge'); return b.querySelector('.sr-only')?.textContent === 'Больше 99 новых' && b.querySelector('.sf-badge-text-container').getAttribute('aria-hidden') === 'true'; })()"
            }
          ]
        },
        {
          "id": "p6-empty-icon-start",
          "title": "an empty icon-start suppresses the icon shortcut; nothing to say is aria-hidden",
          "covers": "settings.icon-start optional",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#bd-empty .sf-badge'); return !b.querySelector('.sf-icon') && b.getAttribute('aria-hidden') === 'true'; })()"
            }
          ]
        },
        {
          "id": "p7-public-variable",
          "title": "--sf-badge-background-color fills the badge",
          "covers": "css-variables --sf-badge-background-color",
          "steps": [
            {
              "script": "(() => { document.querySelector('#bd').style.setProperty('--sf-badge-background-color', 'rgb(1, 2, 3)'); return true; })()"
            },
            {
              "check": "getComputedStyle(document.querySelector('#bd .sf-badge')).backgroundColor === 'rgb(1, 2, 3)'"
            }
          ]
        },
        {
          "id": "p8-activity-marks",
          "title": "a run state draws its mark and the word of the page's language",
          "covers": "settings.activity",
          "steps": [
            {
              "check": "(() => { const host = document.querySelector('#bd-waiting'); const b = host.querySelector('.sf-badge'); return b.querySelector('.sf-icon')?.textContent.trim() === 'pending_actions' && b.querySelector('.sf-badge-text').textContent === host.sfWord('activity-waiting') && b.classList.contains('sf-badge--warning'); })()",
              "expect": {
                "values": {
                  "#bd-waiting.activity": "waiting"
                }
              }
            },
            {
              "check": "(() => { const b = document.querySelector('#bd-running .sf-badge'); return b.querySelector('.sf-badge-spinner svg') && !b.querySelector('.sf-icon') && b.classList.contains('sf-badge--neutral') && !b.closest('[role=status],[aria-live]'); })()"
            }
          ]
        },
        {
          "id": "p9-activity-wins",
          "title": "activity wins over status and scheme, which stay readable",
          "covers": "settings.activity over settings.status",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#bd-over .sf-badge'); return b.classList.contains('sf-badge--error') && !b.classList.contains('sf-badge--success') && !b.classList.contains('sf-badge--primary') && b.querySelector('.sf-icon').textContent.trim() === 'error'; })()",
              "expect": {
                "values": {
                  "#bd-over.status": "success",
                  "#bd-over.scheme": "primary"
                }
              }
            }
          ]
        },
        {
          "id": "p10-activity-overrides",
          "title": "text and icon override the word and the mark; an emptied icon-start keeps it",
          "covers": "settings.text, settings.icon over activity",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#bd-own .sf-badge'); return b.querySelector('.sf-badge-text').textContent === 'Build' && b.querySelector('.sf-icon').textContent.trim() === 'sync' && !b.querySelector('.sf-badge-spinner'); })()"
            },
            {
              "check": "document.querySelector('#bd-empty-mark .sf-icon').textContent.trim() === 'check_circle'"
            }
          ]
        },
        {
          "id": "p11-icon-only",
          "title": "icon-only hides the text from sight only and writes sf-badge--icon-only with its former sf-badge--compact; with no icon the text stays",
          "covers": "settings.icon-only",
          "steps": [
            {
              "check": "(() => { const host = document.querySelector('#bd-icon-only'); const b = host.querySelector('.sf-badge'); const text = b.querySelector('.sf-badge-text-container'); return b.classList.contains('sf-badge--icon-only') && b.classList.contains('sf-badge--compact') && text.classList.contains('sr-only') && !text.hasAttribute('aria-hidden') && text.textContent.trim() === host.sfWord('activity-stopped') && b.querySelector('.sf-icon').textContent.trim() === 'stop_circle'; })()",
              "expect": {
                "values": {
                  "#bd-icon-only.iconOnly": true
                }
              }
            },
            {
              "check": "(() => { const b = document.querySelector('#bd-icon-only-bare .sf-badge'); return !b.classList.contains('sf-badge--icon-only') && !b.classList.contains('sf-badge--compact') && !b.querySelector('.sf-badge-text-container').classList.contains('sr-only'); })()"
            }
          ]
        },
        {
          "id": "p11-compact-alias",
          "title": "the dated boolean compact draws as icon-only, the same classes and box, and is noted in SF.deprecations until 2027-01-01 (owner decision C134)",
          "covers": "settings.icon-only, aliases compact",
          "steps": [
            {
              "check": "(() => { const a = document.querySelector('#bd-compact-alias'); const n = document.querySelector('#bd-icon-only'); const ab = a.querySelector('.sf-badge'); const nb = n.querySelector('.sf-badge'); const ra = ab.getBoundingClientRect(); const rn = nb.getBoundingClientRect(); const notes = SF.deprecations.list().filter((note) => note.component === 'sf-badge' && note.from === 'compact'); return a.hasAttribute('icon-only') && a.iconOnly === true && a.compact === true && ab.className === nb.className && Math.abs(ra.width - rn.width) < 0.02 && Math.abs(ra.height - rn.height) < 0.02 && notes.length >= 1 && notes.every((note) => note.to === 'icon-only' && note.remove_after === '2027-01-01'); })()"
            }
          ]
        },
        {
          "id": "p12-tight",
          "title": "tight takes the narrow side room --sf-space-1/3; one figure stays round, two do not take the mark",
          "covers": "settings.tight",
          "steps": [
            {
              "check": "(() => { const tight = document.querySelector('#bd-tight .sf-badge'); const room = document.querySelector('#bd .sf-badge'); return tight.classList.contains('sf-badge--tight') && !room.classList.contains('sf-badge--tight') && parseFloat(getComputedStyle(tight).paddingLeft) < parseFloat(getComputedStyle(room).paddingLeft); })()",
              "expect": {
                "values": {
                  "#bd-tight.tight": true
                }
              }
            },
            {
              "check": "(() => { const one = document.querySelector('#bd-figure .sf-badge'); const two = document.querySelector('#bd-figures .sf-badge'); const box = one.getBoundingClientRect(); return one.classList.contains('sf-badge--figure') && !two.classList.contains('sf-badge--figure') && Math.abs(box.width - box.height) < 0.02; })()"
            }
          ]
        },
        {
          "id": "p-activity-paused-queued",
          "title": "paused is a warning with a pause mark, queued a neutral badge with a clock, each with its word (C34)",
          "covers": "settings.activity paused, queued",
          "steps": [
            {
              "check": "(() => { const p = document.querySelector('#bd-paused'); const pb = p.querySelector('.sf-badge'); const q = document.querySelector('#bd-queued'); const qb = q.querySelector('.sf-badge'); return pb.querySelector('.sf-icon')?.textContent.trim() === 'pause_circle' && pb.classList.contains('sf-badge--warning') && pb.querySelector('.sf-badge-text').textContent === p.sfWord('activity-paused') && qb.querySelector('.sf-icon')?.textContent.trim() === 'schedule' && qb.classList.contains('sf-badge--neutral') && qb.querySelector('.sf-badge-text').textContent === q.sfWord('activity-queued'); })()"
            }
          ]
        }
      ]
    }
  ]
}
