{
  "schema_version": 2,
  "id": "smart.progress-scale",
  "version": "1.2.0",
  "title": "Progress Scale",
  "summary": "Segmented determinate progress with exact accessible value, explicit semantic tone and ten visual steps.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "progress-scale"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "determinate-progress",
    "accessible-range"
  ],
  "custom_element": "sf-progress-scale",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.progress-scale"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "line": {
        "type": "string",
        "default": "",
        "description": "Takes the text line of this form size, for a table cell or a row of fields, so the row keeps its control height.",
        "enum": [
          "",
          "1/2",
          "1",
          "2"
        ]
      },
      "value": {
        "type": "number",
        "default": 0,
        "minimum": 0,
        "maximum": 100,
        "pattern": "^(?:100|[1-9]?[0-9])(?:\\.[0-9]+)?$"
      },
      "show-text": {
        "type": "boolean",
        "default": true
      },
      "status": {
        "type": "string",
        "default": "",
        "description": "What the value reports, in the shared status vocabulary (owner decision C131 (1)). Empty, the default, draws the theme's primary; neutral is grey, as in sf-dot and sf-badge; info, success, warning and error their roles. The word this component used before, primary, is still accepted and means the default. With warning-at or error-at the scale takes the more serious of this status and the threshold the value reached.",
        "enum": [
          "",
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ]
      },
      "warning-at": {
        "type": "number",
        "description": "A threshold in per cent: from this value on, the component is a warning by itself (a disk 83 % full of a warning-at 80). The page sets the threshold; the component only compares. Unset, no threshold.",
        "minimum": 0,
        "maximum": 100
      },
      "error-at": {
        "type": "number",
        "description": "A threshold in per cent: from this value on, the component is an error by itself (a disk 83 % full of a warning-at 80). The page sets the threshold; the component only compares. Unset, no threshold. Above warning-at when both are set.",
        "minimum": 0,
        "maximum": 100
      },
      "meter": {
        "type": "boolean",
        "default": false,
        "description": "The value is an amount within a known range (a quota used, a disk filled), not a task's progress: role meter instead of progressbar (owner decision C131 (7)). A meter always has a value, so it is never indeterminate. The look does not change."
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "value-text": {
        "type": "string",
        "default": ""
      },
      "aria-label": {
        "type": "string",
        "default": ""
      },
      "tone": {
        "type": "string",
        "default": "",
        "description": "Legacy name for status, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "",
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "chunk": {
      "summary": "The action chunk.",
      "arguments": [
        {
          "name": "args",
          "type": "object",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "done": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            },
            "required": [
              "done",
              "total"
            ]
          }
        }
      ],
      "returns": {
        "type": "object"
      }
    },
    "getProgress": {
      "summary": "Returns the value as a number clamped to 0..100; a non-numeric value reads as 0.",
      "arguments": [],
      "returns": {
        "type": "number"
      }
    },
    "setProgress": {
      "summary": "Sets the value attribute; null or undefined removes it.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "number|string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {},
  "state": {
    "machines": {
      "progress": [
        "active",
        "complete",
        "error"
      ]
    },
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "running, cancelling or retrying the task",
      "inferring semantic state from the current segment count",
      "inventing the accessible process label"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "progressbar",
    "accessible_name": "required",
    "keyboard": [],
    "focus": "Progress Scale is not interactive and never enters the focus order."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [],
