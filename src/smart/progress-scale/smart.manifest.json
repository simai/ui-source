  "ai_guidance": {
    "use_when": "Use sf-progress-scale when a known progress value is meaningfully represented by ten coarse or staged segments.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component",
      "Do not use segmented progress when continuous Progress Bar is clearer",
      "Do not use Progress Scale for an unknown value; use Spinner",
      "Do not infer error, warning or success from the percentage",
      "Do not omit a localized accessible label"
    ],
    "required_reads": [
