  ],
  "pages": [
    {
      "name": "conformance",
      "title": "sf-button against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main>",
          "  <sf-button id=\"b-text\" text=\"Продолжить\"></sf-button>",
          "  <sf-button id=\"b-child\">Добавить</sf-button>",
          "  <sf-button id=\"b-icon\" icon=\"search\" aria-label=\"Найти\"></sf-button>",
          "  <sf-button id=\"b-old\" type=\"ghost\" status=\"danger\" icon-left=\"add\" tightness=\"high\" icon-position=\"right\" text=\"Старые имена\"></sf-button>",
          "  <sf-button id=\"b-off\" text=\"Нельзя\" disabled></sf-button>",
          "  <sf-button id=\"b-load\" text=\"Отправка\" loading></sf-button>",
          "  <sf-button id=\"b-exp\" text=\"Ещё\" expanded=\"false\"></sf-button>",
          "  <sf-button id=\"b-bad\" text=\"Неизвестно\" appearance=\"primary\" size=\"9\"></sf-button>",
          "  <sf-button id=\"b-tab\" text=\"Инструкция\" href=\"/fixture/help\" target=\"_blank\"></sf-button>",
          "  <sf-button id=\"b-rel\" text=\"Партнёр\" href=\"https://example.com/\" target=\"_blank\" rel=\"noopener\"></sf-button>",
          "  <sf-button id=\"b-self\" text=\"Раздел\" href=\"/fixture/section\" target=\"_self\"></sf-button>",
          "  <sf-button id=\"b-btn-target\" text=\"Кнопка\" target=\"_blank\" rel=\"nofollow\"></sf-button>",
          "  <sf-button id=\"b-err\" text=\"Удалить\" status=\"error\"></sf-button>",
          "  <sf-button id=\"b-link\" text=\"Подробнее\" appearance=\"link\"></sf-button>",
          "  <sf-button id=\"b-cyc\" aria-label=\"Скорость\" value=\"1\" cycle='[{\"value\":\"1\",\"label\":\"1×\"},{\"value\":\"1.5\",\"label\":\"1,5×\"},{\"value\":\"2\",\"label\":\"2×\"}]' pressed></sf-button>",
          "  <sf-button id=\"b-h-low\" height=\"low\" text=\"Ниже\"></sf-button>",
          "  <sf-button id=\"b-h-default\" height=\"default\" text=\"Обычная\"></sf-button>",
          "  <sf-button id=\"b-h-high\" height=\"high\" text=\"Выше\"></sf-button>",
          "  <sf-button id=\"b-h-highest\" height=\"highest\" text=\"Самая высокая\"></sf-button>",
          "  <sf-button id=\"b-h-bad\" height=\"48\" text=\"Не высота\"></sf-button>",
          "  <sf-button id=\"b-full\" full-width text=\"Во всю ширину\"></sf-button>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-native-button",
          "title": "draws one native button named by its text; the host has no box",
          "covers": "accessibility.role button, accessibility.name text",
          "steps": [
            {
              "check": "(() => { const host = document.querySelector('#b-text'); const b = host.querySelector('button.sf-button'); return getComputedStyle(host).display === 'contents' && b && b.type === 'button' && b.textContent.trim() === 'Продолжить' && b.classList.contains('sf-button--default') && b.classList.contains('sf-button--primary') && b.classList.contains('sf-button--size-1'); })()",
              "expect": {
                "values": {
                  "#b-text.appearance": "default",
                  "#b-text.scheme": "primary",
                  "#b-text.size": "1"
                }
              }
            }
          ]
        },
        {
          "id": "p2-text-child",
          "title": "a text child is the label",
          "covers": "settings.text from children",
          "steps": [
            {
              "check": "document.querySelector('#b-child button').textContent.trim() === 'Добавить' && document.querySelector('#b-child').text === 'Добавить'"
            }
          ]
        },
        {
          "id": "p3-aria-label",
          "title": "an icon-only button takes the host's aria-label",
          "covers": "accessibility.name aria-label (host attribute, §3.1)",
          "steps": [
            {
              "check": "document.querySelector('#b-icon button').getAttribute('aria-label') === 'Найти' && document.querySelector('#b-icon button sf-icon').getAttribute('icon') === 'search'"
            }
          ]
        },
        {
          "id": "p4-dated-aliases",
          "title": "the old names and values still draw, each noted with its dates",
          "covers": "aliases.json type, icon-left, tightness, ghost (now link to ghost), danger (now error to danger), right",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#b-old button'); return b.classList.contains('sf-button--link') && b.classList.contains('sf-button--danger') && b.classList.contains('sf-button--error') && b.classList.contains('spacing-comfortable') && Boolean(b.querySelector('sf-icon[icon=add]')); })()",
              "expect": {
                "values": {
                  "#b-old.appearance": "ghost",
                  "#b-old.status": "danger",
                  "#b-old.spacing": "comfortable",
                  "#b-old.iconPosition": "end",
                  "#b-old.iconStart": "add"
                }
              }
            },
            {
              "check": "['type', 'icon-left', 'tightness', 'right'].every((from) => [...SF.__deprecationNotes.values()].some((note) => note.component === 'sf-button' && note.from === from && note.remove_after === '2026-12-01'))"
            }
          ]
        },
        {
          "id": "p5-press",
          "title": "a click sends sf-button-press once and the native click still bubbles",
          "covers": "events.press",
          "steps": [
            {
              "script": "(() => { window.__clicks = 0; document.addEventListener('click', () => { window.__clicks += 1; }, {once: true}); return true; })()"
            },
            {
              "user": "click:#b-text button",
              "expect": {
                "events": [
                  {
                    "name": "sf-button-press",
                    "count": 1
                  }
                ]
              }
            },
            {
              "check": "window.__clicks === 1"
            }
          ]
        },
        {
          "id": "p6-enter-presses",
          "title": "Enter on the focused native button sends press",
          "covers": "keyboard Tab reach, Enter (native activation)",
          "steps": [
            {
              "script": "(() => { document.querySelector('#b-text button').focus(); return true; })()"
            },
            {
              "user": "keyboard:Enter",
              "expect": {
                "events": [
                  {
                    "name": "sf-button-press",
                    "count": 1
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p7-disabled-loading-silent",
          "title": "a disabled or loading button sends no press",
          "covers": "events.press, settings.disabled, settings.loading",
          "steps": [
            {
              "script": "(() => { window.__presses = 0; document.addEventListener('sf-button-press', () => { window.__presses += 1; }); document.querySelector('#b-off button').click(); document.querySelector('#b-load button').click(); return true; })()"
            },
            {
              "check": "window.__presses === 0 && document.querySelector('#b-off button').disabled && document.querySelector('#b-load button').disabled && document.querySelector('#b-load button').getAttribute('aria-busy') === 'true'"
            }
          ]
        },
        {
          "id": "p8-expanded",
          "title": "expanded writes aria-expanded, absent says nothing",
          "covers": "settings.expanded (optional)",
          "steps": [
            {
              "check": "document.querySelector('#b-exp button').getAttribute('aria-expanded') === 'false' && !document.querySelector('#b-text button').hasAttribute('aria-expanded')"
            },
            {
              "script": "document.querySelector('#b-exp').expanded = true"
            },
            {
              "check": "document.querySelector('#b-exp button').getAttribute('aria-expanded') === 'true' && document.querySelector('#b-exp').expanded === true"
            }
          ]
        },
        {
          "id": "p9-unknown-values",
          "title": "a value off a list draws the default",
          "covers": "settings.appearance enum, settings.size enum",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#b-bad button'); return b.classList.contains('sf-button--default') && b.classList.contains('sf-button--size-1'); })()",
              "expect": {
                "values": {
                  "#b-bad.appearance": "default",
                  "#b-bad.size": "1"
                }
              }
            }
          ]
        },
        {
          "id": "p10-public-variable",
          "title": "--sf-button-background-color fills the button",
          "covers": "css-variables --sf-button-background-color",
          "steps": [
            {
              "script": "(() => { document.querySelector('#b-text').style.setProperty('--sf-button-background-color', 'rgb(1, 2, 3)'); return true; })()"
            },
            {
              "check": "getComputedStyle(document.querySelector('#b-text button')).backgroundColor === 'rgb(1, 2, 3)'"
            }
          ]
        },
        {
          "id": "p11-link-target-rel",
          "title": "a link takes target and rel; a new tab with no rel says noopener noreferrer; a button carries neither",
          "covers": "settings.target, settings.rel",
          "steps": [
            {
              "check": "(() => { const a = (id) => document.querySelector(id + ' a.sf-button'); const tab = a('#b-tab'), rel = a('#b-rel'), self = a('#b-self'); const btn = document.querySelector('#b-btn-target button.sf-button'); return Boolean(tab && rel && self && btn) && tab.getAttribute('target') === '_blank' && tab.getAttribute('rel') === 'noopener noreferrer' && rel.getAttribute('rel') === 'noopener' && self.getAttribute('target') === '_self' && !self.hasAttribute('rel') && !btn.hasAttribute('target') && !btn.hasAttribute('rel'); })()",
              "expect": {
                "values": {
                  "#b-tab.target": "_blank",
                  "#b-rel.rel": "noopener"
                }
              }
            }
          ]
        },
        {
          "id": "p12-danger-and-ghost",
          "title": "status error reads as danger and appearance link as ghost, each noted; both keep their drawing classes",
          "covers": "settings.status danger, settings.appearance ghost, aliases.json error, link",
          "steps": [
            {
              "check": "(() => { const e = document.querySelector('#b-err button'); const l = document.querySelector('#b-link button'); return e.classList.contains('sf-button--danger') && e.classList.contains('sf-button--error') && l.classList.contains('sf-button--link'); })()",
              "expect": {
                "values": {
                  "#b-err.status": "danger",
                  "#b-link.appearance": "ghost"
                }
              }
            },
            {
              "check": "['error', 'link'].every((from) => [...SF.__deprecationNotes.values()].some((note) => note.component === 'sf-button' && note.from === from && note.remove_after === '2027-01-01'))"
            }
          ]
        },
        {
          "id": "p13-cycle",
          "title": "a cycle shows its current label, names it, steps on a press, wraps, sends change and announces; pressed beside it is ignored",
          "covers": "settings.cycle, settings.value, events.change",
          "steps": [
            {
              "check": "(() => { const b = document.querySelector('#b-cyc button'); return b.textContent.trim() === '1×' && b.getAttribute('aria-label') === 'Скорость: 1×' && b.title.includes('1,5×') && !b.hasAttribute('aria-pressed'); })()"
            },
            {
              "user": "click:#b-cyc button",
              "expect": {
                "events": [
                  {
                    "name": "change",
                    "count": 1
                  }
                ]
              }
            },
            {
              "check": "(() => { const h = document.querySelector('#b-cyc'); const b = h.querySelector('button'); return h.getAttribute('value') === '1.5' && b.getAttribute('aria-label') === 'Скорость: 1,5×' && h.querySelector('.sf-button-announce').textContent.trim() === 'Скорость: 1,5×'; })()"
            },
            {
              "user": "click:#b-cyc button"
            },
            {
              "user": "click:#b-cyc button"
            },
            {
              "check": "document.querySelector('#b-cyc').getAttribute('value') === '1'"
            }
          ]
        },
        {
          "id": "p14-height",
          "title": "height picks the size's tightness step: low, default, high, highest stand ever taller, default is the size's own height, the sides grow with the height, a value outside the list reads as default",
          "covers": "settings.height (decision C27)",
          "steps": [
            {
              "check": "(() => { const b = (id) => document.querySelector(`#${id} button`); const h = (id) => b(id).getBoundingClientRect().height; const pad = (id) => parseFloat(getComputedStyle(b(id)).paddingInlineStart); const ids = ['b-h-low', 'b-h-default', 'b-h-high', 'b-h-highest']; const rising = ids.every((id, i) => i === 0 || h(id) > h(ids[i - 1])) && ids.every((id, i) => i === 0 || pad(id) > pad(ids[i - 1])); const halves = ids.every((id) => Math.abs((pad(id) - pad('b-h-default')) * 2 - (h(id) - h('b-h-default'))) < 0.5); return rising && halves && h('b-h-default') === h('b-text') && h('b-h-bad') === h('b-text') && b('b-h-high').classList.contains('sf-button--height-high') && ![...b('b-h-default').classList, ...b('b-h-bad').classList].some((c) => c.startsWith('sf-button--height-')); })()",
              "expect": {
                "values": {
                  "#b-h-high.height": "high",
                  "#b-h-bad.height": "default"
                }
              }
            }
          ]
        },
        {
          "id": "p15-full-width-and-loading-colour",
          "title": "full-width fills the container (sf-segmented's setting, owner decision C36); a loading button keeps its scheme colour and only a disabled one is grey",
          "covers": "settings.full-width, settings.loading (decision C36)",
          "steps": [
            {
              "check": "(() => { const b = (id) => document.querySelector(`#${id} button`); const main = document.querySelector('main').getBoundingClientRect().width; const css = (id) => getComputedStyle(b(id)).backgroundColor; return Math.abs(b('b-full').getBoundingClientRect().width - main) < 1 && b('b-text').getBoundingClientRect().width < main - 50 && b('b-full').classList.contains('sf-button--full-width') && css('b-load') === css('b-text') && css('b-off') !== css('b-text') && b('b-load').disabled; })()",
              "expect": {
                "values": {
                  "#b-full.fullWidth": true
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
