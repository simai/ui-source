{
  "examples": [
    {
      "name": "reference",
      "title": "Слайдер",
      "settings": {
        "dots": true,
        "arrows": true
      },
      "children": [
        "<div slot=\"slide\">Первый слайд</div>",
        "<div slot=\"slide\">Второй слайд</div>"
      ],
      "expect": {
        "slides": 2
      },
      "from": "studio.fixture.json",
      "studio": {
        "children": [
          {
            "element": "div",
            "props": {},
            "text": "Первый слайд",
            "children": []
          },
          {
            "element": "div",
            "props": {},
            "text": "Второй слайд",
            "children": []
          }
        ],
        "scenario": {
          "steps": [
            {
              "invoke": "refresh",
              "with": []
            }
          ],
          "assertions": [
            "upgraded",
            "no-console-error",
            "no-network"
          ]
        }
      }
    },
    {
      "name": "next",
      "title": "Следующий слайд",
      "settings": {
        "arrows": true
      },
      "children": [
        "<div slot=\"slide\">Один</div>",
        "<div slot=\"slide\">Два</div>",
        "<div slot=\"slide\">Три</div>"
      ],
      "script": [
        {
          "act": "slide-next"
        }
      ],
      "expect": {
        "events": [
          {
            "change": {
              "active-index": 1
            }
          }
        ]
      },
      "from": "studio.scenario.json"
    },
    {
      "name": "thumbs",
      "title": "С миниатюрами",
      "settings": {
        "thumbs": true,
        "dots": false
      },
      "children": [
        "<img slot=\"slide\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\" alt=\"Один\">",
        "<img slot=\"slide\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\" alt=\"Два\">"
      ],
      "expect": {
        "slides": 2
      }
    },
    {
      "name": "loop",
      "title": "По кругу",
      "settings": {
        "loop": true,
        "speed": 300,
        "space-between": 8
      },
      "children": [
        "<div slot=\"slide\">А</div>",
        "<div slot=\"slide\">Б</div>"
      ],
      "expect": {
        "slides": 2
      }
    },
    {
      "name": "inside",
      "title": "Точки внутри картинки",
      "settings": {
        "indicator": "inside",
        "ratio": "16/9"
      },
      "children": [
        "<div slot=\"slide\" style=\"block-size:100%;background:#f4f1ea\">Светлый слайд</div>",
        "<div slot=\"slide\" style=\"block-size:100%;background:#1f2a36;color:#fff\">Тёмный слайд</div>"
      ],
      "expect": {
        "slides": 2
      }
    }
  ],
  "pages": [
    {
      "name": "conformance",
      "title": "sf-slider against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main style=\"inline-size: 40rem\">",
          "  <sf-slider id=\"s1\" arrows dots=\"false\"><div>Один</div><div>Два</div><div>Три</div></sf-slider>",
          "  <sf-slider id=\"s2\" indicator=\"inside\"><div slot=\"slide\" style=\"block-size:100%;background:#f4f1ea\">Светлый</div><div slot=\"slide\" style=\"block-size:100%;background:#1f2a36;color:#fff\">Тёмный</div></sf-slider>",
          "  <sf-slider id=\"s3\" indicator=\"inside\" indicator-ink=\"outline\"><div slot=\"slide\" style=\"block-size:100%;background:#f4f1ea\">Один</div><div slot=\"slide\">Два</div></sf-slider>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-next",
          "title": "slide-next shows the next slide and sends change {activeIndex, realIndex, previousIndex}, then the old name",
          "covers": "actions.slide-next, events.change",
          "steps": [
            {
              "check": "Boolean(document.getElementById('s1').querySelector('.swiper-initialized, .swiper'))",
              "wait": 800
            },
            {
              "action": {
                "name": "slide-next"
              },
              "target": "#s1",
              "wait": 900,
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "events": [
                  {
                    "name": "change",
                    "count": 1,
                    "detail": {
                      "activeIndex": 1,
                      "realIndex": 1
                    }
                  },
                  {
                    "name": "sf-slide-change",
                    "count": 1,
                    "detail": {
                      "activeIndex": 1
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p2-data-only",
          "title": "the change detail is data only (§8)",
          "covers": "§8",
          "steps": [
            {
              "script": "new Promise((done) => { const el = document.getElementById('s1'); setTimeout(() => { el.addEventListener('change', (e) => done(Object.keys(e.detail).sort().join(',')), {once: true}); el.slideNext(); }, 600); })",
              "wait": 900,
              "expect": {
                "returns": "activeIndex,previousIndex,realIndex"
              }
            }
          ]
        },
        {
          "id": "p3-arrows",
          "title": "the arrows are named by the language file and move the slides",
          "covers": "lang runtime.previous, runtime.next",
          "steps": [
            {
              "check": "(() => { const labels = [...document.querySelectorAll('#s1 [aria-label]')].map((n) => n.getAttribute('aria-label')); return labels.includes('Следующий слайд') && labels.includes('Предыдущий слайд'); })()",
              "wait": 600
            }
          ]
        },
        {
          "id": "p4-refresh-and-retired",
          "title": "refresh answers applied; getSlider is kept and noted",
          "covers": "actions.refresh, aliases.json",
          "steps": [
            {
              "action": {
                "name": "refresh"
              },
              "target": "#s1",
              "wait": 600,
              "expect": {
                "returns": {
                  "outcome": "applied"
                }
              }
            },
            {
              "script": "Boolean(document.getElementById('s1').getSlider())",
              "expect": {
                "returns": true,
                "journal": [
                  {
                    "from": "getSlider",
                    "remove_after": "2026-12-01"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "p5-indicator-ink",
          "title": "indicator=\"inside\" stands the dots over the picture and takes the ink by the slide under them: dark on a light slide, light on a dark one; indicator-ink=\"outline\" is the page's (C398)",
          "covers": "settings.indicator, settings.indicator-ink",
          "steps": [
            {
              "check": "(() => { const root = document.querySelector('#s2 .sf-slider'); const bar = root.querySelector('.sf-slider-dots'); const pic = root.querySelector('.sf-slider-main').getBoundingClientRect(); const box = bar.getBoundingClientRect(); return root.dataset.indicator === 'inside' && root.dataset.ink === 'dark' && box.bottom < pic.bottom && box.top > pic.top; })()",
              "wait": 800
            },
            {
              "script": "new Promise((done) => { const el = document.getElementById('s2'); el.slideNext(); setTimeout(() => done(el.querySelector('.sf-slider').dataset.ink), 700); })",
              "wait": 900,
              "expect": {
                "returns": "light"
              }
            },
            {
              "check": "document.querySelector('#s3 .sf-slider').dataset.ink === 'outline' && document.querySelector('#s3 .sf-slider').dataset.indicatorInk === 'outline'"
            }
          ]
        }
      ]
    }
  ]
}
