{
  "component": "sf-slider",
  "probe": "sf-slider against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
  "format": "stands/15-scenarios (A4 modal: a page, probes in steps); the runner is tests/browser/manifest-probes.browser.mjs",
  "page": {
    "lang": "ru",
    "body": [
      "<main style=\"inline-size: 40rem\">",
      "  <sf-slider id=\"s1\" arrows dots=\"false\"><div>Один</div><div>Два</div><div>Три</div></sf-slider>",
      "</main>"
    ]
  },
  "probes": [
    {
      "id": "p1-next",
      "title": "slide-next shows the next slide and sends change {activeIndex, realIndex, previousIndex}, then the old name",
      "covers": "actions.slide-next, events.change",
      "steps": [
        {
          "check": "Boolean(document.getElementById('s1').querySelector('.swiper-initialized, .swiper'))",
          "wait": 800
        },
        {
          "action": {
            "name": "slide-next"
          },
          "target": "#s1",
          "wait": 900,
          "expect": {
            "returns": {
              "outcome": "applied"
            },
            "events": [
              {
                "name": "change",
                "count": 1,
                "detail": {
                  "activeIndex": 1,
                  "realIndex": 1
                }
              },
              {
                "name": "sf-slide-change",
                "count": 1,
                "detail": {
                  "activeIndex": 1
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "p2-data-only",
      "title": "the change detail is data only (§8)",
      "covers": "§8",
      "steps": [
        {
          "script": "new Promise((done) => { const el = document.getElementById('s1'); setTimeout(() => { el.addEventListener('change', (e) => done(Object.keys(e.detail).sort().join(',')), {once: true}); el.slideNext(); }, 600); })",
          "wait": 900,
          "expect": {
            "returns": "activeIndex,previousIndex,realIndex"
          }
        }
      ]
    },
    {
      "id": "p3-arrows",
      "title": "the arrows are named by the language file and move the slides",
      "covers": "lang runtime.previous, runtime.next",
      "steps": [
        {
          "check": "(() => { const labels = [...document.querySelectorAll('#s1 [aria-label]')].map((n) => n.getAttribute('aria-label')); return labels.includes('Следующий слайд') && labels.includes('Предыдущий слайд'); })()",
          "wait": 600
        }
      ]
    },
    {
      "id": "p4-refresh-and-retired",
      "title": "refresh answers applied; getSlider is kept and noted",
      "covers": "actions.refresh, aliases.json",
      "steps": [
        {
          "action": {
            "name": "refresh"
          },
          "target": "#s1",
          "wait": 600,
          "expect": {
            "returns": {
              "outcome": "applied"
            }
          }
        },
        {
          "script": "Boolean(document.getElementById('s1').getSlider())",
          "expect": {
            "returns": true,
            "journal": [
              {
                "from": "getSlider",
                "remove_after": "2026-12-01"
              }
            ]
          }
        }
      ]
    }
  ]
}
