  ],
  "pages": [
    {
      "name": "conformance",
      "title": "sf-tag-group against component.json (standard simai.smart-component 1.3.16 §12, gate 20)",
      "page": {
        "lang": "ru",
        "body": [
          "<main style=\"inline-size: 40rem\">",
          "  <sf-tag-group id=\"g-rm\" aria-label=\"Города\"><sf-tag kind=\"default\" closable text=\"Москва\"></sf-tag><sf-tag kind=\"default\" closable text=\"Казань\"></sf-tag><sf-tag kind=\"default\" closable text=\"Тверь\"></sf-tag></sf-tag-group>",
          "  <sf-tag-group id=\"g-one\" aria-label=\"Показать\" selection=\"one\"><sf-tag key=\"all\" text=\"Все\"></sf-tag><sf-tag key=\"new\" text=\"Новые\" active></sf-tag><sf-tag key=\"mine\" text=\"Мои\"></sf-tag></sf-tag-group>",
          "  <div style=\"inline-size: 320px\"><sf-tag-group id=\"g-more\" aria-label=\"Города\"><sf-tag kind=\"default\" closable text=\"Москва\"></sf-tag><sf-tag kind=\"default\" closable text=\"Казань\"></sf-tag><sf-tag kind=\"default\" closable text=\"Санкт-Петербург\"></sf-tag><sf-tag kind=\"default\" closable text=\"Новосибирск\"></sf-tag><sf-tag kind=\"default\" closable text=\"Екатеринбург\"></sf-tag><sf-tag kind=\"default\" closable text=\"Самара\"></sf-tag></sf-tag-group></div>",
          "  <div style=\"inline-size: 320px\"><sf-tag-group id=\"g-wrap\" layout=\"wrap\" aria-label=\"Города\"><sf-tag kind=\"default\" closable text=\"Москва\"></sf-tag><sf-tag kind=\"default\" closable text=\"Казань\"></sf-tag><sf-tag kind=\"default\" closable text=\"Санкт-Петербург\"></sf-tag><sf-tag kind=\"default\" closable text=\"Новосибирск\"></sf-tag><sf-tag kind=\"default\" closable text=\"Екатеринбург\"></sf-tag></sf-tag-group></div>",
          "  <script>document.addEventListener('sf-tag-close', (event) => { if (event.target.closest('#g-rm, #g-more')) event.target.remove(); });</script>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-list",
          "title": "a list of listitems, the tags 4 apart",
          "covers": "accessibility.role, C105 H5",
          "steps": [
            {
              "wait": 300,
              "check": "(() => { const g = document.querySelector('#g-rm'); const tags = [...g.querySelectorAll(':scope > sf-tag')]; const a = tags[0].querySelector('.sf-tag').getBoundingClientRect(); const b = tags[1].querySelector('.sf-tag').getBoundingClientRect(); return g.getAttribute('role') === 'list' && tags.every((t) => t.getAttribute('role') === 'listitem') && Math.round(b.left - a.right) === 4 && getComputedStyle(g).display === 'flex'; })()"
            }
          ]
        },
        {
          "id": "p2-one-stop",
          "title": "the row is one Tab stop; ArrowRight moves to the next tag and End to the last",
          "covers": "keyboard.host Tab, ArrowRight, End",
          "steps": [
            {
              "check": "(() => { const g = document.querySelector('#g-rm'); const stops = [...g.querySelectorAll('button')].filter((b) => b.tabIndex >= 0); return stops.length === 1; })()"
            },
            {
              "script": "(document.querySelector('#g-rm button[tabindex=\"0\"]').focus(), true)",
              "wait": 120,
              "check": "document.activeElement === document.querySelectorAll('#g-rm > sf-tag')[0].querySelector('button')"
            },
            {
              "user": "keyboard:ArrowRight",
              "wait": 120,
              "check": "document.activeElement === document.querySelectorAll('#g-rm > sf-tag')[1].querySelector('button')"
            },
            {
              "user": "keyboard:End",
              "wait": 120,
              "check": "document.activeElement === document.querySelectorAll('#g-rm > sf-tag')[2].querySelector('button')"
            }
          ]
        },
        {
          "id": "p3-delete",
          "title": "Delete removes the tag stood on (the page removes it on sf-tag-close) and the focus goes to its neighbour; the step is said",
          "covers": "keyboard.host Delete, accessibility",
          "steps": [
            {
              "script": "(document.querySelectorAll('#g-rm > sf-tag')[0].querySelector('button').focus(), true)",
              "wait": 120,
              "check": "document.activeElement === document.querySelectorAll('#g-rm > sf-tag')[0].querySelector('button')"
            },
            {
              "user": "keyboard:Delete",
              "wait": 300,
              "check": "(() => { const tags = [...document.querySelectorAll('#g-rm > sf-tag')]; return tags.length === 2 && tags[0].getAttribute('text') === 'Казань' && document.activeElement === tags[0].querySelector('button') && /Казань, 1 из 2/u.test(document.querySelector('[data-sf-tag-said]')?.textContent || ''); })()"
            }
          ]
        },
        {
          "id": "p4-one",
          "title": "selection one: choosing a tag clears the others and sends sf-tag-group-select; selected is its key",
          "covers": "settings.selection, values.selected, values.selected-ids, events.select",
          "steps": [
            {
              "script": "(window.__sel = [], document.querySelector('#g-one').addEventListener('sf-tag-group-select', (e) => window.__sel.push(e.detail)), true)",
              "wait": 50,
              "check": "document.querySelector('#g-one').selected === 'new'"
            },
            {
              "user": "click:#g-one sf-tag[key=\"mine\"] button",
              "wait": 200,
              "check": "(() => { const g = document.querySelector('#g-one'); const d = window.__sel[0]; return g.selected === 'mine' && JSON.stringify(g.selectedIds) === '[\"mine\"]' && !g.querySelector('sf-tag[key=\"new\"]').hasAttribute('active') && d && d.id === 'mine' && d.selected === true && JSON.stringify(d.ids) === '[\"mine\"]'; })()"
            },
            {
              "script": "(document.querySelector('#g-one').selected = 'all', true)",
              "wait": 120,
              "check": "document.querySelector('#g-one').selectedIds.join() === 'all'"
            }
          ]
        },
        {
          "id": "p5-more",
          "title": "layout row: the tags that do not fit leave the row and «+N» stands after the last one shown; it opens a popover with the hidden tags and their crosses; a cross there removes the page's tag",
          "covers": "settings.layout row, C145 (5)",
          "steps": [
            {
              "wait": 300,
              "check": "(() => { const g = document.querySelector('#g-more'); const over = g.querySelectorAll(':scope > sf-tag[data-sf-tag-over]').length; const more = g.querySelector(':scope > [data-sf-tag-group-more]'); const n = more?.querySelector('sf-tag[slot=\"trigger\"]')?.getAttribute('text'); const gb = g.getBoundingClientRect(); return over > 0 && n === `+${over}` && more.getAttribute('role') === 'listitem' && more.getBoundingClientRect().right <= gb.right + 0.5 && gb.height < 48; })()"
            },
            {
              "user": "click:#g-more [data-sf-tag-group-more] sf-tag[slot=\"trigger\"] button",
              "wait": 300,
              "check": "(() => { const g = document.querySelector('#g-more'); const pop = g.querySelector('sf-popover'); const copies = pop.querySelectorAll('[slot=\"content\"] sf-tag'); return pop.open && copies.length === g.querySelectorAll(':scope > sf-tag[data-sf-tag-over]').length && copies[0].querySelector('sf-button-close, .sf-icon-button'); })()"
            },
            {
              "script": "(window.__before = document.querySelectorAll('#g-more > sf-tag').length, document.querySelector('#g-more sf-popover [slot=\"content\"] sf-tag sf-button-close button').click(), true)",
              "wait": 400,
              "check": "document.querySelectorAll('#g-more > sf-tag').length === window.__before - 1"
            }
          ]
        },
        {
          "id": "p6-wrap",
          "title": "layout wrap: every tag in view on more lines, no «+N»",
          "covers": "settings.layout wrap",
          "steps": [
            {
              "wait": 300,
              "check": "(() => { const g = document.querySelector('#g-wrap'); return !g.querySelector('[data-sf-tag-group-more]') && !g.querySelector('[data-sf-tag-over]') && g.getBoundingClientRect().height > 48; })()"
            }
          ]
        }
      ]
    }
  ]
}
