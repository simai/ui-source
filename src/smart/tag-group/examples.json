{
  "examples": [
    {
      "name": "reference",
      "title": "Выбранные значения, можно убрать",
      "attributes": {
        "aria-label": "Города"
      },
      "children": [
        "<sf-tag kind=\"default\" closable text=\"Москва\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Казань\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Тверь\"></sf-tag>"
      ],
      "expect": {
        "layout": "row",
        "selection": "none"
      },
      "studio": {
        "title": "tag group reference",
        "props": {
          "aria-label": "Города"
        },
        "children": [
          {
            "element": "sf-tag",
            "props": {
              "kind": "default",
              "closable": true,
              "text": "Москва"
            },
            "children": []
          },
          {
            "element": "sf-tag",
            "props": {
              "kind": "default",
              "closable": true,
              "text": "Казань"
            },
            "children": []
          },
          {
            "element": "sf-tag",
            "props": {
              "kind": "default",
              "closable": true,
              "text": "Тверь"
            },
            "children": []
          }
        ],
        "scenario": {
          "assertions": [
            "upgraded",
            "no-console-error",
            "no-network"
          ]
        }
      }
    },
    {
      "name": "filters",
      "title": "Фильтры: выбор одного",
      "settings": {
        "selection": "one"
      },
      "attributes": {
        "aria-label": "Показать"
      },
      "children": [
        "<sf-tag key=\"all\" text=\"Все\"></sf-tag>",
        "<sf-tag key=\"new\" text=\"Новые\" active></sf-tag>",
        "<sf-tag key=\"mine\" text=\"Мои\"></sf-tag>",
        "<sf-tag key=\"files\" text=\"С файлами\"></sf-tag>"
      ],
      "expect": {
        "selection": "one",
        "selected": "new"
      }
    },
    {
      "name": "more",
      "title": "Одна строка и «+N»",
      "attributes": {
        "aria-label": "Города"
      },
      "parent": "<div style=\"inline-size: 320px\"></div>",
      "children": [
        "<sf-tag kind=\"default\" closable text=\"Москва\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Казань\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Санкт-Петербург\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Новосибирск\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Екатеринбург\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Самара\"></sf-tag>"
      ],
      "expect": {
        "layout": "row"
      }
    },
    {
      "name": "wrap",
      "title": "В форме: перенос",
      "settings": {
        "layout": "wrap"
      },
      "attributes": {
        "aria-label": "Города"
      },
      "parent": "<div style=\"inline-size: 320px\"></div>",
      "children": [
        "<sf-tag kind=\"default\" closable text=\"Москва\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Казань\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Санкт-Петербург\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Новосибирск\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Екатеринбург\"></sf-tag>",
        "<sf-tag kind=\"default\" closable text=\"Самара\"></sf-tag>"
      ],
      "expect": {
