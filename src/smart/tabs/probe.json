{
  "component": "sf-tabs",
  "probe": "sf-tabs against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
  "format": "stands/15-scenarios (A4 modal: a page, probes in steps); the runner is tests/browser/manifest-probes.browser.mjs",
  "page": {
    "lang": "ru",
    "body": [
      "<main>",
      "  <div id=\"area\"><sf-tabs id=\"tb\" aria-label=\"Карточка\" items='[{\"id\": \"main\", \"label\": \"Основное\"}, {\"id\": \"deals\", \"label\": \"Сделки\", \"count\": 12}, {\"id\": \"off\", \"label\": \"Архив\", \"disabled\": true}, {\"id\": \"files\", \"label\": \"Файлы\"}]'></sf-tabs></div>",
      "  <sf-tabs id=\"lazy\" aria-label=\"Записи\" items='[{\"id\":\"orders\",\"label\":\"Заказы\"},{\"id\":\"clients\",\"label\":\"Клиенты\"}]'><div role=\"tabpanel\" data-entry=\"clients\" hidden><span id=\"part-clients\" data-sf-start=\"opened\" aria-busy=\"true\">Клиенты</span></div><div role=\"tabpanel\" data-entry=\"orders\"><span id=\"part-orders\">Заказы</span></div></sf-tabs>",
      "</main>"
    ]
  },
  "probes": [
    {
      "id": "p1-auto-arrows",
      "title": "automatic activation: ArrowRight selects the next enabled tab (past the disabled one): sf-tabs-change once, sf-tab-change once, noted with its dates",
      "covers": "keyboard.host ArrowRight focus:next, events.change, aliases sf-tab-change",
      "steps": [
        {
          "script": "(document.querySelector('#tb [data-sf-tab-index=\"1\"]').focus(), true)",
          "wait": 60
        },
        {
          "user": "keyboard:ArrowRight",
          "expect": {
            "events": [
              {
                "name": "sf-tabs-change",
                "count": 1,
                "detail": {
                  "selected": "files",
                  "previous": 0,
                  "current": 3
                }
              },
              {
                "name": "sf-tab-change",
                "count": 1,
                "detail": {
                  "current": 3,
                  "component": "<sf-tabs>",
                  "tagName": "sf-tabs"
                }
              }
            ],
            "values": {
              "#tb.selected": "files"
            },
            "journal": [
              {
                "from": "sf-tab-change",
                "to": "sf-tabs-change",
                "since": "2026-10-27",
                "remove_after": "2026-12-01"
              }
            ]
          },
          "check": "document.activeElement === document.querySelector('#tb [data-sf-tab-index=\"3\"]') && !('component' in (window.__heard.find((one) => one.name === 'sf-tabs-change')?.detail ?? {component: 1}))"
        }
      ]
    },
    {
      "id": "p2-home-end-left",
      "title": "Home, End and ArrowLeft move and select",
      "covers": "keyboard.host Home focus:first, End focus:last, ArrowLeft focus:prev",
      "steps": [
        {
          "script": "(document.querySelector('#tb [data-sf-tab-index=\"0\"]').focus(), true)",
          "wait": 60
        },
        {
          "user": "keyboard:End",
          "wait": 120,
          "check": "document.getElementById('tb').activeIndex === 3 && document.activeElement === document.querySelector('#tb [data-sf-tab-index=\"3\"]')"
        },
        {
          "user": "keyboard:ArrowLeft",
          "wait": 120,
          "check": "document.getElementById('tb').activeIndex === 1"
        },
        {
          "user": "keyboard:Home",
          "wait": 120,
          "check": "document.getElementById('tb').activeIndex === 0"
        }
      ]
    },
    {
      "id": "p3-manual-over-deferred",
      "title": "over a deferred panel the arrows only move the focus; Enter opens; the panel shows by removing hidden",
      "covers": "§7.2.1 manual activation, keyboard.host Enter select, Space select",
      "steps": [
        {
          "script": "(document.querySelector('#lazy [data-sf-tab-index=\"0\"]').focus(), true)",
          "wait": 60,
          "check": "document.querySelector('#lazy [data-entry=\"orders\"]').hidden === false && document.querySelector('#lazy [data-entry=\"clients\"]').hidden === true"
        },
        {
          "user": "keyboard:ArrowRight",
          "expect": {
            "events": [
              {
                "name": "sf-tabs-change",
                "count": 0
              }
            ]
          },
          "check": "document.activeElement === document.querySelector('#lazy [data-sf-tab-index=\"1\"]') && document.getElementById('lazy').selected === 'orders'"
        },
        {
          "user": "keyboard:Enter",
          "expect": {
            "events": [
              {
                "name": "sf-tabs-change",
                "count": 1,
                "detail": {
                  "selected": "clients"
                }
              }
            ],
            "values": {
              "#lazy.selected": "clients"
            }
          },
          "check": "document.querySelector('#lazy [data-entry=\"clients\"]').hidden === false && document.querySelector('#lazy [data-entry=\"orders\"]').hidden === true && document.getElementById('part-clients').isConnected"
        },
        {
          "user": "keyboard:ArrowLeft",
          "wait": 80
        },
        {
          "user": "keyboard:Space",
          "expect": {
            "events": [
              {
                "name": "sf-tabs-change",
                "count": 1,
                "detail": {
                  "selected": "orders"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "p4-tab-reaches-panel",
      "title": "Tab leaves the tablist for the open panel",
      "covers": "keyboard.host Tab reach",
      "steps": [
        {
          "script": "(document.querySelector('#tb [data-sf-tab-index=\"0\"]').focus(), true)",
          "wait": 60
        },
        {
          "user": "keyboard:Tab",
          "wait": 60,
          "check": "document.activeElement?.getAttribute('role') === 'tabpanel' && !document.activeElement.hidden"
        }
      ]
    },
    {
      "id": "p5-go-to-silent",
      "title": "go-to answers an outcome and sends no change; selected selects by id",
      "covers": "actions.go-to, values.selected, §8",
      "steps": [
        {
          "action": {
            "name": "go-to",
            "with": {
              "index": 3
            }
          },
          "target": "#tb",
          "expect": {
            "returns": {
              "outcome": "applied"
            },
            "events": [
              {
                "name": "sf-tabs-change",
                "count": 0
              }
            ],
            "values": {
              "#tb.selected": "files"
            }
          }
        },
        {
          "action": {
            "name": "go-to",
            "with": 2
          },
          "target": "#tb",
          "expect": {
            "returns": {
              "outcome": "refused",
              "reason": "disabled"
            }
          }
        },
        {
          "script": "(document.getElementById('tb').selected = 'deals', true)",
          "expect": {
            "events": [
              {
                "name": "sf-tabs-change",
                "count": 0
              }
            ]
          },
          "wait": 200,
          "check": "document.getElementById('tb').activeIndex === 1"
        }
      ]
    },
    {
      "id": "p6-ids-name",
      "title": "tab and panel ids are path ids and linked; the tablist takes the host's name",
      "covers": "accessibility.name, §7.1.1",
      "steps": [
        {
          "check": "(() => { const tab = document.querySelector('#tb [data-sf-tab-index=\"1\"]'); const panel = document.getElementById(tab.getAttribute('aria-controls')); return tab.id === 'page-tb--tab-1' && panel?.getAttribute('aria-labelledby') === tab.id && document.querySelector('#tb [role=\"tablist\"]').getAttribute('aria-label') === 'Карточка' && document.querySelector('#lazy [data-entry=\"clients\"]').getAttribute('aria-labelledby') === 'page-lazy--tab-1'; })()"
        }
      ]
    },
    {
      "id": "p7-public-variables",
      "title": "a public variable on an ancestor reaches the tabs",
      "covers": "css-variables",
      "steps": [
        {
          "script": "(document.getElementById('area').style.setProperty('--sf-tabs-gap', '17px'), true)",
          "wait": 400,
          "check": "getComputedStyle(document.querySelector('#tb [role=\"tablist\"]')).columnGap === '17px'"
        }
      ]
    }
  ]
}
