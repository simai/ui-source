        "items": [
          {
            "id": "overview",
            "label": "Обзор"
          },
          {
            "id": "history",
            "label": "История"
          }
        ]
      },
      "expect": {
        "name": "Разделы",
        "values": {
          "selected": "overview"
        }
      },
      "from": "studio.fixture.json",
      "studio": {
        "props": {
          "active-index": 0,
          "items": [
            {
              "id": "overview",
              "label": "Обзор"
            },
            {
              "id": "history",
              "label": "История"
            }
          ]
        },
        "children": [
          {
            "element": "button",
            "props": {
              "type": "button"
            },
            "text": "Обзор",
            "children": []
          },
          {
            "element": "button",
            "props": {
              "type": "button"
            },
