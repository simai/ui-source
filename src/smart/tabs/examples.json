      "title": "Настраиваемые",
      "settings": {
        "aria-label": "Карточка",
        "configurable": true,
        "items": [
          {
            "id": "main",
            "label": "Основное",
            "pinned": true
          },
          {
            "id": "deals",
            "label": "Сделки"
          },
          {
            "id": "tasks",
            "label": "Задачи"
          }
