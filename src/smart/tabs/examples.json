        "items": [
          {
            "id": "overview",
            "label": "Обзор"
          },
          {
            "id": "history",
            "label": "История"
          }
        ]
      },
      "script": [
        {
          "act": "go-to",
          "with": {
            "index": 1
          }
        }
      ],
      "expect": {
        "name": "Разделы",
        "values": {
          "selected": "history"
        },
        "events": []
      },
      "from": "studio.scenario.json"
    },
    {
      "name": "more",
      "title": "Лишние — в «Ещё»",
      "settings": {
        "aria-label": "Карточка",
        "overflow": "more",
        "items": [
          {
            "id": "main",
            "label": "Основное"
          },
          {
            "id": "deals",
            "label": "Сделки",
            "count": 12
          },
          {
            "id": "tasks",
            "label": "Задачи"
          },
          {
            "id": "files",
            "label": "Файлы"
          },
          {
            "id": "history",
