    {"key": "color", "type": "color", "label": {"ru": "Цвет", "en": "Colour"}, "default": "#6688ff"},
    {"key": "shape", "type": "choice", "label": {"ru": "Форма", "en": "Shape"}, "default": "round",
      "options": [{"value": "round", "label": {"ru": "Круг", "en": "Round"}}, {"value": "square", "label": {"ru": "Квадрат", "en": "Square"}}]}
