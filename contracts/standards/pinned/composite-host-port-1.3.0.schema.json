{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.io/contracts/composite-host-port.v1.schema.json",
  "title": "SIMAI Composite Host Port v1",
  "x-simai-version": "1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "port",
    "version",
    "component",
    "element",
    "capabilities",
    "data",
    "intents",
    "settings",
    "conformance"
  ],
  "anyOf": [{"properties": {"schema": {"const": "simai.composite.host-port.v1"}}}, {"required": ["schema_version"]}],
  "properties": {
    "schema": {"enum": ["simai.composite.host-port.v1", "simai.composite.host-port"], "description": "The format: simai.composite.host-port with schema_version 1. The older label simai.composite.host-port.v1 is read until the change journal retires it (names carry no version, 2026-10-11)."},
    "schema_version": {"const": 1},
    "port": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "component": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "element": {"type": "string", "pattern": "^[a-z][a-z0-9]*-[a-z0-9-]+$"},
    "summary": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "description": "Optional parts of the port. The host announces which it provides for an instance; the component offers only those.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": {
          "summary": {"type": "string", "minLength": 1},
          "intents": {"$ref": "#/$defs/nameList"},
          "data": {"$ref": "#/$defs/nameList"}
        }
      }
    },
    "data": {
      "type": "object",
      "description": "What a host answers with. Every entry is a closed schema; a key the port does not declare is not part of the contract.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "schema"],
        "properties": {
          "summary": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "schema": {"type": "object"}
        }
      }
    },
    "intents": {
      "type": "object",
      "description": "What the component asks for. The host decides, validates and answers.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "payload", "carries_revision", "answers"],
        "properties": {
          "summary": {"type": "string", "minLength": 1},
          "event": {"type": "string", "minLength": 1, "description": "The DOM event the component sends for this intent. Optional since 1.2.0 of this schema: an intent that a component asks only through the port's raise (admin-navigation-port 1.2.0's activity intents, which sf-admin-activity raises on the host directly) names no event."},
          "payload": {"type": "object"},
          "carries_revision": {"type": "boolean"},
          "answers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["applied", "conflict", "refused", "unavailable"]}
          },
          "capability": {"type": ["string", "null"]},
          "answer_data": {
            "type": "object",
            "description": "What an applied answer to this intent carries: a JSON schema of the part the port's answer names for the intent's data. Optional."
          },
          "answer": {
            "type": "object",
            "additionalProperties": false,
            "description": "Per outcome, what the host's answer carries for this intent: a short text, or a JSON schema of the answer's own part. Optional; declared in 1.3.0 of this schema for the ports that already carried it (the data view, the property view and the ports after them).",
            "properties": {
              "applied": {"$ref": "#/$defs/outcomeAnswer"},
              "conflict": {"$ref": "#/$defs/outcomeAnswer"},
              "refused": {"$ref": "#/$defs/outcomeAnswer"},
              "unavailable": {"$ref": "#/$defs/outcomeAnswer"}
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "reset", "target"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["package", "shared", "personal"]},
          "description": "Resolution order, from the weakest to the strongest layer."
        },
        "shared_only_fields": {"$ref": "#/$defs/nameList"},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "description": "What a settings layer may carry: a summary, the port version from which the fields are writable, and the fields each layer writes. Optional; declared in 1.3.0 of this schema for the ports that already carried it.",
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "writable_in": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "personal": {"$ref": "#/$defs/nameList"},
            "shared": {"$ref": "#/$defs/nameList"}
          }
        },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantics"],
          "properties": {
            "semantics": {"const": "compare-and-set"},
            "summary": {"type": "string", "minLength": 1}
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kinds", "carries_revision"],
          "properties": {
            "kinds": {"$ref": "#/$defs/nameList"},
            "carries_revision": {"type": "boolean"}
          }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kit", "cases"],
      "properties": {
        "kit": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cases": {"type": "integer", "minimum": 1}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "schema"],
      "description": "The shape of every answer the host returns: what carries the outcome, the reason and the intent's own data. Optional; earlier ports described it in their kit cases only.",
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "schema": {"type": "object"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_major", "recheck"],
      "properties": {
        "previous_major": {"type": ["string", "null"]},
        "supported_until": {"type": ["string", "null"]},
        "recheck": {"$ref": "#/$defs/nameList"},
        "deprecated": {
          "type": "object",
          "description": "What this port version still reads and until when, keyed by the old form: the date reading ends and what replaces it. Optional; declared in 1.3.0 of this schema for the ports that already carried it.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["read_until", "instead"],
            "properties": {
              "read_until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "instead": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "outcomeAnswer": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {"schema": {"type": "object"}}
        }
      ]
    },
    "nameList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
