{
  "schema": "simai.composition.structured-content-conformance-editorjs",
  "schema_version": 1,
  "id": "inline-not-expressible",
  "summary": "An inline tag the model has no mark for keeps its text and is reported.",
  "input": {
    "blocks": [
      {
        "id": "m1",
        "type": "paragraph",
        "data": {
          "text": "marker <mark class=\"cdx-marker\">hi</mark> and <u>under</u>"
        }
      }
    ]
  },
  "expect": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "m1",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "marker hi and under"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "losses": [
      {
        "code": "not_expressible",
        "path": "$.root.slots.default[0].data.text",
        "what": "<mark>"
      },
      {
        "code": "not_expressible",
        "path": "$.root.slots.default[0].data.text",
        "what": "<u>"
      }
    ],
    "back": {
      "blocks": [
        {
          "id": "m1",
          "type": "paragraph",
          "data": {
            "text": "marker hi and under"
          }
        }
      ]
    },
    "back_losses": [],
    "value_equal": false
  }
}
