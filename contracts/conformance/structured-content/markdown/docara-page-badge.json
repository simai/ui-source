              "data": {
                "source": "markdown",
                "raw": ":::example {label=\"Бейдж\"}\n```markdown\nКомпонент готов к работе :badge[Новое]{variant=tonal scheme=primary size=1}\n```\n:::",
                "hash": "sha256:16e979286d8ff43076b41ad80f5f745db9cde451f03b91342ec50c5faedd8a4c"
              }
            },
            {
