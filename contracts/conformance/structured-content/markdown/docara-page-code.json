            {
              "id": "m2",
              "type": "content.foreign",
              "data": {
                "source": "markdown",
                "raw": "---\ndescription: Блок кода в Docara: язык и имя файла в заголовке, подсветка синтаксиса, номера и выделение строк, изменения, фокус, терминал, копирование и перенос строк.\n---",
                "hash": "sha256:d571a0297923f88c93ea939dca417e98c1a4e3a4d9d4b6fd3d3612fb84739265"
              }
            },
            {
              "id": "m3",
              "type": "content.heading",
              "data": {
                "level": 1,
                "content": [
                  {
                    "type": "text",
                    "value": "Код"
                  }
                ]
              }
            },
            {
              "id": "m4",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Любой фрагмент между тремя обратными кавычками Docara оформляет как блок кода:\nHTML, PHP, JSON, команду терминала, конфигурацию или обычный текст. Блок\nничего не выполняет: он сохраняет пробелы и переносы, подсвечивает синтаксис\nи даёт скопировать содержимое."
                  }
                ]
              }
            },
            {
              "id": "m5",
              "type": "content.heading",
              "data": {
                "level": 2,
                "content": [
                  {
                    "type": "text",
                    "value": "Пример"
                  }
                ]
              }
            },
            {
              "id": "m6",
              "type": "content.foreign",
              "data": {
                "source": "markdown",
                "raw": ":::example {label=\"Блок кода\"}\n````markdown\n```php {title=\"config/app.php\"}\nreturn [\n    'name' => 'Docara',\n];\n```\n````\n:::",
                "hash": "sha256:140c133b491e2bad0d5e7cde4af6055fd6b4b660ec96cd0cffffed3667e7f2f6"
              }
            },
            {
              "id": "m7",
              "type": "content.heading",
              "data": {
                "level": 2,
                "content": [
                  {
                    "type": "text",
                    "value": "Разметка"
                  }
                ]
              }
            },
            {
              "id": "m8",
              "type": "content.code",
              "props": {
                "lang": "markdown"
              },
              "data": {
                "code": "```php {title=\"install.php\" highlight=2 numbers}\n<?php\necho 'Готово';\n```"
              }
            },
            {
              "id": "m15",
              "type": "content.list",
              "slots": {
                "items": [
                  {
                    "id": "m10",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Язык пишется сразу после открывающих кавычек: он выбирает подсветку и\nпоявляется в заголовке. Без языка в заголовке стоит нейтральное "
                        },
                        {
                          "type": "text",
                          "value": "Code",
                          "marks": [
                            "code"
                          ]
                        },
                        {
                          "type": "text",
                          "value": "."
                        }
                      ]
                    }
                  },
                  {
                    "id": "m12",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Параметры — в фигурных скобках после языка, в любом порядке. Параметр без\nзначения, например "
                        },
                        {
                          "type": "text",
                          "value": "numbers",
                          "marks": [
                            "code"
                          ]
                        },
                        {
                          "type": "text",
                          "value": ", означает «включить»."
                        }
                      ]
                    }
                  },
                  {
                    "id": "m14",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Строки считаются от первой строки блока, с единицы. Номер больше числа\nстрок или диапазон наоборот останавливают сборку с кодом\n"
                        },
                        {
                          "type": "text",
                          "value": "MARKDOWN_CODE_RANGE_INVALID",
                          "marks": [
                            "code"
                          ]
                        },
                        {
                          "type": "text",
                          "value": "."
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "id": "m16",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Запись совместима с привычными инструментами. Как в MkDocs Material,\nпараметры пишутся словами после языка, только в фигурных скобках. Как в\nVitePress, метки изменений пишутся комментарием "
                  },
                  {
                    "type": "text",
                    "value": "[!code ++]",
                    "marks": [
                      "code"
                    ]
                  },
                  {
                    "type": "text",
                    "value": ", а короткая\nзапись "
                  },
                  {
                    "type": "text",
                    "value": "```js{1,4-6}",
                    "marks": [
                      "code"
                    ]
                  },
                  {
                    "type": "text",
                    "value": " выделяет строки."
                  }
                ]
              }
            },
            {
              "id": "m17",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Блок построен на подсветке кода SIMAI Framework ("
                  },
                  {
                    "type": "text",
                    "value": "sf-highlight",
                    "marks": [
                      "code"
                    ]
                  },
                  {
                    "type": "text",
                    "value": ")."
                  }
                ]
              }
            },
            {
              "id": "m18",
              "type": "content.heading",
              "data": {
                "level": 2,
                "content": [
                  {
                    "type": "text",
                    "value": "Варианты"
                  }
                ]
              }
            },
            {
              "id": "m19",
              "type": "content.heading",
              "data": {
                "level": 3,
                "content": [
                  {
                    "type": "text",
                    "value": "Выделение и номера строк"
