              }
            },
            {
              "id": "m34",
              "type": "content.heading",
              "data": {
                "level": 3,
                "content": [
                  {
                    "type": "text",
                    "value": "Перенос длинных строк"
                  }
                ]
              }
            },
            {
              "id": "m35",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "По умолчанию длинная строка прокручивается внутри блока и не растягивает\nстраницу. Кнопка «Переносить длинные строки» включает визуальный перенос;\nисходный текст, отступы и копирование не меняются. Выбор сохраняется в\nбраузере и применяется ко всем блокам кода на странице."
                  }
                ]
              }
            },
            {
              "id": "m36",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Кнопку можно отключить для сайта, раздела или страницы настройкой "
                  },
                  {
                    "type": "text",
                    "value": "code.wrap",
                    "marks": [
                      "code"
                    ]
                  },
                  {
                    "type": "text",
                    "value": ":"
                  }
                ]
              }
            },
            {
              "id": "m37",
              "type": "content.code",
              "props": {
                "lang": "json"
              },
              "data": {
                "code": "{\n  \"code\": {\n    \"wrap\": false\n  }\n}"
              }
            },
            {
              "id": "m38",
              "type": "content.heading",
              "data": {
                "level": 3,
                "content": [
                  {
                    "type": "text",
                    "value": "Копирование"
                  }
                ]
              }
            },
            {
              "id": "m39",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Кнопка «Скопировать» копирует только код, который нужно перенести к себе:"
                  }
                ]
              }
            },
            {
              "id": "m46",
              "type": "content.list",
              "slots": {
                "items": [
                  {
                    "id": "m41",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "без номеров строк, знаков «+» и «−» и меток "
                        },
                        {
                          "type": "text",
                          "value": "[!code …]",
                          "marks": [
                            "code"
                          ]
                        },
                        {
                          "type": "text",
                          "value": ";"
                        }
                      ]
                    }
                  },
                  {
                    "id": "m43",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "без удалённых строк — копируется код после изменения;"
                        }
                      ]
                    }
                  },
                  {
                    "id": "m45",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "в терминале — только команды, без знака "
                        },
                        {
                          "type": "text",
                          "value": "$",
                          "marks": [
                            "code"
                          ]
                        },
                        {
                          "type": "text",
                          "value": " и без вывода."
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "id": "m47",
              "type": "content.heading",
              "data": {
                "level": 2,
                "content": [
                  {
                    "type": "text",
                    "value": "Доступность"
                  }
                ]
              }
            },
            {
              "id": "m54",
              "type": "content.list",
              "slots": {
                "items": [
                  {
                    "id": "m49",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Кнопки копирования и переноса получают фокус клавишей Tab; рамка фокуса\nвидна при работе с клавиатуры."
                        }
                      ]
                    }
                  },
                  {
                    "id": "m51",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Добавленные строки отмечены знаком «+» и зелёным фоном, удалённые — знаком\n«−» и красным, поэтому разница видна не только по цвету. Программа\nэкранного доступа перед такой строкой произносит «добавлено» или\n«удалено»; слова меняются в "
                        },
                        {
                          "type": "text",
                          "value": "lang.json",
                          "marks": [
                            "code"
                          ]
                        },
                        {
                          "type": "text",
                          "value": " ключами "
                        },
                        {
                          "type": "text",
                          "value": "code.added",
                          "marks": [
                            "code"
                          ]
                        },
                        {
                          "type": "text",
                          "value": " и\n"
                        },
                        {
                          "type": "text",
                          "value": "code.removed",
                          "marks": [
                            "code"
                          ]
                        },
                        {
                          "type": "text",
                          "value": "."
                        }
                      ]
                    }
                  },
                  {
                    "id": "m53",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Не помещайте в пример пароли, токены и другие секреты. Если код нужно\nзапустить, отдельно объясните окружение и ожидаемый результат."
                        }
                      ]
                    }
                  }
                ]
