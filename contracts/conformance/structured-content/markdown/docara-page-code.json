            },
            {
              "id": "m23",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Чтобы показать добавленное и удалённое, допишите в конце строки\nкомментарий-метку так, как в языке пишутся комментарии: "
                  },
                  {
                    "type": "text",
                    "value": "// [!code ++]",
                    "marks": [
                      "code"
                    ]
                  },
                  {
                    "type": "text",
