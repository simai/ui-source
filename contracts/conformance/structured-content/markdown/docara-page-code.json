                  {
                    "type": "text",
                    "value": " или "
                  },
                  {
                    "type": "text",
                    "value": "<!-- [!code ++] -->",
                    "marks": [
                      "code"
                    ]
                  },
                  {
                    "type": "text",
                    "value": ". Docara убирает метку из\nпоказанного кода."
                  }
                ]
              }
            },
            {
              "id": "m24",
              "type": "content.table",
              "data": {
