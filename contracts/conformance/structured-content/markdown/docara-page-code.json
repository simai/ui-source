            {
              "id": "m21",
              "type": "content.foreign",
              "data": {
                "source": "markdown",
                "raw": ":::example {label=\"Выделенные строки с номерами\"}\n````markdown\n```php {highlight=\"2-3\" numbers}\n$site = new Site('docs');\n$site->theme('light');\n$site->build();\necho 'Готово';\n```\n````\n:::",
                "hash": "sha256:5c5aba4117beb33a27b371b72ac5872d488d010ce14ed973c28e45efe3b8aad8"
              }
            },
            {
              "id": "m22",
              "type": "content.heading",
              "data": {
                "level": 3,
                "content": [
