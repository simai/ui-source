              }
            },
            {
              "id": "m3",
              "type": "content.heading",
              "data": {
                "level": 1,
                "content": [
                  {
                    "type": "text",
                    "value": "Иллюстрация"
                  }
                ]
              }
            },
            {
              "id": "m4",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Иллюстрация показывает одно изображение с подписью и закреплёнными\nпропорциями. Выбирайте её, когда картинка объясняет текст и ей нужна подпись\nили ровная рамка."
                  }
                ]
              }
            },
            {
              "id": "m5",
