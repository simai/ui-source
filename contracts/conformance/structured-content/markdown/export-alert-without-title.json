{
  "schema": "simai.composition.structured-content-conformance-markdown-export",
  "schema_version": 1,
  "id": "export-alert-without-title",
  "summary": "A content.alert without a title: written without one, docara_alert_title_required.",
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "w",
              "type": "content.alert",
              "props": {
                "status": "error",
                "appearance": "flat"
              },
              "slots": {
                "default": [
                  {
                    "id": "b",
                    "type": "content.paragraph",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Body."
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "markdown": ":::alert {type=danger variant=flat}\nBody.\n:::\n",
    "losses": [
      {
        "code": "not_expressible",
        "path": "$",
        "what": "block ids"
      },
      {
        "code": "docara_alert_title_required",
        "path": "$.root.slots.default[0].data.title",
        "what": "Docara requires an alert title; none is written"
      }
    ]
  }
}
