            {
              "id": "m8",
              "type": "content.code",
              "props": {
                "lang": "markdown"
              },
              "data": {
                "code": ":::tabs\n### Подпись первой вкладки\n\nСодержимое первой вкладки.\n\n### Подпись второй вкладки\n\nСодержимое второй вкладки.\n:::"
              }
            },
            {
              "id": "m13",
              "type": "content.list",
              "slots": {
                "items": [
                  {
                    "id": "m10",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Каждая вкладка начинается с заголовка "
