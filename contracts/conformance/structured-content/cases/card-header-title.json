{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "card-header-title",
  "summary": "A header with the title alone; an action without its link is not drawn.",
  "covers": [
    "content.card"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "c",
              "type": "content.card",
              "data": {
                "title": [
                  {
                    "type": "text",
                    "value": "Order 1042"
                  }
                ],
                "action_icon": "more_vert",
                "action_label": "More"
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><div class=\"sf-card\" data-sf-composition-id=\"c\"><div class=\"sf-card-header\"><h3>Order 1042</h3></div></div></article>",
    "diagnostics": [],
    "assets": [
      "component/card",
      "component/icon-buttons"
    ]
  }
}
