{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "foreign-html-script",
  "summary": "raw holding a script: nothing of it reaches the page.",
  "covers": [
    "content.foreign"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "fx",
              "type": "content.foreign",
              "data": {
                "source": "html",
                "raw": "<script>window.pwned = 1</script><img src=x onerror=\"window.pwned = 1\">"
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"></article>",
    "diagnostics": [],
    "assets": []
  }
}
