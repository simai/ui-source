{
  "name": "@simai/ui-source",
  "version": "1.0.0",
  "description": "Editable source for SIMAI Framework Core, Loader, utilities, components, and Smart components",
  "main": "index.js",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@material/material-color-utilities": "0.4.0",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^16.1.0"
  },
  "scripts": {
    "responsive-utilities:generate": "node scripts/generate-responsive-utility-variants.mjs",
    "responsive-utilities:check": "node scripts/generate-responsive-utility-variants.mjs --check",
    "test:responsive-utilities": "node --test tests/responsive-utility-variants.contract.test.mjs",
    "adaptive-sizing:generate": "node scripts/generate-adaptive-sizing-contract.mjs",
    "adaptive-sizing:check": "node scripts/generate-adaptive-sizing-contract.mjs --check",
    "test:adaptive-sizing": "node scripts/validate-adaptive-sizing-contract.mjs && node scripts/validate-root-typography-contract.mjs && node scripts/validate-text-12-contract.mjs",
    "test:public-docs": "node scripts/validate-ui-doc-content-spacing.mjs",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "test:scroll-subtle": "node --test tests/scroll-subtle.contract.test.mjs",
    "test:scrollbar": "node --test tests/scrollbar-presets.contract.test.mjs tests/scroll-subtle.contract.test.mjs",
    "test:highlight": "node scripts/validate-highlight-contract.mjs",
    "test:highlight:runtime": "node scripts/smoke-highlight-runtime.cjs",
    "test:unit": "node --test tests/*.test.mjs",
    "contract:build": "node scripts/sf-contract.mjs build",
    "contract:build:b0": "node scripts/sf-contract.mjs build",
    "contract:verify": "node scripts/verify-smart-contracts-with-studio.mjs",
    "contract:verify:studio": "node scripts/verify-smart-contracts-with-studio.mjs",
    "contract:verify:b0": "node scripts/sf-contract.mjs verify",
    "composition:build": "node scripts/generate-composition-contracts.mjs",
    "composition:check": "node scripts/generate-composition-contracts.mjs --check",
    "test:composition": "node --test tests/composition.contract.test.mjs",
    "test:composition-recipe": "node --test tests/composition-recipe.contract.test.mjs",
    "composition:capabilities:build": "node scripts/generate-composition-capability-fixtures.mjs && node scripts/lock-composition-capability-contracts.mjs",
    "composition:capabilities:check": "node scripts/generate-composition-capability-fixtures.mjs --check && node scripts/lock-composition-capability-contracts.mjs --check",
    "test:composition-capabilities": "node --test tests/composition-regions.contract.test.mjs tests/composition-routing.contract.test.mjs tests/composition-editor-field-kinds.contract.test.mjs",
    "studio:artifacts:preview": "node scripts/generate-smart-studio-artifacts.mjs",
    "studio:artifacts:verify": "node scripts/generate-smart-studio-artifacts.mjs --verify",
    "studio:artifacts:write": "node scripts/generate-smart-studio-artifacts.mjs --write",
    "studio:artifacts:refresh-metadata": "node scripts/generate-smart-studio-artifacts.mjs --refresh-metadata --write",
    "test": "bash scripts/run-content-spacing-ci-gate.sh",
    "utility-loader:audit": "node scripts/audit-utility-loader-contract.mjs",
    "utility-rules:generate": "node scripts/generate-exact-utility-rules.mjs",
    "dimensions:audit": "node scripts/audit-dimensions.mjs --summary"
  },
  "author": "Rim Zabarov and contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "lit": "3.3.3"
  },
  "private": true
}
