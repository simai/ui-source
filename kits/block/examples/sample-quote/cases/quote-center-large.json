{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "quote-center-large",
  "summary": "Centred and large, with a role and a source drawn as a link on the author.",
  "covers": [
    "sample.quote"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "q",
              "type": "sample.quote",
              "data": {
                "author": "Ada Lovelace",
                "role": "Mathematician",
                "source": "https://example.com/notes"
              },
              "props": {
                "align": "center",
                "size": "large"
              },
              "slots": {
                "default": [
                  {
                    "id": "q1",
                    "type": "content.paragraph",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "First paragraph."
                        }
                      ]
                    }
                  },
                  {
                    "id": "q2",
                    "type": "content.paragraph",
                    "data": {
                      "content": [
                        {
                          "type": "link",
                          "href": "/notes",
                          "children": [
                            {
                              "type": "text",
                              "value": "Second"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "value": " paragraph."
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><figure class=\"sample-quote sample-quote--center sample-quote--large\" data-sf-composition-id=\"q\"><blockquote class=\"sample-quote-text\" cite=\"https://example.com/notes\"><p data-sf-composition-id=\"q1\">First paragraph.</p><p data-sf-composition-id=\"q2\"><a href=\"/notes\">Second</a> paragraph.</p></blockquote><figcaption class=\"sample-quote-caption\"><a class=\"sample-quote-author\" href=\"https://example.com/notes\">Ada Lovelace</a><span class=\"sample-quote-role\">Mathematician</span></figcaption></figure></article>",
    "diagnostics": [],
    "assets": [
      "sample/quote"
    ]
  }
}
