{
  "schema": "simai.composition.type-manifest",
  "schema_version": 1,
  "type": "sample.quote",
  "version": "1.0.0",
  "category": "content",
  "mode": "composite",
  "profiles": ["structured-content", "ui-layout"],
  "data_schema": {
    "type": "object",
    "required": ["author"],
    "additionalProperties": false,
    "properties": {
      "author": {"type": "string", "minLength": 1, "maxLength": 120, "description": "Who said it."},
      "role": {"type": "string", "minLength": 1, "maxLength": 120, "description": "Who they are: a position, a company."},
      "source": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "Where it was said; drawn as a link on the author when it is a safe address."}
    }
  },
  "props_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "align": {"enum": ["start", "center"]},
      "size": {"enum": ["default", "large"]}
    }
  },
  "presentation": {"views": ["default"], "presets": [], "modifiers": []},
  "slots": {
    "default": {"min": 1, "max": 20, "types": ["content.paragraph"]}
  },
  "renderer": {"kind": "registered", "name": "sample.quote"},
  "assets": ["sample/quote"],
  "capabilities": ["html"]
}
