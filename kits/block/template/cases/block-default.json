    "html": "<article data-sf-composition-id=\"root\"><section class=\"product-block-name product-block-name--neutral\" data-sf-composition-id=\"b\"><h3 class=\"product-block-name-title\">Title</h3></section></article>",
    "diagnostics": [],
    "assets": [
